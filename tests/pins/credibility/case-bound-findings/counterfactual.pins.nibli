# The unscoped, immediately effective rule accepts the currently voided signer.
:expect-pins 4
? false(ProtocolSigner).
# => TRUE
? permits(Review, ProtocolSigner).
# => TRUE
? agree(Finding_Frisk, CredibilityFindingCandidate).
# => FALSE
? false(Frisk).
# => TRUE
