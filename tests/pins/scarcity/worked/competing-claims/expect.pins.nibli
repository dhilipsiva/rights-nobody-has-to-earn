:expect-pins 20

? permits(ScarcityWorkedManager, AllocateUnderPhysicalScarcity, ScarcityWorkedRecord).
# => TRUE
? obliged(ScarcityWorkedManager, RecordEveryUnmetPortionAsFailure, ScarcityWorkedRecord).
# => TRUE
? obliged(ScarcityWorkedManager, PublishComparativeAllocationReasonsAndRejectedAlternatives, ScarcityWorkedRecord).
# => TRUE
? complete(ScarcityWorkedRecord, ReviewedScarcityAllocation, IndivisibleEssentialPowerUnit).
# => TRUE
? obliged(ScarcityWorkedManager, RepairAndReassessTheRecordedShortfall, ScarcityWaitingShortfallRecord).
# => TRUE
? obliged(ScarcityWaitingShortfallReader, VerifyTheShortfallWasRecordedAsFailure, ScarcityWaitingShortfallRecord).
# => TRUE
? complete(ScarcityWaitingShortfallRecord, ReviewedScarcityShortfall, IndivisibleEssentialPowerUnit).
# => TRUE
? person(ScarcityWaitingClaimant).
# => TRUE
? owe(State, Healthy, ScarcityWaitingClaimant).
# => TRUE
? decide(ScarcityWaitingClaimant, Ballot).
# => TRUE
? healthy(ScarcityWaitingClaimant).
# => FALSE
? false(ScarcityWaitingClaimant).
# => FALSE
? prisoner(ScarcityWaitingClaimant).
# => FALSE
? person(ScarcityContinuityClaimant).
# => TRUE
? owe(State, Healthy, ScarcityContinuityClaimant).
# => TRUE
? decide(ScarcityContinuityClaimant, Ballot).
# => TRUE
? healthy(ScarcityContinuityClaimant).
# => FALSE
? false(ScarcityContinuityClaimant).
# => FALSE
? prisoner(ScarcityContinuityClaimant).
# => FALSE
? observe(ScarcityWorkedSource, ScarcityWorkedRecord, ContinueUnitForContinuityClaimDuringThisWindow, ScarcitySpecifiedAllocationScope).
