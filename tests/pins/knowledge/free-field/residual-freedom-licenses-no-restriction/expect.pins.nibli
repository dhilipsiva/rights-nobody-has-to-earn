? obliged(KnowledgeResidualActor, NotRegisterBeliefOpinionOrAssociationMembership, KnowledgeResidualRecord).
# => TRUE
? complete(KnowledgeResidualRecord, UnrestrictedKnowledgeActivity, KnowledgeResidualMatter).
