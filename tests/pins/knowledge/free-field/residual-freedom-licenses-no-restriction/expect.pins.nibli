? authority(KnowledgeResidualActor, ReviewedConductRestriction, KnowledgeResidualRecord).
# => FALSE
? permits(KnowledgeResidualActor, EnforceReviewedKnowledgeRestriction, KnowledgeResidualRecord).
# => FALSE
? complete(KnowledgeResidualRecord, ReviewedKnowledgeRestriction, KnowledgeResidualMatter).
# => FALSE
? person(KnowledgeResidualHolder).
# => FALSE
