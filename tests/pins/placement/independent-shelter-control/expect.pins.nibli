? prisoner(Confined_NotSevere_NoFamily_NoHome).
# => TRUE
? building(SupportedResidence, Confined_NotSevere_NoFamily_NoHome).
# => TRUE
? dwell(Confined_NotSevere_NoFamily_NoHome).
# => TRUE
? err(Confined_NotSevere_NoFamily_NoHome, Placement).
# => TRUE
