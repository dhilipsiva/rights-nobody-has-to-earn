:expect-pins 4

# The candidate changes the baseline TRUE consequence.
? building(Homestay, Confined_NotSevere_NoFamily_Home).
# => FALSE

# The candidate changes the baseline FALSE consequence.
? building(HighSec, Confined_NotSevere_NoFamily_Home).
# => TRUE

# The candidate changes the baseline TRUE consequence.
? building(Homestay, Confined_NotSevere_Family_Home).
# => FALSE

# The candidate changes the baseline FALSE consequence.
? building(HighSec, Confined_NotSevere_Family_Home).
# => TRUE
