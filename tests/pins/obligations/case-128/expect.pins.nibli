# Placement finding route
:expect-pins 2

# The exact Placement finding route reaches its typed reader duty.
? obliged(Review, ReadPlacementFindingDuty, ReadPlacementFindingStandard).
# => TRUE

# The wrong recipient gains no Placement reader duty.
? obliged(WrongPlacementReader, ReadPlacementFindingDuty, ReadPlacementFindingStandard).
# => FALSE
