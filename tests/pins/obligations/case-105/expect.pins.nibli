# Disclosure 389 independent alternate
:expect-pins 3

# A reader cannot be its own independent alternate.
? obliged(DisclosureFusedAlternate389DisclosureNonresponse, DisclosureFusedAlternate389DisclosureNonresponseDuty, DisclosureFusedAlternate389DisclosureNonresponseStandard).
# => FALSE

# A reader cannot be its own independent alternate.
? prevents(DisclosureFusedAlternate389DisclosureNonresponse, SilenceAsDisclosureAction).
# => FALSE

# A reader cannot be its own independent alternate.
? obliged(DisclosureFusedAlternate389DisclosureReader, DisclosureFusedAlternate389DisclosureAlternateDuty, DisclosureFusedAlternate389DisclosureAlternateStandard).
# => FALSE
