# CarryOmission finding route
:expect-pins 2

# The exact CarryOmission finding route reaches its typed reader duty.
? obliged(Appeals, ReadCarryOmissionFindingDuty, ReadCarryOmissionFindingStandard).
# => TRUE

# The wrong recipient gains no CarryOmission reader duty.
? obliged(WrongCarryOmissionReader, ReadCarryOmissionFindingDuty, ReadCarryOmissionFindingStandard).
# => FALSE
