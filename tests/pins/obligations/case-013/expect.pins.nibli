# FS-CCE-210 positive
:expect-pins 3

# FS-CCE-210 positive: Source-specific obligation conflict priority.
? obliged(OblPositive210Bearer, OblPositive210PreferredDuty, OblPositive210PreferredStandard).
# => TRUE

# FS-CCE-210 legal conclusion 2 remains source-bound.
? obliged(OblPositive210Bearer, OblPositive210DeferredDuty, OblPositive210DeferredStandard).
# => TRUE

# FS-CCE-210 legal conclusion 3 remains source-bound.
? prevents(OblPositive210EffectResult, PriorityDischargesOriginalDuty).
# => TRUE
