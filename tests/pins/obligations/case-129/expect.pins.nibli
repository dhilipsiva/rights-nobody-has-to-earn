# Isolation finding route
:expect-pins 2

# The exact Isolation finding route reaches its typed reader duty.
? obliged(Review, ReadIsolationFindingDuty, ReadIsolationFindingStandard).
# => TRUE

# The wrong recipient gains no Isolation reader duty.
? obliged(WrongIsolationReader, ReadIsolationFindingDuty, ReadIsolationFindingStandard).
# => FALSE
