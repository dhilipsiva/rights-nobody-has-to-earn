# FS-CCE-387 omission DisclosureReaderScope
:expect-pins 2

# Missing DisclosureReaderScope withholds every disclosure consequence, including alternate action.
? obliged(OblSpecialOmit387DisclosureReaderScopeDisclosureBearer, OblSpecialOmit387DisclosureReaderScopeDisclosureDuty, OblSpecialOmit387DisclosureReaderScopeDisclosureStandard).
# => FALSE

# Missing DisclosureReaderScope withholds every disclosure consequence, including alternate action.
? obliged(OblSpecialOmit387DisclosureReaderScopeDisclosureReader, ReadAndActOnProportionateDisclosure, OblSpecialOmit387DisclosureReaderScopeDisclosureStandard).
# => FALSE
