# StandingOmission finding route
:expect-pins 2

# The exact StandingOmission finding route reaches its typed reader duty.
? obliged(Appeals, ReadStandingOmissionFindingDuty, ReadStandingOmissionFindingStandard).
# => TRUE

# The wrong recipient gains no StandingOmission reader duty.
? obliged(WrongStandingOmissionReader, ReadStandingOmissionFindingDuty, ReadStandingOmissionFindingStandard).
# => FALSE
