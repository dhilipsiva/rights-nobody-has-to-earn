# TemporalAuthority finding route
:expect-pins 2

# The exact TemporalAuthority finding route reaches its typed reader duty.
? obliged(Appeals, ReadTemporalAuthorityFindingDuty, ReadTemporalAuthorityFindingStandard).
# => TRUE

# The wrong recipient gains no TemporalAuthority reader duty.
? obliged(WrongTemporalAuthorityReader, ReadTemporalAuthorityFindingDuty, ReadTemporalAuthorityFindingStandard).
# => FALSE
