# SPDX-License-Identifier: MIT OR Apache-2.0
# FS-CCE-389 omission PositiveDisclosureNonresponseScope
:expect-pins 3

# Missing PositiveDisclosureNonresponseScope withholds every disclosure consequence, including alternate action.
? obliged(OblSpecialOmit389PositiveDisclosureNonresponseScopeDisclosureNonresponse, OblSpecialOmit389PositiveDisclosureNonresponseScopeDisclosureNonresponseDuty, OblSpecialOmit389PositiveDisclosureNonresponseScopeDisclosureNonresponseStandard).
# => FALSE

# Missing PositiveDisclosureNonresponseScope withholds every disclosure consequence, including alternate action.
? prevents(OblSpecialOmit389PositiveDisclosureNonresponseScopeDisclosureNonresponse, SilenceAsDisclosureAction).
# => FALSE

# Missing PositiveDisclosureNonresponseScope withholds every disclosure consequence, including alternate action.
? obliged(OblSpecialOmit389PositiveDisclosureNonresponseScopeDisclosureAlternate, OblSpecialOmit389PositiveDisclosureNonresponseScopeDisclosureAlternateDuty, OblSpecialOmit389PositiveDisclosureNonresponseScopeDisclosureAlternateStandard).
# => FALSE
