# FS-CCE-389 omission DisclosureAlternateScope
:expect-pins 3

# Missing DisclosureAlternateScope withholds every disclosure consequence, including alternate action.
? obliged(OblSpecialOmit389DisclosureAlternateScopeDisclosureNonresponse, OblSpecialOmit389DisclosureAlternateScopeDisclosureNonresponseDuty, OblSpecialOmit389DisclosureAlternateScopeDisclosureNonresponseStandard).
# => FALSE

# Missing DisclosureAlternateScope withholds every disclosure consequence, including alternate action.
? prevents(OblSpecialOmit389DisclosureAlternateScopeDisclosureNonresponse, SilenceAsDisclosureAction).
# => FALSE

# Missing DisclosureAlternateScope withholds every disclosure consequence, including alternate action.
? obliged(OblSpecialOmit389DisclosureAlternateScopeDisclosureAlternate, OblSpecialOmit389DisclosureAlternateScopeDisclosureAlternateDuty, OblSpecialOmit389DisclosureAlternateScopeDisclosureAlternateStandard).
# => FALSE
