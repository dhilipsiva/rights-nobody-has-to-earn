# Case-specific reviewer qualification; the live constitution is loaded.
:expect-pins 8

? prisoner(Rex).
# => FALSE

? defend(Rex).
# => TRUE

? person(Rex).
# => TRUE

? owe(State, Eats, Rex).
# => TRUE

? false(Rex).
# => TRUE

? free(Rex).
# => FALSE

? show(Rex, Review).
# => TRUE

? prisoner(Sly).
# => FALSE
