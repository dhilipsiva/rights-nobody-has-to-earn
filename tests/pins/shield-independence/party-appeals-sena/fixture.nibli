authorized(Convocation, ShieldConnectionReviewer, Case_Rex).
authorized(ShieldAppointments, ShieldQualificationAuthority, Case_Rex).
authorized(ShieldAppointmentsReview, ShieldQualificationReviewAuthority, Case_Rex).
