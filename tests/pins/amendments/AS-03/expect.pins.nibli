:expect-pins 7
# Generated full-source amendment-semantics pins for AS-03.
# Candidate source deltas are authored by the audit, never enacted by become.

# No registered target label marks the targetless proposal false.
? false(Amend_Targetless).
# => FALSE

# An unbound query confirms that no target tuple exists for the proposal.
? adjust(Amend_Targetless, $t).
# => FALSE

# The amendment label passes without any target fact.
? become(Amend_Targetless, Law).
# => TRUE

# The independently authored source deletion removes the promise.
? entitled(Adam, event { eats() }).
# => FALSE

# Cira is not confined before the scoped adverse-rule probe.
? prisoner(Cira).
# => FALSE

# Deleting the floor line makes the adverse rule loadable.
:accept
all $x: person($x) & ~eats($x) -> prisoner($x).

# The accepted rule now confines a roster person lacking eats.
? prisoner(Cira).
# => TRUE
