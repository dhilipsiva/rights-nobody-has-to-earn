:expect-pins 3
# Retained full-source amendment-semantics scenarios for AS-02.
# Candidate source deltas are explicit counterfactual edits, never enacted by a label.

# An ordinary proposal is not a personal credibility finding.
? false(Amend_Mint).
# => FALSE

# An ordinary proposal still needs the exact-change process.
? become(Amend_Mint, Law).
# => FALSE

# The proposal entries do not alter the source.
? entitled(Adam, event { eats() }).
# => TRUE
