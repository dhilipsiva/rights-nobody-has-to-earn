:expect-pins 3
# Retained full-source amendment-semantics scenarios for AS-01.
# Candidate source deltas are explicit counterfactual edits, never enacted by a label.

# A declared protected target supplies no personal credibility finding.
? false(Amend_Floor).
# => FALSE

# The declared target and tally supply no alternative enactment status.
? become(Amend_Floor, Law).
# => FALSE

# The unchanged source retains the floor promise.
? entitled(Adam, event { eats() }).
# => TRUE
