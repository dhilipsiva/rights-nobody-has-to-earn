:expect-pins 3
# Generated full-source amendment-semantics pins for AS-01.
# Candidate source deltas are authored by the audit, never enacted by become.

# The registered Art_Floor label marks the proposal false.
? false(Amend_Floor).
# => TRUE

# The honest registered-label control does not receive the passing label.
? become(Amend_Floor, Law).
# => FALSE

# The unchanged source retains the floor promise.
? entitled(Adam, event { eats() }).
# => TRUE
