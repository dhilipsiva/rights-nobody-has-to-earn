observe(PSMandateDefectrevieweddefectSource, PSMandateDefectrevieweddefectRecord, PSMandateDefectrevieweddefectHolder, PSCoreHolderScope).
observe(PSMandateDefectrevieweddefectSource, PSMandateDefectrevieweddefectRecord, PSMandateDefectrevieweddefectLaw, PSCoreDemocraticLegalSourceScope).
observe(PSMandateDefectrevieweddefectSource, PSMandateDefectrevieweddefectRecord, PSMandateDefectrevieweddefectOperator, PSCoreExecutorScope).
observe(PSMandateDefectrevieweddefectSource, PSMandateDefectrevieweddefectRecord, PSMandateDefectrevieweddefectReader, PSCoreChallengeReaderScope).
observe(PSMandateDefectrevieweddefectSource, PSMandateDefectrevieweddefectRecord, PSMandateDefectrevieweddefectRemedy, PSCoreRemedyScope).
observe(PSMandateDefectrevieweddefectSource, PSMandateDefectrevieweddefectRecord, PSMandateDefectrevieweddefectReview, PSOrdinaryReviewingActorScope).
observe(PSMandateDefectrevieweddefectSource, PSMandateDefectrevieweddefectRecord, PSMandateDefectrevieweddefectRevision, PSCoreCurrentSelectedRevisionScope).
observe(PSMandateDefectrevieweddefectSource, PSMandateDefectrevieweddefectRecord, PSMandateDefectrevieweddefectRevision, PSRecordRevisionScope).
observe(PSMandateDefectrevieweddefectSource, PSMandateDefectrevieweddefectRecord, PSMandateDefectrevieweddefectStart, PSCoreStartScope).
observe(PSMandateDefectrevieweddefectSource, PSMandateDefectrevieweddefectRecord, PSMandateDefectrevieweddefectWindow, PSCoreWindowScope).
observe(PSMandateDefectrevieweddefectSource, PSMandateDefectrevieweddefectRecord, PSNonDerogatingEmergencyDeclaration, PSAffectedKindScope).
observe(PSMandateDefectrevieweddefectSource, PSMandateDefectrevieweddefectRecord, PSOrdinaryRoute, PSAuthorizationModeScope).
observe(PSMandateDefectrevieweddefectSource, PSMandateDefectrevieweddefectRecord, PSOrdinaryRoute, PSReviewModeScope).
observe(PSMandateDefectrevieweddefectSource, PSMandateDefectrevieweddefectRecord, PSOwnCurrentWindow, PSWindowModeScope).
observe(PSMandateDefectrevieweddefectSource, PSMandateDefectrevieweddefectRecord, PositiveIndependentEvidenceOfExactDefectNotMissingPersonInference, PSFindingScope).
observe(PSMandateDefectrevieweddefectSource, PSMandateDefectrevieweddefectRecord, PublicAccessibleReasonsNarrowPrivateEvidencePurposeRetentionAndCorrection, PSCorePrivacyScope).
observe(PSMandateDefectrevieweddefectSource, PSMandateDefectrevieweddefectRecord, StandingFloorVoiceFranchiseCounselChallengeAndRemedyContinue, PSCoreContinuityScope).
observe(PSMandateDefectrevieweddefectSource, PSMandateDefectrevieweddefectRecord, StopAffectedReliancePreserveEvidenceCareChallengeAndIndependentJudicialRemedy, PSInterimDutyScope).

? complete(PSMandateConflictdeclarationRecord, PSNonDerogatingEmergencyDeclaration, PSMandateConflictdeclarationSubject).
# => FALSE
? complete(PSMandateConflictrequisitionRecord, PSCompensatedRequisitionMeasure, PSMandateConflictrequisitionSubject).
# => FALSE
# The person whose property was taken keeps standing and the floor, and the
# operator still owes the return or compensation the taking created.
? person(PSMandateConflictrequisitionSubject).
# => TRUE
? owe(State, Eats, PSMandateConflictrequisitionSubject).
# => TRUE
? obliged(PSMandateConflictrequisitionOperator, InventoryAccountForReturnOrCompensateRequisitionedProperty, PSMandateConflictrequisitionRecord).
# => TRUE
? prevents(PSMandateConflictrequisitionSubject, PSElectionDelayOrMandateExtension).
# => TRUE

# ── A government that cannot be formed ───────────────────────────────────────
# After a certified formation failure a caretaker may act under existing law
# and the floor only; it holds no confidence mandate.
? authority(FSBOD_04, FSPOW_041, SFMainP120Record).
# => TRUE
? authority(FSBOD_04, FSPOW_014, SFMainP120Record).
# => FALSE
# Once the constitutional deadline has passed, the electoral body may call a
# fresh election.
? authority(FSBOD_06, FSPOW_042, SFMainP122Record).
# => TRUE

# ── The Assembly's term ends before its successor can be elected ─────────────
# A source and an independent reviewer, neither of them the chamber, certify
# that the People's Assembly's term has ended. The electoral body now owes the
# election at the first lawful opportunity, and the outgoing chamber may sit,
# but only under caretaker limits.
authorized(TermEndClerk, TermEndSourceAuthority, AssemblyTermEnd).
authorized(TermEndAuditor, IndependentTermEndReviewAuthority, AssemblyTermEnd).
observe(TermEndClerk, AssemblyTermEnd, FSBOD_02, ExpiredTermChamberScope).
observe(TermEndAuditor, AssemblyTermEnd, FSBOD_02, ExpiredTermChamberScope).
? obliged(FSBOD_06, HoldTheElectionAtTheFirstLawfulOpportunity, AssemblyTermEnd).
# => TRUE
? permits(FSBOD_02, SitUnderCaretakerLimitsUntilTheSuccessorFirstMeets, AssemblyTermEnd).
# => TRUE
? obliged(FSBOD_02, ActOnlyUnderExistingLawTheFloorOversightAndTheElectionWithoutAmendmentOrIrreversibleMeasure, AssemblyTermEnd).
# => TRUE

# The chamber cannot certify the end of its own term.
authorized(FSBOD_02, TermEndSourceAuthority, SelfCertifiedTermEnd).
authorized(TermEndAuditor, IndependentTermEndReviewAuthority, SelfCertifiedTermEnd).
observe(FSBOD_02, SelfCertifiedTermEnd, FSBOD_02, ExpiredTermChamberScope).
observe(TermEndAuditor, SelfCertifiedTermEnd, FSBOD_02, ExpiredTermChamberScope).
? permits(FSBOD_02, SitUnderCaretakerLimitsUntilTheSuccessorFirstMeets, SelfCertifiedTermEnd).
# => FALSE

# ── The election cannot yet be held ──────────────────────────────────────────
# A finding of impossibility by the Executive Council is not independent and
# obliges nobody. One by an independent source and reviewer obliges the
# Constitutional Court to review it promptly, and the election duty stays.
authorized(FSBOD_04, ElectionImpossibilitySourceAuthority, ExecutiveImpossibility).
authorized(ImpossibilityReviewer, IndependentElectionImpossibilityReviewAuthority, ExecutiveImpossibility).
observe(FSBOD_04, ExecutiveImpossibility, FSBOD_02, ImpossibleElectionChamberScope).
observe(ImpossibilityReviewer, ExecutiveImpossibility, FSBOD_02, ImpossibleElectionChamberScope).
? obliged(FSBOD_18, ReviewTheElectionImpossibilityFindingPromptly, ExecutiveImpossibility).
# => FALSE
authorized(HazardAssessor, ElectionImpossibilitySourceAuthority, HazardImpossibility).
authorized(ImpossibilityReviewer, IndependentElectionImpossibilityReviewAuthority, HazardImpossibility).
observe(HazardAssessor, HazardImpossibility, FSBOD_02, ImpossibleElectionChamberScope).
observe(ImpossibilityReviewer, HazardImpossibility, FSBOD_02, ImpossibleElectionChamberScope).
? obliged(FSBOD_18, ReviewTheElectionImpossibilityFindingPromptly, HazardImpossibility).
# => TRUE
? obliged(FSBOD_06, HoldTheElectionAtTheFirstLawfulOpportunity, AssemblyTermEnd).
# => TRUE

# ── The election could be held and is not ────────────────────────────────────
authorized(ElectionMonitor, ElectionNonresponseSourceAuthority, ElectionNotHeld).
authorized(ElectionAuditor, IndependentElectionNonresponseReviewAuthority, ElectionNotHeld).
observe(ElectionMonitor, ElectionNotHeld, FSBOD_06, ElectionNonresponseBodyScope).
observe(ElectionAuditor, ElectionNotHeld, FSBOD_06, ElectionNonresponseBodyScope).
? obliged(FSBOD_18, OrderTheElectionAndSecureItsConditions, ElectionNotHeld).
# => TRUE

# ── The successor meets ──────────────────────────────────────────────────────
# The outgoing chamber's sitting ends when the reviewer records that its
# successor has first met. The delay gave it nothing to keep.
observe(TermEndAuditor, AssemblyTermEnd, SuccessorChamberFirstMet, TermEndDispositionScope).
? permits(FSBOD_02, SitUnderCaretakerLimitsUntilTheSuccessorFirstMeets, AssemblyTermEnd).
# => FALSE
? obliged(FSBOD_02, ActOnlyUnderExistingLawTheFloorOversightAndTheElectionWithoutAmendmentOrIrreversibleMeasure, AssemblyTermEnd).
# => FALSE

# ── Where it stops ───────────────────────────────────────────────────────────
# Nothing here holds an election, sets a date or advances a clock. A duty to
# hold the election is not an election, and an order to secure it is not a
# vote cast.
? authority(FSBOD_06, FSPOW_042, SFMainP120Record).
# => FALSE
