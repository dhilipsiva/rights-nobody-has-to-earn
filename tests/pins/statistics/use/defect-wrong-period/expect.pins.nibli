? obliged(StatisticsSequenceOperator, PublishPrivacySafeStatisticsCorrection, StatisticsSequenceRecord).
# => FALSE
? complete(StatisticsDefectRecord, ReviewedStatisticalUseDefect, StatisticsSequenceDataset).
# => FALSE
