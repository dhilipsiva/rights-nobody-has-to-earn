# Owed is not delivered, and the record says which it has. Every floor item
# is owed to Oren and not one of them arrives, because nothing was recorded
# as having reached him. This is the chapter-8 claim, executable.
:expect-pins 12

? eats(Oren).
# => FALSE
? dwell(Oren).
# => FALSE
? healthy(Oren).
# => FALSE
? secure(Oren).
# => FALSE
? meets(Oren).
# => FALSE
? learn(Oren).
# => FALSE
? expresses(Oren).
# => FALSE
? believe(Oren).
# => FALSE
? person(Oren).
# => TRUE
? owe(State, Eats, Oren).
# => TRUE
? owe(State, Dwell, Oren).
# => TRUE
? decide(Oren, Ballot).
# => TRUE
