# A provider's own word is not delivery. This is the rule the legacy
# learning route established and the delivery family kept: the witness must
# be somebody other than the source, and without that nothing arrives.
:expect-pins 3

? eats(Noor).
# => FALSE
? person(Noor).
# => TRUE
? owe(State, Eats, Noor).
# => TRUE
