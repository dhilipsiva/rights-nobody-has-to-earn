:expect-pins 8
# Fresh-process temporal case TA-39.

# The two fully witnessed subjects derive the typed case collision.
? collide(Case_Adam, CaseBinding).
# => TRUE

# The compact case tag remains derivable for the raw tuples but cannot bypass the explicit collision reader.
? related(Case_Adam, CaseBound).
# => TRUE

# The case cannot select the original subject after collision.
? match(Adam, CaseRecorded).
# => FALSE

# A collided case cannot support active custody power.
? correct(Case_Adam, ActivePower).
# => FALSE

# The Court gate cannot choose the convenient subject.
? prisoner(Adam).
# => FALSE

# The inactive lease remains visible on the lease identifier.
? err(Case_Adam, TemporalRecord).
# => TRUE

# The attempted authority against the original subject is separately visible.
? err(Adam, TemporalAuthority).
# => TRUE

# The attempted authority against the competing subject is separately visible too.
? err(TA_Case_Alternate, TemporalAuthority).
# => TRUE
