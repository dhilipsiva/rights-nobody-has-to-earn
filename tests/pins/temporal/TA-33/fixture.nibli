replace(TA_Ambiguous_Current, TA_Ambiguous_Previous, Chronicle).
list(TA_Ambiguous_Previous_A, TA_Ambiguous_Previous, ManifestOrder, Chronicle).
list(TA_Ambiguous_Previous_B, TA_Ambiguous_Previous, ManifestOrder, Chronicle).
list(TA_Ambiguous_Current_Manifest, TA_Ambiguous_Current, ManifestOrder, Chronicle).
observe(Chronicle, TA_Ambiguous_Previous_A, TA_Ambiguous_Previous, ManifestScope).
observe(TemporalReview, TA_Ambiguous_Previous_A, TA_Ambiguous_Previous, ManifestScope).
observe(Chronicle, TA_Ambiguous_Previous_B, TA_Ambiguous_Previous, ManifestScope).
observe(TemporalReview, TA_Ambiguous_Previous_B, TA_Ambiguous_Previous, ManifestScope).
observe(Chronicle, TA_Ambiguous_Current_Manifest, TA_Ambiguous_Current, ManifestScope).
observe(TemporalReview, TA_Ambiguous_Current_Manifest, TA_Ambiguous_Current, ManifestScope).
