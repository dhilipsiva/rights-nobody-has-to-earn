:expect-pins 3
# Fresh-process temporal case TA-04.

# The successor-only carried member is a named forgery.
? err(TA_Forged, CarryForgery).
# => TRUE

# The forged member is not an effective carry.
? match(TA_Forged, CarriedVoid).
# => FALSE

# The forged carry cannot create the void conclusion.
? false(TA_Forged).
# => FALSE
