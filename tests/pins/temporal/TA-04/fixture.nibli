replace(TA_Forge_Current, TA_Forge_Previous, Chronicle).
list(TA_Forge_Manifest_Previous, TA_Forge_Previous, ManifestOrder, Chronicle).
list(TA_Forge_Manifest_Current, TA_Forge_Current, ManifestOrder, Chronicle).
observe(Chronicle, TA_Forge_Manifest_Previous, TA_Forge_Previous, ManifestScope).
observe(TemporalReview, TA_Forge_Manifest_Previous, TA_Forge_Previous, ManifestScope).
observe(Chronicle, TA_Forge_Manifest_Current, TA_Forge_Current, ManifestScope).
observe(TemporalReview, TA_Forge_Manifest_Current, TA_Forge_Current, ManifestScope).
carries(Chronicle, TA_Forged, TA_Forge_Current, TA_Forge_Previous, VoidCarry).
carries(TemporalReview, TA_Forged, TA_Forge_Current, TA_Forge_Previous, VoidCarry).
rotten(TA_Forged).
