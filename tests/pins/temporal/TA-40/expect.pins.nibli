:expect-pins 5
# Fresh-process temporal case TA-40.

# The two fully witnessed lineage versions derive the typed binding collision.
? collide(Binding_Chronicle, LineageBinding).
# => TRUE

# The snapshot transition remains independently auditable.
? succeed(Epoch_Current, Transition).
# => TRUE

# A conflicted constitutional-lineage binding cannot select a terminal legal endpoint.
? succeed(Epoch_Current, TerminalTransition).
# => FALSE

# Adverse carry loses effect when canonical lineage is ambiguous.
? match(Vex, CarriedVoid).
# => FALSE

# The source cannot choose a convenient lineage version to preserve the adverse consequence.
? false(Vex).
# => FALSE
