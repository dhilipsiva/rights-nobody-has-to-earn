:expect-pins 11
# Fresh-process temporal case TA-27.

# The raw authority record remains present and tied to the exact case.
? authorized(Case_Adam, ActiveCustody, Case_Adam).
# => TRUE

# The independently witnessed case and holder binding remains present.
? related(Case_Adam, CaseBound).
# => TRUE

# One power witness cannot create the typed PowerBound status.
? succeed(Case_Adam, PowerBound).
# => FALSE

# The raw authorized lease keeps the attempted case authority visible without granting active power.
? match(Adam, CaseRecorded).
# => TRUE

# Withheld power evidence fails closed for the restrictive authority.
? correct(Case_Adam, ActivePower).
# => FALSE

# The Court cannot confine on a one-witness power record.
? prisoner(Adam).
# => FALSE

# Liberty follows the absence of active custody without a new release gate.
? travel(Adam).
# => TRUE

# Suspended authority does not fabricate a release record.
? free(Adam).
# => FALSE

# The raw inactive lease is visible on its own identifier.
? err(Case_Adam, TemporalRecord).
# => TRUE

# The raw attempted authority remains visible as a named defect despite missing typed power evidence.
? err(Adam, TemporalAuthority).
# => TRUE

# The affected person's challenge reaches the existing Appeals duty reader.
? obliged(Appeals, Adam).
# => TRUE
