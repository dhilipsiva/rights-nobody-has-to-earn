replace(TA_Disjoint_Current, TA_Disjoint_Previous, Chronicle).
list(TA_Disjoint_Manifest_Previous, TA_Disjoint_Previous, ManifestOrder, Chronicle).
list(TA_Disjoint_Manifest_Current, TA_Disjoint_Current, ManifestOrder, Chronicle).
observe(Chronicle, TA_Disjoint_Manifest_Previous, TA_Disjoint_Previous, ManifestScope).
observe(TemporalReview, TA_Disjoint_Manifest_Previous, TA_Disjoint_Previous, ManifestScope).
observe(Chronicle, TA_Disjoint_Manifest_Current, TA_Disjoint_Current, ManifestScope).
observe(TemporalReview, TA_Disjoint_Manifest_Current, TA_Disjoint_Current, ManifestScope).
authorized(TA_Disjoint_Subject, VoidStatus, TA_Disjoint_Previous).
observe(Chronicle, TA_Disjoint_Subject, TA_Disjoint_Previous, VoidScope).
observe(TemporalReview, TA_Disjoint_Subject, TA_Disjoint_Previous, VoidScope).
carries(Chronicle, TA_Disjoint_Subject, TA_Disjoint_Current, TA_Disjoint_Previous, VoidCarry).
carries(TemporalReview, TA_Disjoint_Subject, TA_Disjoint_Current, TA_Disjoint_Previous, VoidCarry).
rotten(TA_Disjoint_Subject).
