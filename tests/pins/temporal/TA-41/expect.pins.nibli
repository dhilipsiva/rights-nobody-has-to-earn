:expect-pins 8
# Fresh-process temporal case TA-41.

# The supplied challenge fact suspends the exact challenged lease.
? collide(TA_Challenge_Case, LeaseSuspended).
# => TRUE

# A suspended lease cannot receive active-power status.
? correct(TA_Challenge_Case, ActivePower).
# => FALSE

# The challenged lease cannot become current restrictive authority.
? match(TA_Challenge_Case, ActivePower).
# => FALSE

# The supplied challenge blocks the custody conclusion in this fresh evaluation.
? prisoner(TA_Challenge_Subject).
# => FALSE

# The supplied challenge makes the person-scoped temporal dispute visible.
? err(TA_Challenge_Subject, TemporalDispute).
# => TRUE

# The visible dispute derives a duty but no performed review or remedy.
? obliged(Appeals, TA_Challenge_Subject).
# => TRUE

# Suspension does not fabricate an affirmative release act.
? free(TA_Challenge_Subject).
# => FALSE

# The challenge route does not consume the supplied standing fact.
? person(TA_Challenge_Subject).
# => TRUE
