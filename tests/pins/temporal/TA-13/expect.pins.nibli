:expect-pins 10
# Fresh-process temporal case TA-13.

# The supplied opposite event-claim identifier remains visible rather than hidden.
? precede(TA_Order_Opposite, EventSequence).
# => TRUE

# The supplied opposite record-claim identifier remains visible rather than hidden.
? precede(TA_Log_Opposite, RecordSequence).
# => TRUE

# The exact reverse event path remains represented.
? precede(Epoch_Review, Epoch_Current, EventPath).
# => TRUE

# The exact reverse record path remains represented.
? precede(Epoch_Review, Epoch_Current, RecordPath).
# => TRUE

# The original event claim is named as participating in the cycle.
? err(Order_Court_A, OrderConflict).
# => TRUE

# The opposite event claim is independently named as conflicted.
? err(TA_Order_Opposite, OrderConflict).
# => TRUE

# The original record claim is named as participating in the cycle.
? err(Order_Log_Court_A, OrderConflict).
# => TRUE

# The opposite record claim is independently named as conflicted.
? err(TA_Log_Opposite, OrderConflict).
# => TRUE

# A challenge to the timing review reaches the appeals body when the claim it
# names is in conflict, and not otherwise.
challenge(TA_Conflict_Challenger, TA_Order_Opposite, TemporalReview).
? obliged(Appeals, TA_Conflict_Challenger).
# => TRUE
challenge(TA_Quiet_Challenger, TA_Quiet_Claim, TemporalReview).
? obliged(Appeals, TA_Quiet_Challenger).
# => FALSE
