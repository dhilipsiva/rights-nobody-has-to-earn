# Severity is a ceiling on placement, not an order to use the harshest place.
:expect-pins 221
? responsible(Case_BoundaryGraveHome, CustodyMerits).
# => TRUE
? attribute(Severity_BoundaryGraveHome_GraveInjury_Ivo, GraveInjury).
# => TRUE
? severe(BoundaryGraveHome, Case_BoundaryGraveHome).
# => TRUE
? fit(BoundaryGraveHome, Homestay, Case_BoundaryGraveHome).
# => TRUE
? fit(BoundaryGraveHome, SupportedResidence, Case_BoundaryGraveHome).
# => TRUE
? fit(BoundaryGraveHome, HighSec, Case_BoundaryGraveHome).
# => TRUE
? building(Homestay, BoundaryGraveHome).
# => TRUE
? building(HighSec, BoundaryGraveHome).
# => FALSE
? responsible(Case_BoundaryTwoVictims, CustodyMerits).
# => TRUE
? attribute(Severity_BoundaryTwoVictims_IntentionalInjury_Opal, IntentionalInjury).
# => TRUE
? attribute(Severity_BoundaryTwoVictims_InjuryToPerson_Pax, InjuryToPerson).
# => TRUE
? severe(BoundaryTwoVictims, Case_BoundaryTwoVictims).
# => FALSE
? fit(BoundaryTwoVictims, HighSec, Case_BoundaryTwoVictims).
# => FALSE
? prisoner(BoundaryTwoVictims).
# => FALSE
? building(HighSec, BoundaryTwoVictims).
# => FALSE
? owe(State, Dwell, BoundaryTwoVictims).
# => TRUE
? decide(BoundaryTwoVictims, Ballot).
# => TRUE
# A qualified cruelty case with an adequate home retains the home route.
? severe(Placement_severe_at_home, Case_Placement_severe_at_home).
# => TRUE
? fit(Placement_severe_at_home, Homestay, Case_Placement_severe_at_home).
# => TRUE
? correct(Case_Placement_severe_at_home, ActivePower).
# => TRUE
? prisoner(Placement_severe_at_home).
# => TRUE
? building(Homestay, Placement_severe_at_home).
# => TRUE
? building(HighSec, Placement_severe_at_home).
# => FALSE


