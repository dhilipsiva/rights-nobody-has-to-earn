# => FALSE
? err(ConditionSubject, Isolation).
# => FALSE
observe(ConditionReviewer, Isolation_Report, PositiveEvidenceNoticeReasonsAndIndependentContest, CustodyConditionProcedureScope).
? responsible(Isolation_Report, CustodyIsolationFinding).
