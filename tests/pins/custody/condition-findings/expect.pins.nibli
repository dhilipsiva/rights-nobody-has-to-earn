:refuse reasoning /declared derived-only/
responsible(ForgedIsolation, CustodyIsolationFinding).
:refuse reasoning /declared derived-only/
err(Bela, Isolation).

# One condition record binds one subject to one holding and one holder to one
# place. A second binding of either kind is a collision, not a choice.
list(Isolation_Twice, ConditionSubject, Holding_Twice_A, CustodyIsolationFinding).
? collide(Isolation_Twice, CustodyConditionBinding).
# => FALSE
list(Isolation_Twice, ConditionSubject, Holding_Twice_B, CustodyIsolationFinding).
? collide(Isolation_Twice, CustodyConditionBinding).
# => TRUE
list(Isolation_TwoSubjects, ConditionSubject, Holding_Two, CustodyIsolationFinding).
list(Isolation_TwoSubjects, OtherConditionSubject, Holding_Two, CustodyIsolationFinding).
? collide(Isolation_TwoSubjects, CustodyConditionBinding).
# => TRUE
list(Isolation_TwoPlaces, HoldingActor, Place_Two_A, CustodyConditionLocation).
list(Isolation_TwoPlaces, HoldingActor, Place_Two_B, CustodyConditionLocation).
? collide(Isolation_TwoPlaces, CustodyConditionBinding).
# => TRUE
list(Isolation_TwoHolders, HoldingActor, Place_Two, CustodyConditionLocation).
list(Isolation_TwoHolders, OtherHoldingActor, Place_Two, CustodyConditionLocation).
? collide(Isolation_TwoHolders, CustodyConditionBinding).
# => TRUE

# ── A withheld floor item is a condition finding, like denied contact ─────────
# "A deprivation finding names the person held, the holding, the holder, the
# place, the period, the evidence and the item withheld, from a closed list of
# what a holder provides: food, shelter, care, learning and material security."
# Food is withheld here; the holder is a third party to both actors.
? prisoner(DeprivedSubject).
# => FALSE
? person(DeprivedSubject).
# => FALSE
list(Deprivation_Report, DeprivedSubject, Holding_Deprivation_Report, CustodyDeprivationFinding).
list(Deprivation_Report, HoldingActor, Place_Deprivation_Report, CustodyConditionLocation).
list(Deprivation_Report, Period_Deprivation_Report, Evidence_Deprivation_Report, CustodyConditionEvidenceWindow).
authorized(ConditionWitness, CustodyConditionWitness, Deprivation_Report).
authorized(ConditionReviewer, IndependentCustodyConditionReviewer, Deprivation_Report).
observe(ConditionWitness, Deprivation_Report, DeprivedSubject, CustodyConditionSubjectScope).
observe(ConditionWitness, Deprivation_Report, Holding_Deprivation_Report, CustodyConditionHoldingScope).
observe(ConditionWitness, Deprivation_Report, HoldingActor, CustodyConditionHolderScope).
observe(ConditionWitness, Deprivation_Report, Place_Deprivation_Report, CustodyConditionPlaceScope).
observe(ConditionWitness, Deprivation_Report, Period_Deprivation_Report, CustodyConditionPeriodScope).
observe(ConditionWitness, Deprivation_Report, Evidence_Deprivation_Report, CustodyConditionEvidenceScope).
observe(ConditionWitness, Deprivation_Report, Eats, CustodyDeprivationItemScope).
observe(ConditionWitness, Deprivation_Report, PositiveEvidenceNoticeReasonsAndIndependentContest, CustodyConditionProcedureScope).
observe(ConditionReviewer, Deprivation_Report, DeprivedSubject, CustodyConditionSubjectScope).
observe(ConditionReviewer, Deprivation_Report, Holding_Deprivation_Report, CustodyConditionHoldingScope).
observe(ConditionReviewer, Deprivation_Report, HoldingActor, CustodyConditionHolderScope).
observe(ConditionReviewer, Deprivation_Report, Place_Deprivation_Report, CustodyConditionPlaceScope).
observe(ConditionReviewer, Deprivation_Report, Period_Deprivation_Report, CustodyConditionPeriodScope).
observe(ConditionReviewer, Deprivation_Report, Evidence_Deprivation_Report, CustodyConditionEvidenceScope).
observe(ConditionReviewer, Deprivation_Report, PositiveEvidenceNoticeReasonsAndIndependentContest, CustodyConditionProcedureScope).
# The reviewer has yet to record the item: the finding waits, and with it the
# marker and the holder's duty. Agreement on the person already identifies a
# human subject, so the identification and the floor debt lead the finding.
? responsible(Deprivation_Report, CustodyDeprivationFinding).
# => FALSE
? err(DeprivedSubject, Deprivation).
# => FALSE
? obliged(HoldingActor, RestoreTheWithheldFloorItemAtOnce, DeprivedSubject).
# => FALSE
? person(DeprivedSubject).
# => FALSE
observe(ConditionReviewer, Deprivation_Report, Eats, CustodyDeprivationItemScope).
? responsible(Deprivation_Report, CustodyDeprivationFinding).
# => TRUE
? err(DeprivedSubject, Deprivation).
# => TRUE
# "the finding marks the breach, obliges the holder to restore the item at once
# and gives the review body its duty"
? obliged(HoldingActor, RestoreTheWithheldFloorItemAtOnce, DeprivedSubject).
# => TRUE
? obliged(Review, DeprivedSubject).
# => TRUE
# The person held is a person, owed food; no sentence is needed for the
# protection, and the finding is no receipt.
? person(DeprivedSubject).
# => TRUE
? owe(State, Eats, DeprivedSubject).
# => TRUE
? prisoner(DeprivedSubject).
# => FALSE
? eats(DeprivedSubject).
# => FALSE
# A later independently witnessed meal concludes food received on that
# occasion; the finding about the period stands.
receives(DeprivedSubject, LaterMeal, Caterer).
authorized(MealWitness, DeliveryWitness, DeprivedSubject).
observe(MealWitness, LaterMeal, DeprivedSubject, FoodScope).
? eats(DeprivedSubject).
# => TRUE
? err(DeprivedSubject, Deprivation).
# => TRUE
# A writer without authority for the record who names another item leaves the
# finding standing.
observe(UncredentialedWriter, Deprivation_Report, Dwell, CustodyDeprivationItemScope).
? err(DeprivedSubject, Deprivation).
# => TRUE
# The holder cannot witness its own deprivation; identification by two distinct
# actors still stands.
list(Deprivation_Holder, HeldDeprivedSubject, Holding_Deprivation_Holder, CustodyDeprivationFinding).
list(Deprivation_Holder, HoldingActor, Place_Deprivation_Holder, CustodyConditionLocation).
list(Deprivation_Holder, Period_Deprivation_Holder, Evidence_Deprivation_Holder, CustodyConditionEvidenceWindow).
authorized(HoldingActor, CustodyConditionWitness, Deprivation_Holder).
authorized(ConditionReviewer, IndependentCustodyConditionReviewer, Deprivation_Holder).
observe(HoldingActor, Deprivation_Holder, HeldDeprivedSubject, CustodyConditionSubjectScope).
observe(HoldingActor, Deprivation_Holder, Holding_Deprivation_Holder, CustodyConditionHoldingScope).
observe(HoldingActor, Deprivation_Holder, HoldingActor, CustodyConditionHolderScope).
observe(HoldingActor, Deprivation_Holder, Place_Deprivation_Holder, CustodyConditionPlaceScope).
observe(HoldingActor, Deprivation_Holder, Period_Deprivation_Holder, CustodyConditionPeriodScope).
observe(HoldingActor, Deprivation_Holder, Evidence_Deprivation_Holder, CustodyConditionEvidenceScope).
observe(HoldingActor, Deprivation_Holder, Eats, CustodyDeprivationItemScope).
observe(HoldingActor, Deprivation_Holder, PositiveEvidenceNoticeReasonsAndIndependentContest, CustodyConditionProcedureScope).
observe(ConditionReviewer, Deprivation_Holder, HeldDeprivedSubject, CustodyConditionSubjectScope).
observe(ConditionReviewer, Deprivation_Holder, Holding_Deprivation_Holder, CustodyConditionHoldingScope).
observe(ConditionReviewer, Deprivation_Holder, HoldingActor, CustodyConditionHolderScope).
observe(ConditionReviewer, Deprivation_Holder, Place_Deprivation_Holder, CustodyConditionPlaceScope).
observe(ConditionReviewer, Deprivation_Holder, Period_Deprivation_Holder, CustodyConditionPeriodScope).
observe(ConditionReviewer, Deprivation_Holder, Evidence_Deprivation_Holder, CustodyConditionEvidenceScope).
observe(ConditionReviewer, Deprivation_Holder, Eats, CustodyDeprivationItemScope).
observe(ConditionReviewer, Deprivation_Holder, PositiveEvidenceNoticeReasonsAndIndependentContest, CustodyConditionProcedureScope).
? responsible(Deprivation_Holder, CustodyDeprivationFinding).
# => FALSE
? err(HeldDeprivedSubject, Deprivation).
# => FALSE
? obliged(HoldingActor, RestoreTheWithheldFloorItemAtOnce, HeldDeprivedSubject).
# => FALSE
? person(HeldDeprivedSubject).
# => TRUE
