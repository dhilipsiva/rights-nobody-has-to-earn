# Accusations and their actual consequences; every original scenario retained.
:expect-pins 21

? authority(Boss).
# => TRUE
? defend(Torvi).
# => TRUE

# The unsigned allegation cannot defeat this disclosure.
deceive(Torvi, Boss).

? defend(Torvi).
# => TRUE

show(Torvi, Disclosure_Torvi_Review, Review).
? authority(Review).
# => TRUE
? defend(Torvi).
# => TRUE

? reward(Marn).
# => FALSE

# Neither examination nor an accusation creates a constitutional recognition status.
deceive(Marn, Vasha).

? reward(Marn).
# => FALSE

# Unsigned harm and a generic judgment cannot supply signed case-bound severity.
attack(Quilo, Sepp).
cruel(Quilo, Sepp).

? severe(Quilo).
# => FALSE
? severe(Sepp).
# => FALSE

judge(Court, Marn).
cite(Court, MarnCase, Marn).
attack(Marn, Sepp).
cruel(Marn, Sepp).
? severe(Marn).
# => FALSE

? prisoner(Quilo).
# => FALSE
? prisoner(Marn).
# => FALSE

? severe(Lalo).
# => TRUE
? severe(Don).
# => TRUE
? severe(Ruk).
# => TRUE

? severe(Hano).
# => FALSE

? false(Torvi).
# => FALSE

# A generic judgment cannot substitute for the completed credibility case.
judge(Review, Torvi).

? false(Torvi).
# => FALSE

? person(Torvi).
# => TRUE
? owe(State, Eats, Torvi).
# => TRUE
? prisoner(Torvi).
# => FALSE
