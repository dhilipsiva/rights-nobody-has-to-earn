# SPDX-License-Identifier: MIT OR Apache-2.0
# BURDEN-SHIFTING: having been refused in one domain, try the other. A
# restriction reviewed for a knowledge matter is asked to license surveillance;
# a record holding reviewed for a subject is asked to license a restriction.
# Both refuse, and each family's own record is unaffected, because every
# dependent record rejoins the exact authorization it names rather than any
# authorization of the right shape.

:expect-pins 6

# Each family's own record still completes where it was reviewed.
? complete(KnowledgeCaseRecord, ReviewedKnowledgeRestriction, KnowledgeCaseMatter).
# => TRUE
? complete(RecordCaseRecord, ReviewedRecordProcessing, RecordCaseSubject).
# => TRUE
# Neither family's authorization reaches the other's subject matter.
? complete(KnowledgeCaseRecord, ReviewedRecordProcessing, KnowledgeCaseMatter).
# => FALSE
? complete(RecordCaseRecord, ReviewedKnowledgeRestriction, RecordCaseSubject).
# => FALSE
? permits(KnowledgeCaseActor, TargetedSurveillance, KnowledgeCaseRecord).
# => FALSE
? authority(RecordCaseHolder, ReviewedConductRestriction, RecordCaseRecord).
# => FALSE
