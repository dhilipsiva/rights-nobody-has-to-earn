# ── Constitution pins: constitution.nibli ───────────────────────────────────────
#
# KIND: CONTENT pin. The fixture is the SUBJECT of these pins, so it is loaded
# rather than inlined — inlining it would make this file certify a copy, and the
# copy drifts. Contrast nibli's own pins/*.nibli, which are MECHANISM pins and
# inline their fixtures precisely because the fixture is not the subject.
#
# Run:
#   ./verify.sh --only new-book-plans/rights-floor.pins.nibli
#   ./verify.sh          # the real check — the line above cannot see
#                        # the cross-file reconciliation or the prose guards
#
# Every verdict below was produced by the engine, never by hand.

# WHAT FALSE MEANS HERE — three kinds, and only one is a verdict. A FALSE on a
# corpus name this KB never mentions is real but empty: nothing could have made
# it TRUE. A non-corpus name is not a FALSE at all — the run aborts, pins not
# trustworthy. And a well-formed query on an argument its relation never
# carries is a vacuous green that passes forever. Article 0a closed the
# ASSERTION side only — a widening fact now aborts the run instead of loading —
# but a QUERY on an unmentioned name still answers a clean FALSE, so kind one
# is untouched. Pin a FALSE only where the KB could have said TRUE, and say in
# the comment what would flip it.

:expect-pins 100
# --- v0.1 regression pins ---
? false(Bela).
# => TRUE
? false(Esa).
# => FALSE
? reward(Dev).
# => FALSE
? false(Mira).
# => FALSE
? false(Lupo).
# => TRUE
? prisoner(Ivo).
# => FALSE
? prisoner(Hano).
# => TRUE
? prisoner(Nia).
# => FALSE
? prisoner(Jala).
# => FALSE
? travel(Jala).
# => TRUE
? expresses(Adam).
# => TRUE
? defend(Rebel).
# => TRUE
? prisoner(Rebel).
# => FALSE
? false(Rebel).
# => FALSE
? building(HighSec, Lalo).
# => TRUE
? building(LowSec, Nando).
# => FALSE
? dwell(Hano).
# => TRUE
# --- E1/E2/E3 closures ---
? defend(Don).
# => FALSE
? prisoner(Don).
# => TRUE
? defend(Sly).
# => TRUE
? defend(Kel).
# => FALSE
? false(Kel).
# => TRUE
? permits(Review, Vex).
# => FALSE
? permits(Tribunal, Wren).
# => TRUE
? false(Vex).
# => TRUE
? false(Tyr).
# => FALSE
? authority(Boss).
# => TRUE
? permits(Review, Boss).
# => FALSE
? prisoner(Ruk).
# => TRUE
? building(HighSec, Ruk).
# => TRUE
? fit(Ruk, Homestay).
# => FALSE
# [v0.9] The placement marker is repaired: it reads a placement REPORT
# (put/3, on the evidence list) against derived eligibility, and the record
# holds no reports — so it no longer fires on Ruk, whom it used to flag for
# the ordinary condition of a severe offender with a house.
? err(Ruk, Placement).
# => FALSE
? err(Hano, Placement).
# => FALSE
? dwell(Ruk).
# => TRUE
# --- Article 9 ---
? false(Amend_Floor).
# => TRUE
? become(Amend_Floor, Law).
# => FALSE
? become(Amend_Mint, Law).
# => TRUE
? false(Amend_Meta).
# => TRUE
? become(Amend_Meta, Law).
# => FALSE
# --- fidelity table ---
? person(Hano).
# => TRUE
? expresses(Hano).
# => TRUE
? travel(Hano).
# => FALSE
? travel(Adam).
# => FALSE
? eats(Adam).
# => FALSE
? healthy(Bela).
# => FALSE
? secure(Bela).
# => FALSE
? learn(Cira).
# => FALSE
? believe(Bela).
