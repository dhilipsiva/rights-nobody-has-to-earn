# economic-carry-benefit positive current: its exact temporal record is current.
? complete(EconCarryBenefitPositiveRecord, EconomicBenefitCarryCurrent, EconCarryBenefitPositiveTemporalRecord).
# => TRUE
# economic-carry-benefit positive result: the bounded imported projection is current.
? complete(EconCarryBenefitPositiveResult, EconomicBenefitCarryResult, EconCarryBenefitPositiveRecord).
# => TRUE
# economic-carry-benefit cross-kind negative: one carry kind cannot become another.
? complete(EconCarryBenefitPositiveResult, EconomicTitleCarryResult, EconCarryBenefitPositiveRecord).
# => FALSE

