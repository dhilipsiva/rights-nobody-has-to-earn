# economic-carry-title positive current: its exact temporal record is current.
? complete(EconCarryTitlePositiveRecord, EconomicTitleCarryCurrent, EconCarryTitlePositiveTemporalRecord).
# => TRUE
# economic-carry-title positive result: the bounded imported projection is current.
? complete(EconCarryTitlePositiveResult, EconomicTitleCarryResult, EconCarryTitlePositiveRecord).
# => TRUE
# economic-carry-title cross-kind negative: one carry kind cannot become another.
? complete(EconCarryTitlePositiveResult, EconomicLiabilityCarryResult, EconCarryTitlePositiveRecord).
# => FALSE

