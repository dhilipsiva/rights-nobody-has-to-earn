# economic-carry-liability positive current: its exact temporal record is current.
? complete(EconCarryLiabilityPositiveRecord, EconomicLiabilityCarryCurrent, EconCarryLiabilityPositiveTemporalRecord).
# => TRUE
# economic-carry-liability positive result: the bounded imported projection is current.
? complete(EconCarryLiabilityPositiveResult, EconomicLiabilityCarryResult, EconCarryLiabilityPositiveRecord).
# => TRUE
# economic-carry-liability cross-kind negative: one carry kind cannot become another.
? complete(EconCarryLiabilityPositiveResult, EconomicBenefitCarryResult, EconCarryLiabilityPositiveRecord).
# => FALSE

