put(State, PlacementAffected, Homestay).
# The Placement compatibility conclusion remains after reader ablation.
? obliged(Review, PlacementAffected).
# => TRUE

# The Placement typed reader duty disappears under reader ablation.
? obliged(Review, ReadPlacementFindingDuty, ReadPlacementFindingStandard).
# => FALSE

