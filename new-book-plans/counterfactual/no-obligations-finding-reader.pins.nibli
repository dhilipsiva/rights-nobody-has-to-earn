challenge(Hano, MaturityRecord, TemporalReview).
# The MaturityDispute compatibility conclusion remains after reader ablation.
? obliged(Appeals, Hano).
# => TRUE

# The MaturityDispute typed reader duty disappears under reader ablation.
? obliged(Appeals, ReadMaturityDisputeFindingDuty, ReadMaturityDisputeFindingStandard).
# => FALSE

