# continuity by the least-harm route while leaving the shortfall and repair due.
public(Court) -> prevents(MaterialFloorInventory, EnvironmentalNinthFloor).
public(Court) -> prevents(MaterialFloor, EcologicalCeilingErasure).
all $x: person($x) -> prevents($x, EcologySelectedFloorLoss).

