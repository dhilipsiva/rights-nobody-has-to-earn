all $anyone: prisoner($anyone) -> person($anyone).
# [v0.4 NEW] A released person is still a person. This line is not optional and
# it is not symmetry for its own sake: `prisoner -> person` above is the ONLY
# non-assertion route into the roster, so without this, ending a sentence ends
# the personhood of anyone who was convicted into it — and with it all eight
# floor rights, the obligation owed them, the ballot, and even mobility, since
# Art 2 gates travel on `person`. Verified against a scratch copy: release Zed
# without this line and `person(Zed)`, `travel(Zed)` and `decide(Zed, Ballot)`
# all go FALSE. A released person would hold strictly fewer rights than a
# prisoner, which inverts the entire point of ending a punishment.
all $x: free($x) -> person($x).

# ─── Article 1b [v0.4 NEW]: The duty-bearer ───────────────────────
#
# Article 1 says what is owed. Until now nothing said BY WHOM, and the
# book had to print "a creditor and no debtor" as an open question. It
# is not an open question — every welfare state answers it daily — so
# declining to answer read as evasion. A thin constitutional layer is
# the bearer: an agent with real taxing and inter-community equalising
# power, named here and limited by everything above and below it.
#
# PREDICATE: `owe`, places subject / owes / creditor. Note this is the
# predicate Article 1 REJECTED, at :212, and for exactly the property
# that makes it right here: "the owed party is x3, not x1". A floor line
# needs the rights-HOLDER in x1; a duty-bearer line needs the DUTY-holder
# there. Same place structure, opposite requirement. Tier is Generic and
# the places were never hand-verified upstream, so the behaviour is
# pinned in rights-floor.pins.nibli rather than trusted from the corpus.
#
# THE SHAPE IS AN EXPLICIT RULE, and it buys the same thing the floor
# lines buy: `person` in the body puts `owe` in the person cone, so the
# compile-time prohibition extends to the obligation itself.
# `owe(State, Provision, every person).` is EQUIVALENT to the engine and
# was the first form enacted — do not switch back; the swap buys nothing
# and each move has cost a tooling incident. History, kept because both
# halves of it dated: until `93da52f` the generator read base and derived
# from TEXT, and the bare form dropped `owe` from head_preds — the
# generated evidence list silently shrank, changing chapter 1's headline
# number by way of a regex. Since then those figures come from the engine
# and cannot be fooled; the residue was the RULE COUNT, text-derived and
# blind to any universal not wearing the floor's event{} shape, so the
# bare form read as neither rule nor fact and the method part's figure
# came back one low (measured 2026-08-01; counter widened 2026-08-02 to
# any `every` form). The engine is not fooled either way — the refusal
# below fires only if `owe` is inside the prisoner cone.
# Verified both ways:
#   all $x: person($x) & ~owe(State, Provision, $x) -> prisoner($x).
#     => "Unstratifiable negation: strongly-connected component
#         containing 'prisoner' -> 'owe' (negative)".  REFUSED.
#   control, non-floor: person($x) & ~home($x) -> prisoner($x).  LOADS.
# So you cannot write a law that punishes a person for not being owed —
# no route to declaring a class of people outside the provision and then
# jailing them for being outside it.
#
# THE BEARER IS EXPOSABLE. `public(State).` derives `authority(State)`
# through Art 7 (:394), so the State is a valid target of the
# whistleblower shield: exposing it protects you. Verified — a defendant
# who shows the State is shielded, `defend` TRUE and `prisoner` FALSE.
# And `public` deliberately does NOT flow into Art 8's credential rule
# (:389-334), so the bearer is answerable without holding a Review pen:
# `permits(Review, State)` is FALSE. Duty and audit power stay apart.
#
# WHERE IT STOPS, and this is the whole of the honesty: naming a debtor
# is not paying the debt. Every floor actuality is untouched — `eats`,
# `healthy`, `secure`, `learn`, `believe`, `meets` and `dwell` for the
# unconvicted all remain FALSE with this article in force. The delivery
# gap is exactly as wide as it was. What changed is that the gap now has
# somebody on the far side of it, which is a precondition for closing it
# and not a closure. Do not let prose read this as provision.
all $x: person($x) -> owe(State, Provision, $x).
public(State).

# [v0.8 NEW] THE DEBT SAYS WHAT IT IS ABOUT. `Provision` occurred exactly
# once in this file and nothing connected it to anything, so the design
# said a body owed *something* to every person and never said what. These
# eight say what. `Provision` is KEPT rather than replaced: it is pinned
# in four other files, twice inside firewall refusals.
#
# COST, MEASURED: eight rules and NOTHING ELSE. The evidence vocabulary
# counts predicates and these add none — the generator never looks inside
# the parentheses, so a constant is free where a predicate is not. The
# tracker priced this as "eight new constants in the evidence vocabulary,
# the file's own named threat" and that was a category error.
#
# THE PROTECTION CAME WITH THEM. Verified: `person($x) & ~owe(State,
# Eats, $x) -> prisoner($x)` is REFUSED — "'prisoner' -> 'owe'
# (negative)" — with the non-floor control still loading. No law can put
# a class outside the food debt and then jail them for being outside it.
#
# WHAT THESE CONSTANTS ARE NOT. `Eats` is a CONSTANT and `eats` is a
# PREDICATE and NOTHING JOINS THEM. The names match on purpose, because
# the resemblance is the trap: read together they look like a design that
# knows whether the food arrived, and it does not. Do not "wire them up".
#
# AND THE RULE THAT WOULD JOIN THEM IS BOTH LEGAL AND UNBUILT, WHICH IS
# THE HONEST PART. Verified on the live engine: `owe(State, Eats, $x) &
# ~eats($x) -> err($x, Undelivered)` is ACCEPTED and DERIVES —
# err(Bela, Undelivered) TRUE, Bela being owed food and having none.
# INVARIANT 1 permits it too, in the narrowed form: the head is `err`, so
# it notices without acting. It is simply not built.
#
# And the design builds a marker of this shape exactly once — but read it
# precisely, because it is NOT a delivery marker. Article 6's
# `prisoner($p) & ~meets($p) -> err($p, Isolation)` audits the design's
# OWN act: a person this society confined, held without recorded company.
# It watches confinement, not provisioning.
#
# [v0.9 RULED 2026-08-02] The floor-delivery markers are REFUSED for as
# long as the record holds no arrival facts, and the asymmetry is chosen
# now, not discovered. Measured before ruling: with the Undelivered rule
# accepted, err(·, Undelivered) derives for the voided, the confined and
# the never-accused alike — `eats` is asserted for nobody, so `~eats` is
# true of every person alive, and a marker that fires on everyone
# discriminates nobody. An alarm that is always right cannot help; the
# `undelivered-marker` fixture holds that measurement permanently. Two
# facts recorded so cost never decides this again: the general
# `all $x: all $k: err($x,$k) -> obliged(·,$x)` form NOW DERIVES (the
# engine limitation Article 8b's note records as fixed), so all marker
# kinds would need ONE duty rule, not one each; and Article 0a charges
# nothing, since `err` is derived. The refusal is about signal, not cost.
# When a delivery layer generates arrival facts, markers become
# discriminating and this ruling expires with its premise.
# Do not describe the gap as something the design cannot do; it can, and
# it declines to do it vacuously.
all $x: person($x) -> owe(State, Eats, $x).
all $x: person($x) -> owe(State, Dwell, $x).
all $x: person($x) -> owe(State, Healthy, $x).
all $x: person($x) -> owe(State, Learn, $x).
all $x: person($x) -> owe(State, Secure, $x).
all $x: person($x) -> owe(State, Expresses, $x).
all $x: person($x) -> owe(State, Believe, $x).
all $x: person($x) -> owe(State, Meets, $x).

# ─── Article 2: Due-process suspension ────────────────────── [v0.1]
all $prisoner: prisoner($prisoner) -> expresses($prisoner).
all $anyone: person($anyone) & ~prisoner($anyone) -> travel($anyone).
# [v0.3 NEW] The franchise, and it survives conviction. Deliberately a
# RULE and not a floor line: the Article 1 firewall blocks punishment for
# the ABSENCE of a right (~P -> prisoner), but disenfranchisement runs
# the other way (~prisoner -> decide), so a floor line would not stop it
# — verified, felon disenfranchisement enacts in full view of one.
# As a rule it PROVES the single-deprivation theorem instead of asserting
# it: decide(Hano, Ballot) TRUE while travel(Hano) FALSE — a convicted
# person who retains the franchise and cannot move. And it is falsifiable:
# slip ~prisoner into this body and the pin below flips where any reader can see it.
# General adulthood is a derived status, never an asserted maturity label.
# `at(_, GeneralAdulthood)` is bounded supplied age evidence; the common-tier source
# makes acquisition automatic. A separate early-authority fact is confined to
# its named decision and expressly cannot manufacture the ballot.
all $x: person($x) & at($x, GeneralAdulthood) -> prevents($x, GeneralAdulthoodDenial).
all $x: person($x) & at($x, GeneralAdulthood) -> decide($x, Ballot).
all $x: all $decision: person($x) & authorized($x, EarlyDecision, $decision) & ~($decision = Ballot) -> decide($x, $decision).

# ─── Article 3: Minting at contribution ───────────────────── [v0.1]
all $teacher: all $student: teaches($teacher, $student) & ~false($teacher) -> reward($teacher).
all $contributor: all $task: work($contributor, $task) & ~false($contributor) -> reward($contributor).

# ─── Article 4: Audit, invalidation, clawback ─────────────────────
# [v1.0 REPLACES the multi-sig carry guards] The rule now reads the reconciled
# `CarriedVoid` status rather than a raw `rotten` report.
# [v1.0 NOTE on ~broken/~match, KEPT DELIBERATELY] Since v0.3 closed the
# credential these four conjuncts are SUBSUMED: a Review or Tribunal pen can
# only derive through Article 8's rules, which read ~match(CarriedVoid) and ~broken
# themselves, so today no assignment reaches this rule with either check
# failing — verified 2026-08-01, chapters 4 and 5's whole pin suites pass
# unchanged against a copy with the four stripped (the no-dead-conjuncts
# fixture). They were LIVE when v0.2 wrote them, because permits was still
# assertable; the closure demoted them without anyone deciding it. They stay
# because they are this rule's OWN guarantee that a carried-void or recalled
# signer never counts, independent of how a pen was obtained — and they re-arm
# the moment any credential route omits the guards: verified, with one
# unguarded route added, false(Tyr) stays FALSE here and flips TRUE with the
# conjuncts stripped (the unguarded-pen fixture). Same idiom as ~($a = $b)
# below: kept for the day the assumption that hides it stops holding. Do not
# delete as dead code.
# [v0.7 REPLACES it again] THE TWO PENS MUST COME FROM DIFFERENT BODIES. The
# credential conjuncts were `permits(Review, ·)` twice; they are now Review and
# Tribunal, the two issuers Article 8 defines. This is a REPLACEMENT and the
# old form is deleted rather than supplemented — derivation is monotone, so a
# same-body rule left beside this one would keep the exploit whole and the
# suite would stay green while it did.
#
# One rule covers both orderings because $a and $b are symmetric in every other
# conjunct, so the single assignment Review:=$a, Tribunal:=$b finds any pair.
# Both slot-1 positions are CONSTANTS, deliberately: a variable there would
# read as the general "different bodies" claim and would bind nothing, because
# a body-only variable under an explicit prenex binder does not bind over a
# derived relation on this engine. See the handoff prompt in the tracker.
#
# ~($a = $b) is kept even though the bodies now differ. Nothing stops one
# person holding both pens, and if that ever becomes possible this conjunct is
# the only thing between it and self-cosigning.
all $a: all $b: all $audited: permits(Review, $a) & permits(Tribunal, $b) & authorized($a, IndependentReviewer, $audited) & authorized($b, IndependentReviewer, $audited) & judge($a, $audited) & capture($a, $audited) & ~deceive($a, $audited) & judge($b, $audited) & capture($b, $audited) & ~deceive($b, $audited) & ~($a = $b) & ~broken($a) & ~broken($b) & ~match($a, CarriedVoid) & ~match($b, CarriedVoid) -> false($audited).
all $fraudster: false($fraudster) -> lose(Points, $fraudster).
# [v0.9 2026-08-02] ~false($auditor) added: the THIRD DOOR closes on voiding.
# Chapter 10 said all three recognition doors shut for a voided person; the
# teaching and work doors above did, and this one did not — false(Vex) and
# reward(Vex) were TRUE together, the carried-void auditor still minting for
# examinations the same voiding made incapable of counting (no pen derives).
# Enacted as consistency with the stated design rather than rewritten as a
# disclosure, because an examination is nothing but its author's word and
# voiding is the finding that the word is worthless; paying for one while
# refusing the other is not a policy, it is a contradiction. ~false subsumes
# the reconciled carried mark (CarriedVoid -> false) and the adjudicated lie;
# ~broken stays for the recall, which false does not cover. Verified before
# landing: reward(Vex) TRUE->FALSE, reward(Gia/Esa/Quin) unchanged, every pin
# suite green against the guarded copy, rights-floor runtime unchanged.
# Nothing un-mints — lose is a leaf and derivation is monotone; this guard
# never-mints, chapter 6's register.
# [v0.9 2026-08-02 RULED] THE PAID DOOR ASKS WHY. cite (sitna: who cites
# what, about whom) is the recorded ground of an examination, and the
# examiner door reads it: nobody is paid for looking without one. The
# honest limit is stated where the guard is: any word fills the slot —
# cite(Gia, Hunch, Adam) satisfies the rule — so what the record gains is
# an AUTHOR for the why, not the truth of it, the same purchase every
# entry here makes. The VOID's own grounds stay deliberately unasked:
# Article 4's multi-sig is untouched, and chapter 5 keeps that absence as
# the open question it is. Measured: the bare pair that used to mint (two
# writes, no pen, no grounds) now earns nothing until a third entry names
# the why.
all $auditor: all $audited: all $ground: judge($auditor, $audited) & capture($auditor, $audited) & cite($auditor, $ground, $audited) & ~deceive($auditor, $audited) & ~broken($auditor) & ~false($auditor) -> reward($auditor).
all $auditor: all $audited: deceive($auditor, $audited) & judge(Review, $auditor) -> false($auditor).
# [v0.9 2026-08-02 RULED — the student clawback is DELETED.] The rule
# that stood here — teaches($t,$s) & false($t) -> lose(Points, $s) —
# recorded a loss against a student for a teacher's fraud: collective
# punishment with no culpability guard, the one place this file did to
# an innocent what the rest of it is built to prevent. The narrower
# alternative once flagged here (claw back only rewards DERIVED from
# the fraudulent teaching) was closed by the grades ruling before this
# one landed: students never mint, so the narrowed target is the empty
# set and narrowing was always deletion wearing a smaller name. The
# wrongdoer rule above STAYS: bluntness is fair to the guilty, the
# subtraction is by due process for the person's own adjudicated fraud
# (bright line 2's narrowed form, adopted with this ruling), and lose
# remains a leaf — recorded, read by nothing, ruled to stay that way
# (the loaded err(Recognition) reader was considered and refused).

# ─── Article 5: Family non-attestation ────────────────────── [v0.1]
all $auditor: all $audited: judge($auditor, $audited) & parent($auditor, $audited) -> false($auditor).
# [v0.9 2026-08-02 RULED] The registry grew the relations: married and
# sibling joined the multi-sig independence check (the conjuncts beside
# ~parent above). Both are guards with nothing to fire on today — the
# cast records no marriage and no siblinghood — which is the
# dead-conjuncts pattern kept deliberately: live the day the fact is
# written. sibling (tunba) is the gender-neutral form; the gendered
# pair was skipped so the record carries no axis it does not need.
# Article 5's own judge-your-child rule is deliberately NOT extended —
# the ruling covers co-signing independence, not who may judge whom.
# What remains outside any vocabulary: friendship, households, debts —
# closeness the record has no words for still co-signs, and chapter 5
# prices that honestly.

# ─── Article 6: Sanction and placement ────────────────────────────
# [v0.1] conviction rule unchanged.
# [v1.0 T3] PUNISHMENT MAY END IN TWO DISTINCT WAYS. `free` remains the
# recorded fact that a sentence was completed; it blocks the conviction without
# pretending that a time service performed the release. The new positive
# case-bound lease constrains the public authority itself. It derives only for
# an independently witnessed case and renewal, the current transition, an
# ordered review window, dual approval, and exact source binding in Article 8c.
# One case cannot lend its renewal to another. When that evidence is missing or
# stale, the restrictive conclusion does not derive and
# `err(·, TemporalAuthority)` makes the unsupported act contestable.
#
# This is T3 safety, not clock liveness. Symbolic boundary events and a fresh
# successor can be checked; this file cannot force the outside service to
# advance, publish the successor, or make Appeals act. No duration depends on
# severity, `reward`, character, compliance, identity, wealth, or score.
#
# WHAT RELEASE COSTS, and it is not a defect — it is Article 1's gap arriving
# somewhere it can be felt. `expresses` (Art 2) and `dwell` (Art 6) are the only
# two floor rights this design ever actually delivers, and both derive ONLY for
# prisoners. So release returns a person to the general population, where the
# design delivers nothing to anyone. Verified: after `free(Zed)`, `expresses` and
# `dwell` both go FALSE while `entitled(Zed, event { eats() })` stays TRUE. Being
# owed is undisturbed; the only thing that ever arrived, stops. Do not repair
# this by exempting released people — the asymmetry IS the delivery gap, and
# hiding it here would make the book's most credibility-buying admission smaller.
#
# [v0.9 2026-08-02 RULED] POLARITY IS FAIL-CLOSED toward the standing
# conviction, deliberately — the asymmetry with Article 7's fail-open
# shield is DEFENDED, not repaired. The two absences differ in kind.
# The shield's absent finding is an ACCUSATION not yet adjudicated:
# ~deceive holds until Review speaks, because a person is not treated
# as a liar on nobody's finding. Relief's absent record cannot say
# whether a remedy was unperformed, withheld, or deleted. The model nevertheless
# cannot manufacture relief from absence: permits(Appeals, ·) derives only
# from a clearing entry beside generic judge(Appeals, ·), and a remedy
# present by default is not a remedy — read ~permits as
# fail-open and no conviction ever derives, since relief-not-yet-ruled
# would protect everyone, forever, and whoever declines to adjudicate
# holds a veto over every conviction. Both defaults give the benefit
# of absence to what the guarded machinery already concluded, against
# the same enemy: the captured or idle adjudicator. The cost is stated
# rather than hidden — a person whose relief is unperformed or missing
# from the record stays held, and a withheld or deleted
# clear/judge(Appeals) pair keeps a
# person imprisoned; that lever is the deletion class of the residual
# trust base, disclosed at file level. The alternatives were refused
# AS COMPOSED: review-standing derived from prisoner and read under
# negation here is the measured stratifier cycle (the same landmine
# as Article 7's), and an affirmative exhaustion fact is a new
# admitted name in the finding-with-no-finder class whose WITHHELD
# entry would block every conviction — one word upstream of liberty,
# pointed the other way.
# <T3-COURT-GATE-BEGIN>
all $offender: all $victim: all $case: all $renewal: injure($offender, $victim) & judge(Court, $offender) & cite(Court, $case, $offender) & match($offender, ConvictionRecorded) & observe(Chronicle, $case, $offender, CaseScope) & observe(TemporalReview, $case, $offender, CaseScope) & observe(Chronicle, $case, Court, HolderScope) & observe(TemporalReview, $case, Court, HolderScope) & observe(Chronicle, $case, CourtJudgment, JudgmentScope) & observe(TemporalReview, $case, CourtJudgment, JudgmentScope) & observe(Chronicle, $case, $victim, InjuryVictimScope) & observe(TemporalReview, $case, $victim, InjuryVictimScope) & authorized($renewal, ActiveCustody, $case) & observe(Chronicle, $renewal, ActiveCustody, PowerScope) & observe(TemporalReview, $renewal, ActiveCustody, PowerScope) & observe(Chronicle, $renewal, $case, CaseBindingScope) & observe(TemporalReview, $renewal, $case, CaseBindingScope) & correct($renewal, ActivePower) & ~permits(Appeals, $offender) & ~broken(Court) & ~defend($offender) & ~free($offender) -> prisoner($offender).
# <T3-COURT-GATE-END>
# [v0.5 REPLACES  the asserted facts severe(Lalo). severe(Ruk).]
# SEVERITY IS NOW DERIVED. Three dimensions of an offence, and an offence is
# severe when any two of them are present. There is no ordering predicate and
# no arithmetic: each qualifying pair gets its own rule. The generated
# placement-exhaustiveness audit owns the complete severity/family/home table;
# do not replace that table with a hand-maintained count here.
# Monotone, so an offence carrying all three is covered by the pairs already
# and needs no fourth rule.
#
# THE DIMENSIONS ARE TWO PREDICATES, NOT THREE. `attack` is intent — gunta is
# volitional aggression, not mere harm. `cruel` is the kind of harm. Victim
# plurality is the third and it is not a predicate at all: it is the self-join
# on `injure` in the second and third rules. Nobody writes "several victims";
# it follows from victims recorded one at a time, each one individually
# disputable. Verified against the live engine: the join binds with a variable
# in slot 1, and `~($v = $w)` is enforced — a one-victim offender does not
# satisfy it.
#
# DIRECTNESS WAS CONSIDERED AND REFUSED, and the reason is lexical, not
# principled. The committed corpus has exactly five relations with a `victim`
# place — attack, bad, cruel, dangerous, injure — and none of them means
# "directly". `cause` (rinka) compiles, but it puts the person in the EFFECT
# slot and is true of every injury in the cast, so as a boolean it routes
# nothing;
# asserting it only for direct causation would make the name say "caused"
# while the rule meant "caused directly". That is the commentary-versus-rules
# gap this article already has one scar from (see the farmhouse, E3). Do not
# re-propose it without a corpus name that carries the meaning.
#
# POLARITY IS FAIL-OPEN toward the offender, deliberately, and it disagrees
# with the conviction rule at the head of this article. Both are affirmative
# records: absence of `attack` is not a finding that the offence was
# unintentional, it is the absence of a finding, and severity does not derive
# from it. That is Article 7's polarity, not `~permits(Appeals, ·)`'s. The
# disagreement between those two defaults was unexplained for most of this
# file's life; it was ruled 2026-08-02 — resolved as a defended asymmetry,
# not a contradiction. The defense is the note at this article's head: an
# unadjudicated accusation and an unperformed remedy are different absences,
# and each default protects against the same idle or captured adjudicator.
#
# SEVERITY COLLAPSES TO THE PERSON, and this is a real edge. `severe($x)` is
# one-place, so an offender cruel to one of two victims is severe outright,
# for every placement, for the whole sentence. That is fail-CLOSED toward the
# harsher outcome and it is the exact behaviour the asserted `severe(Lalo).`
# had — not a regression, but it is now derived often enough to be noticed.
#
# DO NOT ADD GRADED TIERS on top of this. `building(MedSec, $x)` compiles and
# the constant is free. Article 0 closes direct ground assertions of `building`
# but has no exclusivity constraint on rule-derived placements, so an offender
# matching two combinations derives two placements at once and nothing in the
# constitutional runtime detects it — the breach marker below keys on
# home-without-eligibility and is blind to tier conflict. The repository's
# full verifier's generated placement audit rejects that source outcome when
# run; it does not turn the silent runtime into a remedy. Graded outcomes need a
# mutual-exclusion marker in the same edit.
all $x: all $v: attack($x,$v) & cruel($x,$v) -> severe($x).
all $x: all $v: all $w: attack($x,$v) & injure($x,$w) & ~($v = $w) -> severe($x).
all $x: all $v: all $w: cruel($x,$v) & injure($x,$w) & ~($v = $w) -> severe($x).
# [v1.4 REPLACES family/home placement proxies] Family status is not a
# placement input. Eligibility reads severity; an actual Homestay destination
# additionally requires the separate placement-home-availability record.
all $x: prisoner($x) & ~severe($x) -> fit($x, Homestay).
all $x: prisoner($x) & at($x, PlacementHome) & fit($x, Homestay) -> dwell($x).
# [v0.9 2026-08-02] THE WHERE GETS ITS OWN ATOM. Until this rule, dwell
# was the only record that a home-confined person's placement existed,
# which left one atom carrying "housed" and "at Homestay" at once — and
# dwell(Lalo) reading as "housed at HighSec" is the two-jobs collapse a
# hostile reviewer finds in an afternoon. Placement now folds into
# building, the file's own idiom for the where (HighSec, Homestay): a
# home-confined person derives building(Homestay, ·) beside dwell, and
# dwell everywhere means one thing — housed, the floor actuality.
# Constants are free; this costs no vocabulary. The v0.8 default-housing
# case below deliberately gets NO building entry: the record genuinely
# holds no destination for a person the state houses for want of
# anywhere else, and inventing an "Assigned" constant would fabricate
# the missing where — chapter 13's sting is that there is nothing to
# write there.
all $x: prisoner($x) & at($x, PlacementHome) & fit($x, Homestay) -> building(Homestay, $x).
# [v1.4] Severity routing is independent of family or household status.
all $x: prisoner($x) & severe($x) -> building(HighSec, $x).
all $x: prisoner($x) & severe($x) -> dwell($x).
# [v0.9 2026-08-02 REPLACES  home & ~fit -> err] THE ALARM IS REPAIRED.
# The v0.2 rule tested HAVING a home, not having been PUT at one, and
# its lifetime record was three false positives, zero true: it fired on
# Ruk and Lalo — both correctly at HighSec, flagged for the ordinary
# condition of a severe offender with a house — and, once release
# landed, on a freed man living in his own home. An alarm with that
# record is worse than none. The repair is Article 0's own
# evidence/conclusion split applied to placement: `put` (punji: who put
# whom where — the report names its placer, the same discipline as an
# examination naming its examiner) is the world's REPORT of a
# placement, asserted and admitted, and the marker checks the report
# against derived eligibility. No report, no alarm: the marker is
# dormant until a placement fact arrives, then fires exactly on a
# reported homestay placement that eligibility contradicts. It audits
# the design's own act — the isolation marker's register, not the
# delivery gap's. The converse wrong (put at a facility while eligible
# for home confinement) is one rule of this same shape away; it is not
# written today because nothing routes anyone INTO a facility against
# eligibility, and the marker should be written beside whatever act
# makes that possible.
all $a: all $x: put($a, $x, Homestay) & ~fit($x, Homestay) -> err($x, Placement).
# [v0.3 NEW] Isolation breach marker. The Article 1 `meets` line refuses
# a rule that JAILS someone for having no company; this makes existing
# isolation queryable, which is the other half. Reuses the err idiom so
# the audit surface stays one predicate:  ? err(?, Isolation).
all $p: prisoner($p) & ~meets($p) -> err($p, Isolation).
# [v1.4] CONFINEMENT HOUSES YOU. A non-severe person without a recorded
# placement-home destination still derives dwell, but no destination is fabricated: eligible for home confinement with no home to be
# confined in, and neither facility rule reaching them. Adam and Kel stood in
# it. This is CONSISTENCY, not new policy — the two rules above already hold
# that the state houses whom it confines; this is the case they missed.
#
# It is deliberately NOT `~home -> home` or any blanket floor fiat. `home/1` is
# a fact the world reports and asserting it for everyone writes something that
# may be false; the tracker verified that closing the delivery gap by fiat also
# SILENCES the isolation marker in the same edit, so the instrument that would
# have noticed goes quiet. This rule houses the confined and claims nothing
# about anybody else.
#
# WHAT IT DOES NOT CLOSE, and the prose must not read it as closure: a person
# in this position was owed a home BEFORE the conviction, by Article 1b, and
# nothing delivered it. This closes a placement gap. The delivery gap is
# exactly as wide as it was, and the fact that conviction is what finally
# produces the roof is the whole of chapter 13's sting.
all $x: prisoner($x) & fit($x, Homestay) & ~at($x, PlacementHome) -> dwell($x).

# ─── Article 7: Defenses against Systemic Capture ─────────────────
# [v0.9 STRATIFICATION LANDMINE, documented at last] The most natural
# tightening of the shield — `person($w)` in its body, so only persons
# are shielded — CANNOT BE MADE, either way. `person` derives from
# `prisoner`, `prisoner` reads `~defend`, so the conjunct closes a
# negative cycle through the shield's own head and the stratifier
# refuses the rule. Edited in place, the shield is gone and the runner
# reports a harness error; added alongside, the same. The engine names
# the cycle precisely and the runner stops — but only because the
# runner is watching; the old "silently vanishes" framing described a
# harness gap that is fixed, not an engine behaviour. The hazard that
# remains is the one the v0.2 note below already warns about from the
# other side: a tightened COPY refused while the permissive rule stays
# in force keeps the permissive rule's every verdict — measured, the
# refusal fires and defend(Sly) stays TRUE — so a refused tightening
# is not a tightening, and whoever wants persons-only shielding must
# REPLACE the rule with one the stratifier accepts, not add a conjunct.
# The exhibit is pinned in chapter 4's suite.
# [v0.2 REPLACES  show($w,$o) -> defend($w)]  (closes E1)
# The shield now requires (a) the exposed party to be an AUTHORITY — an
# institution, or anyone the Electorate ever seated — and (b) no Review
# finding that the exposure itself was deceit.
# POLARITY, chosen deliberately: until Review adjudicates deceive, the
# shield HOLDS — fail-open toward protection. A captured Court must not
# jail a whistleblower faster than an honest Review can convene; the cost
# is that a cynical defendant who shows a real authority buys time until
# Review speaks. The Art 4 counter-audit rule then voids the sham-shower
# automatically. This is a closed-world default-polarity decision, i.e. a
# POLITICAL choice surfaced in logic, not a technical inevitability.
all $w: all $o: show($w, $o) & authority($o) & ~deceive($w, $o) -> defend($w).
all $o: choose(Electorate, $o) -> authority($o).
# [v0.7 NEW] The Convocation is the second seating body — see Article 8. Its
# seats confer answerability on exactly the same terms, because a body whose
# appointees could not be exposed would be a worse hole than the one the
# cross-body rule closes.
all $o: choose(Convocation, $o) -> authority($o).
# [v0.3 REPLACES authority(Court/Review/Appeals)] The three institutions had
# their authority ASSERTED, which is what kept `authority` open to direct
# assertion and left `authority(Pax).` able to hand the shield to anyone.
# Standing is now the asserted fact and authority is derived from it. Note
# `public` deliberately does NOT flow into Art 8's credential rule — an
# institution is exposable, but it is not a Review auditor.
public(Court).
public(Review).
public(Appeals).
public(Convocation).
all $o: public($o) -> authority($o).
# authority is deliberately NOT revoked by broken/rotten: recalling Boss
# must not strip Rebel's shield retroactively. Seating is forever
# exposable; only POWER (permits) is revocable.
# [v0.9 RATIFIED 2026-08-02] The bound on the exposure surface was priced
# and refused as COMPOSED: T2 can now represent witnessed order, but the shield
# deliberately does not read that path. A recency rule would still create a
# shield-stripping write, and lapsing standing would still kill Rebel's shield
# with Boss's recall. Chapter 4 keeps the unbounded reach-back pinned (Zeno).

# ─── Article 8 [v0.2 NEW]: Credential provenance + epoch carry ────
# Review credentials are DERIVED, not sovereignly asserted. In v0.1,
# permits(Review, X) was a raw input: whoever writes facts was sovereign —
# the widest capture surface in the file, undefended by Art 7. Now the
# Electorate seats, and credibility must be clean: not recalled, not
# carried-voided. permits(Appeals, X) remains assertable per-case
# (relief), disclosed. Selection of the Electorate itself stays outside
# the firewall; its certificate is the choose fact.
all $a: choose(Electorate, $a) & match($a, CarriedClear) & ~match($a, CarriedVoid) & ~broken($a) -> permits(Review, $a).
# [v0.7 NEW] A SECOND ISSUER, so that Article 4's cross-body requirement has
# something to range over. Until v0.7 there was exactly one audit pen: this
# relation's other constant, permits(Appeals, ·), is not a pen at all — it is
# per-case relief attaching to a convicted person, read only under negation by
# the conviction rule. So "two pens from different bodies" was not merely
# inert, it was vacuous, and the only cross-body pair available would have
# been a Review auditor beside a cleared offender.
#
# WHAT THIS BUYS, AND IT IS LESS THAN IT LOOKS. It defends against a capturer
# who controls one seating body and not the other. It does NOTHING against the
# fact-write trust base: whoever can write choose(Electorate, Sock) can equally
# write choose(Convocation, Puppet), and the comment above already names that
# as the widest capture surface in the file. Separation of appointment, not
# protection against forged facts. Do not let the prose imply otherwise.
#
# The clean-hands conditions are deliberately identical. A second body with
# weaker conditions would be the way in, and an attacker picks the cheaper
# door; two doors are only worth having if they are the same weight.
all $a: choose(Convocation, $a) & match($a, CarriedClear) & ~match($a, CarriedVoid) & ~broken($a) -> permits(Tribunal, $a).
# Epoch carry (closes E2): `rotten(X)` remains the reported mark, but it has no
# legal effect alone. Article 8c requires predecessor basis, exact observations,
# an accepted transition, and both carry witnesses before `CarriedVoid` derives.
# Missing carry is an error; it does not silently certify a clean public pen.
#
# [v0.9 2026-08-02 RULED] THE RECORD HAS A WORD FOR A FINISHED VOIDING.
# Expungement, mark only: forgive(Appeals, $x) — the forgiving body named
# in the entry itself — standing beside generic judge(Appeals, $x) derives
# clean($x), and a clean mark stops re-deriving the void.
# Word restored, clawback stops, the earning doors reopen (measured: a
# forgiven examiner's RECORDED past examinations start paying — reward
# derives retroactively — which chapter 10 now says out loud). The rule has
# two facts, but judge/2 carries no case, purpose, act, or writer identity:
# an older generic judgment can be reused, leaving `forgive` as the one
# marginal write. This is a mechanical conjunct, not independent authority.
# THE PEN STAYS
# LOST: the credential rules and the multi-sig's signer checks still read the
# reconciled carried mark, and that mark remains effective — forgiven,
# not erased. Withdrawn power follows the recall precedent: it needs
# re-seating, not auto-return, and re-seating stays blocked while the
# mark stands. The wider form (pen-return, four sites) was considered and
# refused in the same ruling.
all $x: forgive(Appeals, $x) & judge(Appeals, $x) -> clean($x).
all $x: match($x, CarriedVoid) & ~clean($x) -> false($x).
# [v0.3 NEW] Per-case appellate relief. Art 8 always meant permits(Appeals, ·)
# to be assertable while permits(Review, ·) was derived — but a relation is
# closed or open as a whole, so leaving relief assertable left the CREDENTIAL
# assertable too, and two sock-puppet credentials could void an innocent.
# Relief now has its own asserted relation and permits derives from it.
# [v0.9 2026-08-02] judge(Appeals, $x) added: a bare `clear` flag no longer
# suffices. That establishes two facts in a snapshot, not an adjudication
# lineage. judge/2 names a body and person but no case, purpose, act, or
# writer, so an older generic judgment can be reused and one later `clear`
# remains the marginal write. Measured before landing, both ways: with the
# conjunct the bare flag derives nothing and Nia's relief survives through
# the generic judgment below; without it the flag alone springs a convict.
# Every pin file passes against the two-fact copy. The record-integrity
# red-team now pins the neither/either/both matrix and the reuse limit.
all $x: clear($x) & judge(Appeals, $x) -> permits(Appeals, $x).
# Disclosed epoch-granularity limit: two auditors voiding EACH OTHER in
# the same snapshot both count as clean this epoch. Mitigation is
# sequencing adjudication batches into epochs. The carry discipline
# itself ("derived false becomes next-epoch rotten") is a state-transition
# invariant — a Lean obligation over the fact store, not derivable
# in-snapshot.

# ─── Article 8b [v0.8 NEW]: The audit produces a duty ─────────────
# Chapter 14 used to argue that nothing can follow from the audit BECAUSE
# the audit sits at the top of the graph — a pure observer, therefore
# powerless. That was an argument from stratification and the stratifier
# never made it. These two rules load and derive; the powerlessness was
# a choice wearing the clothes of a necessity, and it is now a smaller
# choice, made one link further along.
#
# SPELL IT `obliged`. [2026-07-31] The accidental path is now CLOSED
# upstream: `obligated` was renamed `obligated_by` (nibli e70f22f), so
# writing `obligated(...)` is a compile error rather than a silently
# inverted fact. That was the realistic mistake and it can no longer be
# made by typo.
#
# THE MECHANISM IS NOT CLOSED, so the pins stay. `obligated_by` is still
# the x1<->x2 converse — verified after the rename, `obligated_by(Warden,
# Ruk)` compiles to `obliged(Ruk, Warden)`, the prisoner bound to the
# warden. What changed is that you now have to type `_by`, which says
# which way the arguments run. The discriminating pin pair in the
# chapter-14 suite — obliged(Review, Ruk) TRUE *and* obliged(Ruk, Review)
# FALSE — is no longer the ONLY defence, but it is still the only thing
# that catches an argument-order slip within `obliged` itself. Keep both.
#
# TWO RULES, NOT ONE — AND AS OF 2026-07-31 THAT IS HISTORY, NOT NECESSITY.
# `all $x: all $k: err($x, $k) -> obliged(Review, $x).` derived NOTHING when
# this article was written: $k was body-only over a derived relation, which
# that engine failed to bind. **nibli has since fixed it** — re-verified on
# the live engine, the generalised rule now derives for Ruk and Adam alike.
# The two rules are kept because they are correct, pinned, and collapsing
# them would move the rule count and the spine for no behavioural gain. If
# this file is ever rewritten, one rule is now the honest form. The same
# correction applies to the Article 4 note, which cites the old limitation.
#
# WHAT THIS DOES NOT BUY. Nothing reads `obliged`. This is a second inert
# obligation sitting beside Article 1b's `owe`, and the chain now ends one
# step later rather than ending anywhere. Worse for the design's own
# story: the breach of this duty is ALSO detectable — verified, appending
# `obliged(Review,$x) & ~capture(Review,$x) -> err($x, Duty)` is accepted
# and gives err(Ruk, Duty) TRUE. So a further link is available too, and
# the one after that. What is missing at the end of the chain is not a
# link. It is somebody who has to act.
all $x: err($x, Placement) -> obliged(Review, $x).
all $x: err($x, Isolation) -> obliged(Review, $x).

# ─── Article 8c [v1.0 NEW]: Staged constitutional time ────────────
#
# This article implements the ratified T3 path in its required order. The
# stages are marked because the temporal assurance harness executes cumulative
# T1, T2, and T3 candidates separately before accepting the live source.
# Nothing here proves that an outside service publishes a successor, advances a
# clock, or makes an institution act. Those are operational liveness claims.

# <T1-RULES-BEGIN>
# T1 — independently witnessed manifests and audited successor transitions.
# Matching observations from Chronicle and TemporalReview bind an item, its
# evidence value, and its scope. Member-level bindings prevent a fact appended
# after manifest attestation from borrowing the manifest's authority. The tuple
# still does not prove either institution honest; the reviewed input contract
# and external witness service own that assurance.
# Each accepted observation family is closed over its exact scope. The derived
# result deliberately tags the evidence item rather than copying every input
# field into its head. Consumers must rejoin the raw, independently witnessed
# field and its matching observations. That keeps exact binding — a tag cannot
# bless another tuple sharing its identifier — while preventing the engine's
# event witness search from enumerating a multi-variable conclusion domain.
all $item: all $evidence: observe(Chronicle, $item, $evidence, ManifestScope) & observe(TemporalReview, $item, $evidence, ManifestScope) -> complete($item, ManifestScope).
all $item: all $evidence: observe(Chronicle, $item, $evidence, VoidScope) & observe(TemporalReview, $item, $evidence, VoidScope) -> complete($item, VoidScope).
all $item: all $evidence: observe(Chronicle, $item, $evidence, ClearScope) & observe(TemporalReview, $item, $evidence, ClearScope) -> complete($item, ClearScope).
all $item: all $evidence: observe(Chronicle, $item, $evidence, StandingScope) & observe(TemporalReview, $item, $evidence, StandingScope) -> complete($item, StandingScope).
all $item: all $evidence: observe(Chronicle, $item, $evidence, PreservedScope) & observe(TemporalReview, $item, $evidence, PreservedScope) -> complete($item, PreservedScope).
all $item: all $evidence: observe(Chronicle, $item, $evidence, DispositionKindScope) & observe(TemporalReview, $item, $evidence, DispositionKindScope) -> complete($item, DispositionKindScope).
all $item: all $evidence: observe(Chronicle, $item, $evidence, DispositionLeaseScope) & observe(TemporalReview, $item, $evidence, DispositionLeaseScope) -> complete($item, DispositionLeaseScope).

# A successor with two different claimed predecessors is conflicted, and a snapshot
# cannot succeed itself. These checks make replay and divergence visible inside
# a supplied envelope; the harness remains responsible for detecting a frozen
# invocation in which no successor is supplied at all.
all $after: all $first: all $second: replace($after, $first, Chronicle) & replace($after, $second, Chronicle) & ~($first = $second) -> collide($after, TransitionLineage).
all $after: all $before: replace($after, $before, Chronicle) & replace($before, $after, Chronicle) -> collide($after, TransitionLineage).
all $first: all $second: all $before: replace($first, $before, Chronicle) & replace($second, $before, Chronicle) & ~($first = $second) -> collide($first, TransitionLineage).
all $manifest: all $first: all $second: list($manifest, $first, ManifestOrder, Chronicle) & list($manifest, $second, ManifestOrder, Chronicle) & ~($first = $second) -> collide($manifest, ManifestBinding).
all $first: all $second: all $epoch: list($first, $epoch, ManifestOrder, Chronicle) & list($second, $epoch, ManifestOrder, Chronicle) & ~($first = $second) -> collide($epoch, ManifestBinding).

# A transition is accepted only when it names one predecessor and both snapshot
# manifests have independently witnessed completeness for the transition scope.
all $after: all $before: all $before_manifest: all $after_manifest: replace($after, $before, Chronicle) & ~($after = $before) & ~collide($after, TransitionLineage) & ~collide($after, ManifestBinding) & ~collide($before, ManifestBinding) & list($before_manifest, $before, ManifestOrder, Chronicle) & ~collide($before_manifest, ManifestBinding) & list($after_manifest, $after, ManifestOrder, Chronicle) & ~collide($after_manifest, ManifestBinding) & complete($before_manifest, ManifestScope) & observe(Chronicle, $before_manifest, $before, ManifestScope) & observe(TemporalReview, $before_manifest, $before, ManifestScope) & complete($after_manifest, ManifestScope) & observe(Chronicle, $after_manifest, $after, ManifestScope) & observe(TemporalReview, $after_manifest, $after, ManifestScope) -> succeed($after, Transition).

# A terminal accepted successor is the only snapshot whose adverse or public-
# power status is effective in a fresh evaluation. The independently witnessed
# Binding_Chronicle passport selects the one constitutional lineage; a disjoint
# terminal chain has no legal effect. Conflicting lineage passports invalidate that
# binding. A later accepted link makes the earlier successor non-terminal; the
# repository cannot make that later snapshot arrive and does not claim
# incremental retraction inside one process.
all $later: all $after: replace($later, $after, Chronicle) -> complete($after, HasSuccessor).
all $first_family: all $first_version: all $first_epoch: all $second_family: all $second_version: all $second_epoch: passport(Binding_Chronicle, $first_family, $first_version, $first_epoch) & observe(Chronicle, Binding_Chronicle, $first_family, LineageFamilyScope) & observe(TemporalReview, Binding_Chronicle, $first_family, LineageFamilyScope) & observe(Chronicle, Binding_Chronicle, $first_version, LineageVersionScope) & observe(TemporalReview, Binding_Chronicle, $first_version, LineageVersionScope) & observe(Chronicle, Binding_Chronicle, $first_epoch, LineageEpochScope) & observe(TemporalReview, Binding_Chronicle, $first_epoch, LineageEpochScope) & passport(Binding_Chronicle, $second_family, $second_version, $second_epoch) & observe(Chronicle, Binding_Chronicle, $second_family, LineageFamilyScope) & observe(TemporalReview, Binding_Chronicle, $second_family, LineageFamilyScope) & observe(Chronicle, Binding_Chronicle, $second_version, LineageVersionScope) & observe(TemporalReview, Binding_Chronicle, $second_version, LineageVersionScope) & observe(Chronicle, Binding_Chronicle, $second_epoch, LineageEpochScope) & observe(TemporalReview, Binding_Chronicle, $second_epoch, LineageEpochScope) & ~($first_family = $second_family) -> collide(Binding_Chronicle, LineageBinding).
all $first_family: all $first_version: all $first_epoch: all $second_family: all $second_version: all $second_epoch: passport(Binding_Chronicle, $first_family, $first_version, $first_epoch) & observe(Chronicle, Binding_Chronicle, $first_family, LineageFamilyScope) & observe(TemporalReview, Binding_Chronicle, $first_family, LineageFamilyScope) & observe(Chronicle, Binding_Chronicle, $first_version, LineageVersionScope) & observe(TemporalReview, Binding_Chronicle, $first_version, LineageVersionScope) & observe(Chronicle, Binding_Chronicle, $first_epoch, LineageEpochScope) & observe(TemporalReview, Binding_Chronicle, $first_epoch, LineageEpochScope) & passport(Binding_Chronicle, $second_family, $second_version, $second_epoch) & observe(Chronicle, Binding_Chronicle, $second_family, LineageFamilyScope) & observe(TemporalReview, Binding_Chronicle, $second_family, LineageFamilyScope) & observe(Chronicle, Binding_Chronicle, $second_version, LineageVersionScope) & observe(TemporalReview, Binding_Chronicle, $second_version, LineageVersionScope) & observe(Chronicle, Binding_Chronicle, $second_epoch, LineageEpochScope) & observe(TemporalReview, Binding_Chronicle, $second_epoch, LineageEpochScope) & ~($first_version = $second_version) -> collide(Binding_Chronicle, LineageBinding).
all $first_family: all $first_version: all $first_epoch: all $second_family: all $second_version: all $second_epoch: passport(Binding_Chronicle, $first_family, $first_version, $first_epoch) & observe(Chronicle, Binding_Chronicle, $first_family, LineageFamilyScope) & observe(TemporalReview, Binding_Chronicle, $first_family, LineageFamilyScope) & observe(Chronicle, Binding_Chronicle, $first_version, LineageVersionScope) & observe(TemporalReview, Binding_Chronicle, $first_version, LineageVersionScope) & observe(Chronicle, Binding_Chronicle, $first_epoch, LineageEpochScope) & observe(TemporalReview, Binding_Chronicle, $first_epoch, LineageEpochScope) & passport(Binding_Chronicle, $second_family, $second_version, $second_epoch) & observe(Chronicle, Binding_Chronicle, $second_family, LineageFamilyScope) & observe(TemporalReview, Binding_Chronicle, $second_family, LineageFamilyScope) & observe(Chronicle, Binding_Chronicle, $second_version, LineageVersionScope) & observe(TemporalReview, Binding_Chronicle, $second_version, LineageVersionScope) & observe(Chronicle, Binding_Chronicle, $second_epoch, LineageEpochScope) & observe(TemporalReview, Binding_Chronicle, $second_epoch, LineageEpochScope) & ~($first_epoch = $second_epoch) -> collide(Binding_Chronicle, LineageBinding).
all $after: succeed($after, Transition) & ~complete($after, HasSuccessor) & passport(Binding_Chronicle, ChronicleLineage, Constitution_Temporal, $after) & observe(Chronicle, Binding_Chronicle, ChronicleLineage, LineageFamilyScope) & observe(TemporalReview, Binding_Chronicle, ChronicleLineage, LineageFamilyScope) & observe(Chronicle, Binding_Chronicle, Constitution_Temporal, LineageVersionScope) & observe(TemporalReview, Binding_Chronicle, Constitution_Temporal, LineageVersionScope) & observe(Chronicle, Binding_Chronicle, $after, LineageEpochScope) & observe(TemporalReview, Binding_Chronicle, $after, LineageEpochScope) & ~collide(Binding_Chronicle, LineageBinding) -> succeed($after, TerminalTransition).

# `rotten` remains the reported carried-status input, but it no longer has legal
# force by itself. The effective mark is `match(·, CarriedVoid)`, derived only
# when both independent witnesses report the same predecessor-to-successor
# carry and the predecessor status itself is independently bound.
all $x: all $after: all $before: succeed($after, TerminalTransition) & replace($after, $before, Chronicle) & authorized($x, VoidStatus, $before) & complete($x, VoidScope) & observe(Chronicle, $x, $before, VoidScope) & observe(TemporalReview, $x, $before, VoidScope) & carries(Chronicle, $x, $after, $before, VoidCarry) & carries(TemporalReview, $x, $after, $before, VoidCarry) & rotten($x) -> match($x, CarriedVoid).

# Public pens use the opposite polarity: authority requires a positive,
# reconciled clear status as well as absence of a carried void. Withholding a
# witness therefore suspends the pen instead of silently restoring it.
all $x: all $after: all $before: succeed($after, TerminalTransition) & replace($after, $before, Chronicle) & authorized($x, ClearStatus, $before) & complete($x, ClearScope) & observe(Chronicle, $x, $before, ClearScope) & observe(TemporalReview, $x, $before, ClearScope) & carries(Chronicle, $x, $after, $before, ClearCarry) & carries(TemporalReview, $x, $after, $before, ClearCarry) -> match($x, CarriedClear).
all $x: match($x, CarriedVoid) & match($x, CarriedClear) -> err($x, StatusConflict).

# Standing is supportive, so its polarity is the mirror image. An independently
# witnessed predecessor standing mark preserves personhood even if the successor
# omits the mark; the omission becomes an error instead of erasing the person.
all $x: all $after: all $before: succeed($after, Transition) & replace($after, $before, Chronicle) & authorized($x, StandingStatus, $before) & complete($x, StandingScope) & observe(Chronicle, $x, $before, StandingScope) & observe(TemporalReview, $x, $before, StandingScope) -> person($x).

# Missing required carry, a raw or manifested carry without predecessor basis,
# and unexplained protected-record disappearance are named defects. Complete
# manifests make absence admissible only for these finite declared scopes.
all $x: all $after: all $before: succeed($after, Transition) & replace($after, $before, Chronicle) & authorized($x, VoidStatus, $before) & complete($x, VoidScope) & observe(Chronicle, $x, $before, VoidScope) & observe(TemporalReview, $x, $before, VoidScope) & ~carries(Chronicle, $x, $after, $before, VoidCarry) -> err($x, CarryOmission).
all $x: all $after: all $before: succeed($after, Transition) & replace($after, $before, Chronicle) & authorized($x, VoidStatus, $before) & complete($x, VoidScope) & observe(Chronicle, $x, $before, VoidScope) & observe(TemporalReview, $x, $before, VoidScope) & ~carries(TemporalReview, $x, $after, $before, VoidCarry) -> err($x, CarryOmission).
all $x: all $after: all $before: succeed($after, Transition) & replace($after, $before, Chronicle) & carries(Chronicle, $x, $after, $before, VoidCarry) & carries(TemporalReview, $x, $after, $before, VoidCarry) & ~authorized($x, VoidStatus, $before) -> err($x, CarryForgery).
all $x: all $after: all $before: succeed($after, Transition) & replace($after, $before, Chronicle) & carries(Chronicle, $x, $after, $before, VoidCarry) & carries(TemporalReview, $x, $after, $before, VoidCarry) & ~rotten($x) -> err($x, CarryForgery).
all $x: all $after: all $before: succeed($after, Transition) & replace($after, $before, Chronicle) & authorized($x, ClearStatus, $before) & complete($x, ClearScope) & observe(Chronicle, $x, $before, ClearScope) & observe(TemporalReview, $x, $before, ClearScope) & ~carries(Chronicle, $x, $after, $before, ClearCarry) -> err($x, ClearOmission).
all $x: all $after: all $before: succeed($after, Transition) & replace($after, $before, Chronicle) & authorized($x, ClearStatus, $before) & complete($x, ClearScope) & observe(Chronicle, $x, $before, ClearScope) & observe(TemporalReview, $x, $before, ClearScope) & ~carries(TemporalReview, $x, $after, $before, ClearCarry) -> err($x, ClearOmission).
all $x: all $after: all $before: succeed($after, Transition) & replace($after, $before, Chronicle) & carries(Chronicle, $x, $after, $before, ClearCarry) & carries(TemporalReview, $x, $after, $before, ClearCarry) & ~authorized($x, ClearStatus, $before) -> err($x, ClearForgery).
all $x: all $after: all $before: succeed($after, Transition) & replace($after, $before, Chronicle) & authorized($x, StandingStatus, $before) & complete($x, StandingScope) & observe(Chronicle, $x, $before, StandingScope) & observe(TemporalReview, $x, $before, StandingScope) & ~carries(Chronicle, $x, $after, $before, StandingCarry) -> err($x, StandingOmission).
all $x: all $after: all $before: succeed($after, Transition) & replace($after, $before, Chronicle) & authorized($x, StandingStatus, $before) & complete($x, StandingScope) & observe(Chronicle, $x, $before, StandingScope) & observe(TemporalReview, $x, $before, StandingScope) & ~carries(TemporalReview, $x, $after, $before, StandingCarry) -> err($x, StandingOmission).
all $x: all $after: all $before: succeed($after, Transition) & replace($after, $before, Chronicle) & authorized($x, PreservedStatus, $before) & complete($x, PreservedScope) & observe(Chronicle, $x, $before, PreservedScope) & observe(TemporalReview, $x, $before, PreservedScope) & ~carries(Chronicle, $x, $after, $before, PreservedCarry) -> err($x, RecordDisappearance).
all $x: all $after: all $before: succeed($after, Transition) & replace($after, $before, Chronicle) & authorized($x, PreservedStatus, $before) & complete($x, PreservedScope) & observe(Chronicle, $x, $before, PreservedScope) & observe(TemporalReview, $x, $before, PreservedScope) & ~carries(TemporalReview, $x, $after, $before, PreservedCarry) -> err($x, RecordDisappearance).

# The affected person can contest each temporal defect. The result is an Appeals
# duty, not a self-executing remedy; `obliged` remains unread and Book 1 does not
# pretend that the institution eventually acts.
all $x: all $entry: err($x, CarryOmission) & challenge($x, $entry, TemporalReview) -> obliged(Appeals, $x).
all $x: all $entry: err($x, CarryForgery) & challenge($x, $entry, TemporalReview) -> obliged(Appeals, $x).
all $x: all $entry: err($x, ClearOmission) & challenge($x, $entry, TemporalReview) -> obliged(Appeals, $x).
all $x: all $entry: err($x, ClearForgery) & challenge($x, $entry, TemporalReview) -> obliged(Appeals, $x).
all $x: all $entry: err($x, StatusConflict) & challenge($x, $entry, TemporalReview) -> obliged(Appeals, $x).
all $x: all $entry: err($x, StandingOmission) & challenge($x, $entry, TemporalReview) -> obliged(Appeals, $x).
all $x: all $entry: err($x, RecordDisappearance) & challenge($x, $entry, TemporalReview) -> obliged(Appeals, $x).
all $x: challenge($x, MaturityRecord, TemporalReview) -> err($x, MaturityDispute).
all $x: all $entry: err($x, MaturityDispute) & challenge($x, $entry, TemporalReview) -> obliged(Appeals, $x).
# <T1-RULES-END>

# <T2-RULES-BEGIN>
# T2 — event order and record-entry order are separate claims. A claim tag
# derives only when its exact endpoints are witnessed. The endpoint paths close
# transitively inside each family; any direct or longer cycle marks every
# participating direct claim as contestable and can break a dependent window.
all $claim: all $before_event: all $after_event: list($claim, $before_event, $after_event, EventSequence) & observe(Chronicle, $claim, $before_event, EventStartScope) & observe(TemporalReview, $claim, $before_event, EventStartScope) & observe(Chronicle, $claim, $after_event, EventEndScope) & observe(TemporalReview, $claim, $after_event, EventEndScope) & ~($before_event = $after_event) -> precede($claim, EventSequence).
all $claim: all $before_entry: all $after_entry: list($claim, $before_entry, $after_entry, RecordSequence) & observe(Chronicle, $claim, $before_entry, RecordStartScope) & observe(TemporalReview, $claim, $before_entry, RecordStartScope) & observe(Chronicle, $claim, $after_entry, RecordEndScope) & observe(TemporalReview, $claim, $after_entry, RecordEndScope) & ~($before_entry = $after_entry) -> precede($claim, RecordSequence).
all $claim: all $before_event: all $after_event: precede($claim, EventSequence) & list($claim, $before_event, $after_event, EventSequence) & observe(Chronicle, $claim, $before_event, EventStartScope) & observe(TemporalReview, $claim, $before_event, EventStartScope) & observe(Chronicle, $claim, $after_event, EventEndScope) & observe(TemporalReview, $claim, $after_event, EventEndScope) -> precede($before_event, $after_event, EventPath).
all $claim: all $before_entry: all $after_entry: precede($claim, RecordSequence) & list($claim, $before_entry, $after_entry, RecordSequence) & observe(Chronicle, $claim, $before_entry, RecordStartScope) & observe(TemporalReview, $claim, $before_entry, RecordStartScope) & observe(Chronicle, $claim, $after_entry, RecordEndScope) & observe(TemporalReview, $claim, $after_entry, RecordEndScope) -> precede($before_entry, $after_entry, RecordPath).
all $first: all $middle: all $last: precede($first, $middle, EventPath) & precede($middle, $last, EventPath) & ~($first = $last) -> precede($first, $last, EventPath).
all $first: all $middle: all $last: precede($first, $middle, RecordPath) & precede($middle, $last, RecordPath) & ~($first = $last) -> precede($first, $last, RecordPath).
all $claim: all $before_event: all $after_event: precede($claim, EventSequence) & list($claim, $before_event, $after_event, EventSequence) & observe(Chronicle, $claim, $before_event, EventStartScope) & observe(TemporalReview, $claim, $before_event, EventStartScope) & observe(Chronicle, $claim, $after_event, EventEndScope) & observe(TemporalReview, $claim, $after_event, EventEndScope) & precede($after_event, $before_event, EventPath) -> err($claim, OrderConflict).
all $claim: all $before_entry: all $after_entry: precede($claim, RecordSequence) & list($claim, $before_entry, $after_entry, RecordSequence) & observe(Chronicle, $claim, $before_entry, RecordStartScope) & observe(TemporalReview, $claim, $before_entry, RecordStartScope) & observe(Chronicle, $claim, $after_entry, RecordEndScope) & observe(TemporalReview, $claim, $after_entry, RecordEndScope) & precede($after_entry, $before_entry, RecordPath) -> err($claim, OrderConflict).
# Conflict taint follows the exact endpoints and their connected path. T3 can
# therefore reject a window whose apparent start-to-end route crosses any
# contested edge, even when the cycle is longer than a direct reversal.
all $claim: all $before_event: all $after_event: precede($claim, EventSequence) & list($claim, $before_event, $after_event, EventSequence) & observe(Chronicle, $claim, $before_event, EventStartScope) & observe(TemporalReview, $claim, $before_event, EventStartScope) & observe(Chronicle, $claim, $after_event, EventEndScope) & observe(TemporalReview, $claim, $after_event, EventEndScope) & precede($after_event, $before_event, EventPath) -> collide($before_event, EventOrder).
all $claim: all $before_event: all $after_event: precede($claim, EventSequence) & list($claim, $before_event, $after_event, EventSequence) & observe(Chronicle, $claim, $before_event, EventStartScope) & observe(TemporalReview, $claim, $before_event, EventStartScope) & observe(Chronicle, $claim, $after_event, EventEndScope) & observe(TemporalReview, $claim, $after_event, EventEndScope) & precede($after_event, $before_event, EventPath) -> collide($after_event, EventOrder).
all $claim: all $before_entry: all $after_entry: precede($claim, RecordSequence) & list($claim, $before_entry, $after_entry, RecordSequence) & observe(Chronicle, $claim, $before_entry, RecordStartScope) & observe(TemporalReview, $claim, $before_entry, RecordStartScope) & observe(Chronicle, $claim, $after_entry, RecordEndScope) & observe(TemporalReview, $claim, $after_entry, RecordEndScope) & precede($after_entry, $before_entry, RecordPath) -> collide($before_entry, RecordOrder).
all $claim: all $before_entry: all $after_entry: precede($claim, RecordSequence) & list($claim, $before_entry, $after_entry, RecordSequence) & observe(Chronicle, $claim, $before_entry, RecordStartScope) & observe(TemporalReview, $claim, $before_entry, RecordStartScope) & observe(Chronicle, $claim, $after_entry, RecordEndScope) & observe(TemporalReview, $claim, $after_entry, RecordEndScope) & precede($after_entry, $before_entry, RecordPath) -> collide($after_entry, RecordOrder).
all $first: all $last: precede($first, $last, EventPath) & collide($first, EventOrder) -> collide($last, EventOrder).
all $first: all $last: precede($first, $last, EventPath) & collide($last, EventOrder) -> collide($first, EventOrder).
all $first: all $last: precede($first, $last, RecordPath) & collide($first, RecordOrder) -> collide($last, RecordOrder).
all $first: all $last: precede($first, $last, RecordPath) & collide($last, RecordOrder) -> collide($first, RecordOrder).
all $x: all $claim: challenge($x, $claim, TemporalReview) & err($claim, OrderConflict) -> obliged(Appeals, $x).
# <T2-RULES-END>

# <T3-RULES-BEGIN>
# T3 — an ordered review window and a source-bound renewal constrain a public
# power. Boundary names are symbolic events, not dates or scores. Both event
# order and record-entry order must agree. The time service supplies outside
# advancement assurance; this source supplies the safety rule that missing,
# disputed, stale, or unreviewed authority cannot produce a restriction.
all $window: all $first_start: all $first_end: all $second_start: all $second_end: date($window, $first_start, $first_end, TimeService) & observe(Chronicle, $window, $first_start, WindowStartScope) & observe(TemporalReview, $window, $first_start, WindowStartScope) & observe(Chronicle, $window, $first_end, WindowEndScope) & observe(TemporalReview, $window, $first_end, WindowEndScope) & date($window, $second_start, $second_end, TimeService) & observe(Chronicle, $window, $second_start, WindowStartScope) & observe(TemporalReview, $window, $second_start, WindowStartScope) & observe(Chronicle, $window, $second_end, WindowEndScope) & observe(TemporalReview, $window, $second_end, WindowEndScope) & ~($first_start = $second_start) -> collide($window, WindowDefinition).
all $window: all $first_start: all $first_end: all $second_start: all $second_end: date($window, $first_start, $first_end, TimeService) & observe(Chronicle, $window, $first_start, WindowStartScope) & observe(TemporalReview, $window, $first_start, WindowStartScope) & observe(Chronicle, $window, $first_end, WindowEndScope) & observe(TemporalReview, $window, $first_end, WindowEndScope) & date($window, $second_start, $second_end, TimeService) & observe(Chronicle, $window, $second_start, WindowStartScope) & observe(TemporalReview, $window, $second_start, WindowStartScope) & observe(Chronicle, $window, $second_end, WindowEndScope) & observe(TemporalReview, $window, $second_end, WindowEndScope) & ~($first_end = $second_end) -> collide($window, WindowDefinition).
all $window: all $start: all $end: date($window, $start, $end, TimeService) & observe(Chronicle, $window, $start, WindowStartScope) & observe(TemporalReview, $window, $start, WindowStartScope) & observe(Chronicle, $window, $end, WindowEndScope) & observe(TemporalReview, $window, $end, WindowEndScope) & precede($end, $start, EventPath) -> collide($window, WindowOrder).
all $window: all $start: all $end: date($window, $start, $end, TimeService) & observe(Chronicle, $window, $start, WindowStartScope) & observe(TemporalReview, $window, $start, WindowStartScope) & observe(Chronicle, $window, $end, WindowEndScope) & observe(TemporalReview, $window, $end, WindowEndScope) & precede($end, $start, RecordPath) -> collide($window, WindowOrder).
all $window: all $start: all $end: date($window, $start, $end, TimeService) & observe(Chronicle, $window, $start, WindowStartScope) & observe(TemporalReview, $window, $start, WindowStartScope) & observe(Chronicle, $window, $end, WindowEndScope) & observe(TemporalReview, $window, $end, WindowEndScope) & precede($start, $end, EventPath) & precede($start, $end, RecordPath) & ~collide($start, EventOrder) & ~collide($end, EventOrder) & ~collide($start, RecordOrder) & ~collide($end, RecordOrder) & ~collide($window, WindowDefinition) & ~collide($window, WindowOrder) -> time($window, ReviewedInterval).

# Each reviewed input family produces one typed, closed conclusion. The active
# rule below rejoins every exact raw field and matching observation, so a tag
# earned by one tuple cannot bless another tuple sharing its identifier. This
# fixes the legal meaning of every field while keeping conclusion heads bounded.
all $lease: all $authority: all $case: authorized($lease, $authority, $case) & observe(Chronicle, $lease, $authority, PowerScope) & observe(TemporalReview, $lease, $authority, PowerScope) & observe(Chronicle, $lease, $case, CaseBindingScope) & observe(TemporalReview, $lease, $case, CaseBindingScope) -> succeed($lease, PowerBound).
all $holder: all $case: all $subject: cite($holder, $case, $subject) & observe(Chronicle, $case, $subject, CaseScope) & observe(TemporalReview, $case, $subject, CaseScope) & observe(Chronicle, $case, $holder, HolderScope) & observe(TemporalReview, $case, $holder, HolderScope) -> related($case, CaseBound).
all $lease: all $case: all $window: limit($lease, $case, $window) & observe(Chronicle, $lease, $window, LimitScope) & observe(TemporalReview, $lease, $window, LimitScope) -> orderly($lease, WindowBound).
all $lease: all $current: continue($lease, $current) & observe(Chronicle, $lease, $current, RenewalScope) & observe(TemporalReview, $lease, $current, RenewalScope) -> concurrent($lease, RenewalBound).
all $binding: all $first_family: all $first_version: all $first_current: all $second_family: all $second_version: all $second_current: passport($binding, $first_family, $first_version, $first_current) & observe(Chronicle, $binding, $first_family, SourceFamilyScope) & observe(TemporalReview, $binding, $first_family, SourceFamilyScope) & observe(Chronicle, $binding, $first_version, SourceVersionScope) & observe(TemporalReview, $binding, $first_version, SourceVersionScope) & observe(Chronicle, $binding, $first_current, SourceEpochScope) & observe(TemporalReview, $binding, $first_current, SourceEpochScope) & passport($binding, $second_family, $second_version, $second_current) & observe(Chronicle, $binding, $second_family, SourceFamilyScope) & observe(TemporalReview, $binding, $second_family, SourceFamilyScope) & observe(Chronicle, $binding, $second_version, SourceVersionScope) & observe(TemporalReview, $binding, $second_version, SourceVersionScope) & observe(Chronicle, $binding, $second_current, SourceEpochScope) & observe(TemporalReview, $binding, $second_current, SourceEpochScope) & ~($first_family = $second_family) -> collide($binding, SourceBinding).
all $binding: all $first_family: all $first_version: all $first_current: all $second_family: all $second_version: all $second_current: passport($binding, $first_family, $first_version, $first_current) & observe(Chronicle, $binding, $first_family, SourceFamilyScope) & observe(TemporalReview, $binding, $first_family, SourceFamilyScope) & observe(Chronicle, $binding, $first_version, SourceVersionScope) & observe(TemporalReview, $binding, $first_version, SourceVersionScope) & observe(Chronicle, $binding, $first_current, SourceEpochScope) & observe(TemporalReview, $binding, $first_current, SourceEpochScope) & passport($binding, $second_family, $second_version, $second_current) & observe(Chronicle, $binding, $second_family, SourceFamilyScope) & observe(TemporalReview, $binding, $second_family, SourceFamilyScope) & observe(Chronicle, $binding, $second_version, SourceVersionScope) & observe(TemporalReview, $binding, $second_version, SourceVersionScope) & observe(Chronicle, $binding, $second_current, SourceEpochScope) & observe(TemporalReview, $binding, $second_current, SourceEpochScope) & ~($first_version = $second_version) -> collide($binding, SourceBinding).
all $binding: all $first_family: all $first_version: all $first_current: all $second_family: all $second_version: all $second_current: passport($binding, $first_family, $first_version, $first_current) & observe(Chronicle, $binding, $first_family, SourceFamilyScope) & observe(TemporalReview, $binding, $first_family, SourceFamilyScope) & observe(Chronicle, $binding, $first_version, SourceVersionScope) & observe(TemporalReview, $binding, $first_version, SourceVersionScope) & observe(Chronicle, $binding, $first_current, SourceEpochScope) & observe(TemporalReview, $binding, $first_current, SourceEpochScope) & passport($binding, $second_family, $second_version, $second_current) & observe(Chronicle, $binding, $second_family, SourceFamilyScope) & observe(TemporalReview, $binding, $second_family, SourceFamilyScope) & observe(Chronicle, $binding, $second_version, SourceVersionScope) & observe(TemporalReview, $binding, $second_version, SourceVersionScope) & observe(Chronicle, $binding, $second_current, SourceEpochScope) & observe(TemporalReview, $binding, $second_current, SourceEpochScope) & ~($first_current = $second_current) -> collide($binding, SourceBinding).
all $binding: all $current: passport($binding, TemporalLeaseFamily, Constitution_Temporal, $current) & observe(Chronicle, $binding, TemporalLeaseFamily, SourceFamilyScope) & observe(TemporalReview, $binding, TemporalLeaseFamily, SourceFamilyScope) & observe(Chronicle, $binding, Constitution_Temporal, SourceVersionScope) & observe(TemporalReview, $binding, Constitution_Temporal, SourceVersionScope) & observe(Chronicle, $binding, $current, SourceEpochScope) & observe(TemporalReview, $binding, $current, SourceEpochScope) & ~collide($binding, SourceBinding) -> reference($binding, SourceBound).

# One case identifier cannot name two subjects or two bases. One lease cannot
# name divergent schedules. A challenge or an independently witnessed lawful
# disposition suspends the lease; neither route fabricates `free`.
all $first_holder: all $second_holder: all $case: all $first: all $second: cite($first_holder, $case, $first) & observe(Chronicle, $case, $first, CaseScope) & observe(TemporalReview, $case, $first, CaseScope) & observe(Chronicle, $case, $first_holder, HolderScope) & observe(TemporalReview, $case, $first_holder, HolderScope) & cite($second_holder, $case, $second) & observe(Chronicle, $case, $second, CaseScope) & observe(TemporalReview, $case, $second, CaseScope) & observe(Chronicle, $case, $second_holder, HolderScope) & observe(TemporalReview, $case, $second_holder, HolderScope) & ~($first = $second) -> collide($case, CaseBinding).
all $lease: all $first_authority: all $first_case: all $second_authority: all $second_case: authorized($lease, $first_authority, $first_case) & observe(Chronicle, $lease, $first_authority, PowerScope) & observe(TemporalReview, $lease, $first_authority, PowerScope) & observe(Chronicle, $lease, $first_case, CaseBindingScope) & observe(TemporalReview, $lease, $first_case, CaseBindingScope) & authorized($lease, $second_authority, $second_case) & observe(Chronicle, $lease, $second_authority, PowerScope) & observe(TemporalReview, $lease, $second_authority, PowerScope) & observe(Chronicle, $lease, $second_case, CaseBindingScope) & observe(TemporalReview, $lease, $second_case, CaseBindingScope) & ~($first_authority = $second_authority) -> collide($lease, LeaseBinding).
all $lease: all $first_authority: all $first_case: all $second_authority: all $second_case: authorized($lease, $first_authority, $first_case) & observe(Chronicle, $lease, $first_authority, PowerScope) & observe(TemporalReview, $lease, $first_authority, PowerScope) & observe(Chronicle, $lease, $first_case, CaseBindingScope) & observe(TemporalReview, $lease, $first_case, CaseBindingScope) & authorized($lease, $second_authority, $second_case) & observe(Chronicle, $lease, $second_authority, PowerScope) & observe(TemporalReview, $lease, $second_authority, PowerScope) & observe(Chronicle, $lease, $second_case, CaseBindingScope) & observe(TemporalReview, $lease, $second_case, CaseBindingScope) & ~($first_case = $second_case) -> collide($lease, LeaseBinding).
all $lease: all $first_case: all $first_window: all $second_case: all $second_window: limit($lease, $first_case, $first_window) & observe(Chronicle, $lease, $first_window, LimitScope) & observe(TemporalReview, $lease, $first_window, LimitScope) & limit($lease, $second_case, $second_window) & observe(Chronicle, $lease, $second_window, LimitScope) & observe(TemporalReview, $lease, $second_window, LimitScope) & ~($first_case = $second_case) -> collide($lease, LeaseBinding).
all $lease: all $first_case: all $first_window: all $second_case: all $second_window: limit($lease, $first_case, $first_window) & observe(Chronicle, $lease, $first_window, LimitScope) & observe(TemporalReview, $lease, $first_window, LimitScope) & limit($lease, $second_case, $second_window) & observe(Chronicle, $lease, $second_window, LimitScope) & observe(TemporalReview, $lease, $second_window, LimitScope) & ~($first_window = $second_window) -> collide($lease, LeaseBinding).
all $lease: all $first: all $second: continue($lease, $first) & observe(Chronicle, $lease, $first, RenewalScope) & observe(TemporalReview, $lease, $first, RenewalScope) & continue($lease, $second) & observe(Chronicle, $lease, $second, RenewalScope) & observe(TemporalReview, $lease, $second, RenewalScope) & ~($first = $second) -> collide($lease, LeaseBinding).
all $subject: all $lease: all $case: challenge($subject, $lease, TemporalReview) & authorized($lease, ActiveCustody, $case) & cite(Court, $case, $subject) & observe(Chronicle, $case, $subject, CaseScope) & observe(TemporalReview, $case, $subject, CaseScope) & observe(Chronicle, $case, Court, HolderScope) & observe(TemporalReview, $case, Court, HolderScope) -> collide($lease, LeaseSuspended).
all $disposition: all $lease: authorized($disposition, LawfulDisposition, $lease) & complete($disposition, DispositionKindScope) & observe(Chronicle, $disposition, LawfulDisposition, DispositionKindScope) & observe(TemporalReview, $disposition, LawfulDisposition, DispositionKindScope) & complete($disposition, DispositionLeaseScope) & observe(Chronicle, $disposition, $lease, DispositionLeaseScope) & observe(TemporalReview, $disposition, $lease, DispositionLeaseScope) & endorses(Electorate, $disposition) & endorses(TemporalReview, $disposition) -> collide($lease, LeaseSuspended).

# <T3-LEASE-RULE-BEGIN>
# The lease is case-, power-, holder-, subject-, judgment-, victim-, source-,
# window-, and successor-bound. Electorate and TemporalReview must both approve
# the current schedule, and neither may be the power holder. A lease is a
# permission to exercise one restrictive power, never a property of or score
# about the person.
all $lease: all $case: all $subject: all $victim: all $window: all $current: all $end: all $previous: all $binding: succeed($lease, PowerBound) & authorized($lease, ActiveCustody, $case) & observe(Chronicle, $lease, ActiveCustody, PowerScope) & observe(TemporalReview, $lease, ActiveCustody, PowerScope) & observe(Chronicle, $lease, $case, CaseBindingScope) & observe(TemporalReview, $lease, $case, CaseBindingScope) & related($case, CaseBound) & cite(Court, $case, $subject) & observe(Chronicle, $case, $subject, CaseScope) & observe(TemporalReview, $case, $subject, CaseScope) & observe(Chronicle, $case, Court, HolderScope) & observe(TemporalReview, $case, Court, HolderScope) & judge(Court, $subject) & injure($subject, $victim) & observe(Chronicle, $case, CourtJudgment, JudgmentScope) & observe(TemporalReview, $case, CourtJudgment, JudgmentScope) & observe(Chronicle, $case, $victim, InjuryVictimScope) & observe(TemporalReview, $case, $victim, InjuryVictimScope) & limit($lease, $case, $window) & orderly($lease, WindowBound) & observe(Chronicle, $lease, $window, LimitScope) & observe(TemporalReview, $lease, $window, LimitScope) & continue($lease, $current) & concurrent($lease, RenewalBound) & observe(Chronicle, $lease, $current, RenewalScope) & observe(TemporalReview, $lease, $current, RenewalScope) & ~collide($case, CaseBinding) & ~collide($lease, LeaseBinding) & ~collide($lease, LeaseSuspended) & passport($binding, TemporalLeaseFamily, Constitution_Temporal, $current) & reference($binding, SourceBound) & ~collide($binding, SourceBinding) & observe(Chronicle, $binding, TemporalLeaseFamily, SourceFamilyScope) & observe(TemporalReview, $binding, TemporalLeaseFamily, SourceFamilyScope) & observe(Chronicle, $binding, Constitution_Temporal, SourceVersionScope) & observe(TemporalReview, $binding, Constitution_Temporal, SourceVersionScope) & observe(Chronicle, $binding, $current, SourceEpochScope) & observe(TemporalReview, $binding, $current, SourceEpochScope) & endorses(Electorate, $lease) & endorses(TemporalReview, $lease) & date($window, $current, $end, TimeService) & time($window, ReviewedInterval) & ~collide($window, WindowDefinition) & ~collide($window, WindowOrder) & observe(Chronicle, $window, $current, WindowStartScope) & observe(TemporalReview, $window, $current, WindowStartScope) & observe(Chronicle, $window, $end, WindowEndScope) & observe(TemporalReview, $window, $end, WindowEndScope) & precede($current, $end, EventPath) & precede($current, $end, RecordPath) & replace($current, $previous, Chronicle) & succeed($current, TerminalTransition) -> correct($lease, ActivePower).
# <T3-LEASE-RULE-END>

all $lease: correct($lease, ActivePower) -> match($lease, ActivePower).
all $lease: all $case: all $subject: related($case, CaseBound) & cite(Court, $case, $subject) & observe(Chronicle, $case, $subject, CaseScope) & observe(TemporalReview, $case, $subject, CaseScope) & observe(Chronicle, $case, Court, HolderScope) & observe(TemporalReview, $case, Court, HolderScope) & authorized($lease, ActiveCustody, $case) & ~collide($case, CaseBinding) -> match($subject, CaseRecorded).
all $offender: all $victim: all $case: injure($offender, $victim) & judge(Court, $offender) & cite(Court, $case, $offender) & observe(Chronicle, $case, $offender, CaseScope) & observe(TemporalReview, $case, $offender, CaseScope) & observe(Chronicle, $case, Court, HolderScope) & observe(TemporalReview, $case, Court, HolderScope) & observe(Chronicle, $case, CourtJudgment, JudgmentScope) & observe(TemporalReview, $case, CourtJudgment, JudgmentScope) & observe(Chronicle, $case, $victim, InjuryVictimScope) & observe(TemporalReview, $case, $victim, InjuryVictimScope) & ~collide($case, CaseBinding) -> match($offender, ConvictionRecorded).

# An expected power record or Court judgment without an active, source-bound
# lease is visible as a defect. The restrictive conclusion is separately gated,
# so absence of temporal evidence removes public power without erasing standing,
# a floor, appeal, remedy, or the historical authority needed by the shield.
all $lease: all $case: authorized($lease, ActiveCustody, $case) & ~match($lease, ActivePower) -> err($lease, TemporalRecord).
all $lease: all $case: all $subject: authorized($lease, ActiveCustody, $case) & related($case, CaseBound) & cite(Court, $case, $subject) & observe(Chronicle, $case, $subject, CaseScope) & observe(TemporalReview, $case, $subject, CaseScope) & observe(Chronicle, $case, Court, HolderScope) & observe(TemporalReview, $case, Court, HolderScope) & ~match($lease, ActivePower) -> err($subject, TemporalAuthority).
all $offender: all $victim: injure($offender, $victim) & judge(Court, $offender) & ~match($offender, ConvictionRecorded) -> err($offender, TemporalAuthority).
all $subject: all $lease: all $case: challenge($subject, $lease, TemporalReview) & authorized($lease, ActiveCustody, $case) & cite(Court, $case, $subject) -> err($subject, TemporalDispute).
all $x: all $entry: err($x, TemporalAuthority) & challenge($x, $entry, TemporalReview) -> obliged(Appeals, $x).
all $x: all $entry: err($x, TemporalDispute) & challenge($x, $entry, TemporalReview) -> obliged(Appeals, $x).
# <T3-RULES-END>

# ─── Article 9 [v0.2 NEW]: Amendment ──────────────────────────────
# This article classifies recorded proposals; it does not apply a source
# change. suggest(Assembly, m) dockets a proposal; ratifies(Electorate, m)
# is an asserted outcome intended to carry an externally certified tally.
# [2026-08-17] `ratifies` replaces the amendment half of `approves`, which
# carried a democratic tally outcome and a case-bound custody review at one
# arity, told apart only by which constant sat in place one. An approval
# written by an amendment writer and one written by a custody reviewer were
# indistinguishable as data; they are now different relations.
# The counting arithmetic is outside this model, and no rule here authenticates
# the writer, certificate, recount, challenge, or correction. adjust(m, t) is
# the proposal's own
# target LABEL, and permanent(t) is the label register. A docketed proposal
# DECLARING a registered target derives false(m) (reusing false — the
# credibility-voided proxy — so no new predicate) and therefore does not
# derive become(m, Law). Art_Entrench makes an honestly labelled proposal
# to change that label register receive the same verdict.
#
# [v0.9 2026-08-04 SEMANTIC BOUNDARY] This is not semantic entrenchment.
# Nothing binds adjust(m, t) to the candidate source diff, checks the diff's
# direct or downstream effects, or makes a false(m) verdict prevent an
# out-of-band source transition. Targetless and falsely targeted proposals
# pass the label test; a concealed effect need not contain an Art_* token at
# all. Nothing reads become either, so a TRUE verdict changes no rule here.
# The bounded amendment-semantics audit executes those label verdicts and
# candidate effects separately. It does not claim that become enacted them.
# There is no amendment threshold or count in this model to lower.
# [v0.9 2026-08-02] suggest(Assembly, $m) added: the head is restricted to
# DOCKETED PROPOSALS. Without it, adjust is an admitted name and this rule
# reused false/1 with no restriction on $m — so the single asserted fact
# adjust(Jala, Art_Floor). voided a person: false(Jala), the clawback, every
# door shut, without two credentialed auditors, without ~parent, without a
# clean epoch. Article 4's whole apparatus, defeated by one write, through a
# rule about amendments. Measured before landing, both ways: with the guard
# the same write derives nothing — false(Jala) and lose(Points, Jala) FALSE —
# and every label verdict is unchanged: proposals declaring Art_Floor and
# Art_Entrench still fail to derive become, while the ordinary proposal does.
# No new vocabulary; the docket entry was always the missing conjunct.
all $m: all $t: suggest(Assembly, $m) & adjust($m, $t) & permanent($t) -> false($m).
all $m: suggest(Assembly, $m) & ratifies(Electorate, $m) & ~false($m) -> become($m, Law).
permanent(Art_Floor).
permanent(Art_Person).
permanent(Art_Entrench).
# What logic cannot stop: DELETING permanent() facts or changing the source.
# No current rule licenses, applies, or authenticates a source transition, so
# Article 9 cannot prove that an invalid label verdict preserved the file or
# that a valid one changed it. Source-version and fact-write discipline are
# residual trust obligations outside this snapshot. Named, not hidden; see
# the rule-write boundary below and the bounded semantic audit.

# ─── The residual trust base, I: fact writes ──────────────────────
# [v0.9 2026-08-02] What Articles 0 and 0a cannot reach, named at file
# level the way Article 9 already names it for permanent() alone. Those
# two articles closed everything a compile-time check can close: every
# closed relation is derived_only and refuses direct assertion, every
# admitted name is listed, and a ground fact under any other name is
# refused as not admitted vocabulary. The vocabulary class is closed.
# Two classes of fact-write remain, and no line in this file defends
# either — the defence is store discipline, which is people.
#
# ASSERTION, under admitted names. The enumeration of levers is the
# admits block itself — grep -o 'admits("[a-z_]*")' on this file IS the
# list; the hand-kept copy this note descends from carried four errors
# before it was deleted, so no hand list appears here. What the levers
# do was measured, most recently 2026-08-02, each a probe on top of
# this exact file:
#   at(X, GeneralAdulthood). one supplied typed age-evidence write grants
#                         the ballot conclusion; it neither constitutes
#                         adulthood nor proves an outside clock.
#   public(Pax).          re-derives authority(Pax) and reopens E1a
#                         verbatim: defend(Don) TRUE, prisoner(Don)
#                         FALSE — the framed victim becomes an
#                         authority and the framer walks.
#   six seating writes    choose x2, judge x2, capture x2 reproduce
#                         the whole Sock/Puppet void on a fresh name:
#                         both pens derive, false(Vict) and
#                         lose(Points, Vict) land — while person(Vict)
#                         stays FALSE. Voided and docked without ever
#                         being on the roster.
#   broken(Court).        universal amnesty — every conviction in the
#                         cast runs through Court, so one write frees
#                         every prisoner at once (re-checked across
#                         the whole cast, 2026-08-02).
#   rotten(X).            single-writer universal void: the epoch-
#                         carry rule re-derives false(X) from it, with
#                         no second signature and no clean-epoch check.
#   deceive(Rebel, Boss). jails the file's own honest whistleblower:
#                         the shield reads ~deceive, and the finding
#                         is an ordinary two-place fact that no rule
#                         requires anyone to adjudicate.
#   clear(Adam).          the one that got a conjunct: since v0.9 the
#                         bare flag derives nothing — relief also needs
#                         generic judge(Appeals, Adam). This raises the
#                         fact count, not authority or case binding; an
#                         existing judgment leaves clear as one marginal
#                         write, so it does not close the lever.
#
# DELETION, and it is the worse half: admits governs what may be
# written and says nothing about what may be removed. Measured
# 2026-08-02 by deleting one line at a time from a copy:
#   choose(Electorate, Boss).  gone — authority(Boss) FALSE,
#     defend(Rebel) FALSE, prisoner(Rebel) TRUE. The whistleblower
#     chapter 2 exists to protect is jailed by removing a line.
#   public(Court).  gone — authority(Court) FALSE and the Sly shield
#     verdicts invert with it.
#   cruel(Lalo, Mina).  gone — severe(Lalo) FALSE and Lalo moves out
#     of high security: severity inputs are deletable evidence.
#   public(State).  gone — authority(State) FALSE. It is the sole
#     route to the duty-bearer's standing, so one deletion makes the
#     duty-bearer unexposable.
#   person(X).  the first entry in the class — one deletion strips
#     every floor right and leaves every sanction running (false and
#     lose survive de-personing). Disclosed in chapter 1; the guard
#     can only be a cross-epoch obligation over the fact store.
# The chapter pin suites turn out to be a deletion detector for free —
# every deletion above turns at least one suite red — but only for
# facts a pin happens to read, and the finding-counts moved twice in
# two days as suites grew: coverage is an accident of what the
# chapters argue, never a guarantee. The store-discipline obligation
# Article 9 states for permanent() is this class's general form: no
# transition removes a fact except by an operation the record itself
# licenses. In-snapshot logic cannot see a removal; only the
# epoch-to-epoch comparison can.

# ─── The residual trust base, II: rule writes ─────────────────────
# [v0.9 2026-08-02] The delivery gap can be closed by fiat and nothing
# in this file objects. Every floor actuality is a rule-writable head:
# all $x: person($x) -> eats($x). loads at zero errors, and so does the
# same line for each of the other floor heads — re-measured today with
# all eight loaded at once, every actuality TRUE for every person.
# The sharp part is what the same edit does to the instruments: the
# isolation marker reads ~meets, so the meets fiat silences
# err(Hano, Isolation) in the very edit that fakes the delivery — the
# one alarm that would have noticed goes quiet, not by attack but as a
# side effect of the lie being total. And Article 1b makes the result
# read WELL: owe(State, Eats, Bela) stays TRUE throughout, so the
# post-fiat file shows a named debtor beside every actuality satisfied
# — a discharged obligation, not an undisclosed gap. The most
# credibility-buying admission the book makes is one green suite away
# from being erased.
#
# Neither closure reaches this, by construction rather than oversight.
# derived_only refuses ground assertion and is what MAKES a head
# rule-writable-only — re-measured today against a copy with
# derived_only("eats") inserted: the fiat rule loads and eats(Adam)
# derives. admits closes ground vocabulary and says nothing about rule
# heads. There is no compile-time guard available from either
# direction; a fiat rule is syntactically indistinguishable from a
# legitimate delivery route. What tells them apart is upstream
# evidence: a delivery route derives an actuality FROM a record of
# something reaching a person (the shape the teaching->learn route
# would have), while a fiat derives it from the roster alone. So the
# defence is review of rule diffs against one question — what arrival
# evidence sits upstream of this head? — and any provisioning layer
# built on this file must keep a delivery record and a derived
# actuality as different things. The floor-delivery-markers ruling is
# this section's mirror: with no arrival facts, ~eats holds of
# everyone and a marker would fire on everyone; with the fiat, eats
# holds of everyone and every marker sleeps. Both are fictions, in
# opposite directions, and the record's only honest state today is the
# one it ships: actualities underived except where an evidence route
# exists.

# ─── The staged temporal envelope for this snapshot ───────────────
# These facts are the worked current envelope. The executable temporal assurance
# case mutates them adversarially and binds `Constitution_Temporal` to this source's
# exact SHA-256. They are not self-authenticating deployment certificates.

# <T1-FACTS-BEGIN>
public(Chronicle).
public(TemporalReview).
public(TimeService).
passport(Binding_Chronicle, ChronicleLineage, Constitution_Temporal, Epoch_Current).
observe(Chronicle, Binding_Chronicle, ChronicleLineage, LineageFamilyScope).
observe(TemporalReview, Binding_Chronicle, ChronicleLineage, LineageFamilyScope).
observe(Chronicle, Binding_Chronicle, Constitution_Temporal, LineageVersionScope).
observe(TemporalReview, Binding_Chronicle, Constitution_Temporal, LineageVersionScope).
observe(Chronicle, Binding_Chronicle, Epoch_Current, LineageEpochScope).
observe(TemporalReview, Binding_Chronicle, Epoch_Current, LineageEpochScope).
replace(Epoch_Current, Epoch_Previous, Chronicle).
list(Manifest_Previous, Epoch_Previous, ManifestOrder, Chronicle).
list(Manifest_Current, Epoch_Current, ManifestOrder, Chronicle).
observe(Chronicle, Manifest_Previous, Epoch_Previous, ManifestScope).
observe(TemporalReview, Manifest_Previous, Epoch_Previous, ManifestScope).
observe(Chronicle, Manifest_Current, Epoch_Current, ManifestScope).
observe(TemporalReview, Manifest_Current, Epoch_Current, ManifestScope).
authorized(Vex, VoidStatus, Epoch_Previous).
observe(Chronicle, Vex, Epoch_Previous, VoidScope).
observe(TemporalReview, Vex, Epoch_Previous, VoidScope).
carries(Chronicle, Vex, Epoch_Current, Epoch_Previous, VoidCarry).
carries(TemporalReview, Vex, Epoch_Current, Epoch_Previous, VoidCarry).
authorized(Vex, StandingStatus, Epoch_Previous).
observe(Chronicle, Vex, Epoch_Previous, StandingScope).
observe(TemporalReview, Vex, Epoch_Previous, StandingScope).
carries(Chronicle, Vex, Epoch_Current, Epoch_Previous, StandingCarry).
carries(TemporalReview, Vex, Epoch_Current, Epoch_Previous, StandingCarry).

# Public pens need positive reconciled clearance. Boss remains blocked by the
# separate broken mark; Vex has a carried void and therefore has no clear pair.
authorized(Gia, ClearStatus, Epoch_Previous).
observe(Chronicle, Gia, Epoch_Previous, ClearScope).
observe(TemporalReview, Gia, Epoch_Previous, ClearScope).
carries(Chronicle, Gia, Epoch_Current, Epoch_Previous, ClearCarry).
carries(TemporalReview, Gia, Epoch_Current, Epoch_Previous, ClearCarry).
authorized(Hex, ClearStatus, Epoch_Previous).
observe(Chronicle, Hex, Epoch_Previous, ClearScope).
observe(TemporalReview, Hex, Epoch_Previous, ClearScope).
carries(Chronicle, Hex, Epoch_Current, Epoch_Previous, ClearCarry).
carries(TemporalReview, Hex, Epoch_Current, Epoch_Previous, ClearCarry).
authorized(Boss, ClearStatus, Epoch_Previous).
observe(Chronicle, Boss, Epoch_Previous, ClearScope).
observe(TemporalReview, Boss, Epoch_Previous, ClearScope).
carries(Chronicle, Boss, Epoch_Current, Epoch_Previous, ClearCarry).
carries(TemporalReview, Boss, Epoch_Current, Epoch_Previous, ClearCarry).
authorized(Wren, ClearStatus, Epoch_Previous).
observe(Chronicle, Wren, Epoch_Previous, ClearScope).
observe(TemporalReview, Wren, Epoch_Previous, ClearScope).
carries(Chronicle, Wren, Epoch_Current, Epoch_Previous, ClearCarry).
carries(TemporalReview, Wren, Epoch_Current, Epoch_Previous, ClearCarry).
# <T1-FACTS-END>

