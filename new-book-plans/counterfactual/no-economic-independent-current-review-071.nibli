ressPrivateReachScope) & observe($source, $origin, $non_waiver, DutyNonWaiverScope) & observe($evidence, $origin, $non_waiver, DutyNonWaiverScope) & observe($review, $origin, $non_waiver, DutyNonWaiverScope) & observe($source, $origin, $failure_polarity, FailurePolarityScope) & observe($evidence, $origin, $failure_polarity, FailurePolarityScope) & observe($review, $origin, $failure_polarity, FailurePolarityScope) & observe($source, $origin, $mode_certificate, DutyBearerModeCertificateScope) & observe($evidence, $origin, $mode_certificate, DutyBearerModeCertificateScope) & observe($review, $origin, $mode_certificate, DutyBearerModeCertificateScope) & observe($source, $origin, $class_certificate, DutyClassCertificateScope) & observe($evidence, $origin, $class_certificate, DutyClassCertificateScope) & observe($review, $origin, $class_certificate, DutyClassCertificateScope) & ~collide($origin, ObligationContractBinding) & ~collide($record, ObligationBearerModeBinding) & ~collide($record, ObligationClassBinding) & observe($source, $origin, PublicObligationBearerMode, DutyBearerModeScope) & observe($evidence, $origin, PublicObligationBearerMode, DutyBearerModeScope) & observe($review, $origin, PublicObligationBearerMode, DutyBearerModeScope) & observe($source, $origin, RoleDutyClass, DutyClassScope) & observe($evidence, $origin, RoleDutyClass, DutyClassScope) & observe($review, $origin, RoleDutyClass, DutyClassScope) & observe($source, $origin, FindingReaderActionDutyKind, DutyKindScope) & observe($evidence, $origin, FindingReaderActionDutyKind, DutyKindScope) & observe($review, $origin, FindingReaderActionDutyKind, DutyKindScope) & observe($source, $record, FSCCE_213, ObligationEffectScope) & observe($evidence, $record, FSCCE_213, ObligationEffectScope) & observe($review, $record, FSCCE_213, ObligationEffectScope) & observe($source, $effect_result, FSCCE_213ObligationBranch, ObligationBranchScope) & observe($evidence, $effect_result, FSCCE_213ObligationBranch, ObligationBranchScope) & observe($review, $effect_result, FSCCE_213ObligationBranch, ObligationBranchScope) & observe($source, $effect_result, FSCCE_213FailureWithholdsOnly, FailurePolarityScope) & observe($evidence, $effect_result, FSCCE_213FailureWithholdsOnly, FailurePolarityScope) & observe($review, $effect_result, FSCCE_213FailureWithholdsOnly, FailurePolarityScope) & public($bearer) & err($finding_subject, $finding_kind) & observe($source, $route, $finding_kind, FindingKindScope) & observe($evidence, $route, $finding_kind, FindingKindScope) & observe($review, $route, $finding_kind, FindingKindScope) & observe($source, $route, $finding_subject, FindingSubjectScope) & observe($evidence, $route, $finding_subject, FindingSubjectScope) & observe($review, $route, $finding_subject, FindingSubjectScope) & observe($source, $route, $subject, FindingAffectedSubjectScope) & observe($evidence, $route, $subject, FindingAffectedSubjectScope) & observe($review, $route, $subject, FindingAffectedSubjectScope) & observe($source, $route, $case, FindingCaseScope) & observe($evidence, $route, $case, FindingCaseScope) & observe($review, $route, $case, FindingCaseScope) & observe($source, $route, $reader, FindingReaderScope) & observe($evidence, $route, $reader, FindingReaderScope) & observe($review, $route, $reader, FindingReaderScope) & observe($source, $route, $route, FindingRouteScope) & observe($evidence, $route, $route, FindingRouteScope) & observe($review, $route, $route, FindingRouteScope) & ~($reader = $source) & ~($reader = $evidence) & ~($reader = $review) & observe($source, $effect_result, $receipt, FindingReceiptEvidenceScope) & observe($evidence, $effect_result, $receipt, FindingReceiptEvidenceScope) & observe($review, $effect_result, $receipt, FindingReceiptEvidenceScope) & observe($source, $effect_result, $permitted_action, FindingPermittedActionScope) & observe($evidence, $effect_result, $permitted_action, FindingPermittedActionScope) & observe($review, $effect_result, $permit