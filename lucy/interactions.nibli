record("CodexLucy-NellBlog-20261002-8", "{\"id\":\"CodexLucy-NellBlog-20261002-8\",\"speaker\":\"Dhilipsiva\",\"text\":\"Lucy, rate and review the blogpost. I am going to post it in medium.\",\"kind\":\"message\",\"timestamp\":\"2026-10-02T21:12:57Z\",\"host\":\"DESKTOP-86I05G4\",\"source\":\"codex\",\"session\":\"\",\"channel\":\"user\",\"about\":[\"lucy\",\"nell\",\"blog\",\"review\"],\"private\":false,\"from\":null,\"kr\":null}", Message, Json).
