record("CodexLucy-RightsNaming-20261002-1", "{\"id\":\"CodexLucy-RightsNaming-20261002-1\",\"speaker\":\"Dhilipsiva\",\"text\":\"Lucy, write this in my voice\",\"kind\":\"message\",\"timestamp\":\"2026-10-02T21:05:16Z\",\"host\":\"DESKTOP-86I05G4\",\"source\":\"codex\",\"session\":\"\",\"channel\":\"user\",\"about\":[\"lucy\",\"naming\",\"rights-nobody-has-to-earn\"],\"private\":false,\"from\":null,\"kr\":null}", Message, Json).
