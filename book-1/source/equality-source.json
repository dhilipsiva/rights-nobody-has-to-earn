          "$target",
          "EqualityNonresponseTargetScope"
        ],
        [
          "$requester",
          "EqualityRequesterScope"
        ],
        [
          "$request",
          "EqualityRequestScope"
        ],
        [
          "PositiveIndependentFindingThatTheDeadlinePassedWithoutTheRequiredAction",
          "EqualityNonresponseFindingScope"
        ],
        [
          "NoSilenceApprovalNoNewAuthorityAndNoAccommodationSuspension",
          "EqualityNonresponseSilenceScope"
        ],
        [
          "PredeclaredUninvolvedAlternateActionAndCourtEscalation",
          "EqualityNonresponseAlternateScope"
        ],
        [
          "$deadline",
          "EqualityDeadlineScope"
        ],
        [
          "AuthenticatedNoticeAndRealOpportunityToAct",
          "EqualityNoticeOpportunityScope"
        ]
      ],
      "heads": [
        "obliged($alternate, ActOnTheUnansweredEqualityRequestAndEscalateToTheCourt, $target)"
      ],
      "extra": [
        "~($requester = $reader)",
        "~($requester = $alternate)",
        "~($requester = $actor)",
        "~($source = $reader)",
        "~($evidence = $reader)",
        "~($review = $reader)"
      ],
      "record_dependency": false,
      "bindings": {}
