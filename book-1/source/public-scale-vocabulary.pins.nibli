# SPDX-License-Identifier: MIT OR Apache-2.0
# Public-scale vocabulary: the named grounds of a private-power finding
#
# The finding's own composition is pinned in the FS-POW-064 suite. What is
# pinned here is the vocabulary itself: every ratified ground is a member,
# nothing else is however it is attested, the three sets do not leak into one
# another, and no supplied record can write a membership.
:expect-pins 32

# ── Trigger grounds: the ratified kinds, and nothing else ───────────────────────────────────────────
observe(PublicScaleWitness, PublicScaleRecordEssentialityTrigger, EssentialityTrigger, PublicScaleTriggerScope).
? member(EssentialityTrigger, PublicScaleTriggerVocabulary).
# => TRUE
observe(PublicScaleWitness, PublicScaleRecordDominanceTrigger, DominanceTrigger, PublicScaleTriggerScope).
? member(DominanceTrigger, PublicScaleTriggerVocabulary).
# => TRUE
observe(PublicScaleWitness, PublicScaleRecordGatekeepingTrigger, GatekeepingTrigger, PublicScaleTriggerScope).
? member(GatekeepingTrigger, PublicScaleTriggerVocabulary).
# => TRUE
observe(PublicScaleWitness, PublicScaleRecordDependencyTrigger, DependencyTrigger, PublicScaleTriggerScope).
? member(DependencyTrigger, PublicScaleTriggerVocabulary).
# => TRUE
observe(PublicScaleWitness, PublicScaleRecordLockInTrigger, LockInTrigger, PublicScaleTriggerScope).
? member(LockInTrigger, PublicScaleTriggerVocabulary).
# => TRUE
observe(PublicScaleWitness, PublicScaleRecordNetworkEffectsTrigger, NetworkEffectsTrigger, PublicScaleTriggerScope).
? member(NetworkEffectsTrigger, PublicScaleTriggerVocabulary).
# => TRUE
observe(PublicScaleWitness, PublicScaleRecordInformationAsymmetryTrigger, InformationAsymmetryTrigger, PublicScaleTriggerScope).
? member(InformationAsymmetryTrigger, PublicScaleTriggerVocabulary).
# => TRUE
observe(PublicScaleWitness, PublicScaleRecordNoMeaningfulExitTrigger, NoMeaningfulExitTrigger, PublicScaleTriggerScope).
? member(NoMeaningfulExitTrigger, PublicScaleTriggerVocabulary).
# => TRUE
# A revenue threshold is attested at the same scope by the same kind of witness
# and joins nothing: size is not a ground and cannot be made one from outside.
observe(PublicScaleWitness, PublicScaleRecordEconAnnualRevenueOver500M, EconAnnualRevenueOver500M, PublicScaleTriggerScope).
? member(EconAnnualRevenueOver500M, PublicScaleTriggerVocabulary).
# => FALSE

# ── Function classes: what a finding may bind ───────────────────────────────────────────
observe(PublicScaleWitness, PublicScaleRecordPublicFacingFunctionClass, PublicFacingFunctionClass, PublicScaleFunctionClassScope).
? member(PublicFacingFunctionClass, PublicScaleFunctionClassVocabulary).
# => TRUE
observe(PublicScaleWitness, PublicScaleRecordDelegatedPublicFunctionClass, DelegatedPublicFunctionClass, PublicScaleFunctionClassScope).
? member(DelegatedPublicFunctionClass, PublicScaleFunctionClassVocabulary).
# => TRUE
observe(PublicScaleWitness, PublicScaleRecordEssentialFunctionClass, EssentialFunctionClass, PublicScaleFunctionClassScope).
? member(EssentialFunctionClass, PublicScaleFunctionClassVocabulary).
# => TRUE
observe(PublicScaleWitness, PublicScaleRecordGatekeepingFunctionClass, GatekeepingFunctionClass, PublicScaleFunctionClassScope).
? member(GatekeepingFunctionClass, PublicScaleFunctionClassVocabulary).
# => TRUE
observe(PublicScaleWitness, PublicScaleRecordSystemicallyControllingFunctionClass, SystemicallyControllingFunctionClass, PublicScaleFunctionClassScope).
? member(SystemicallyControllingFunctionClass, PublicScaleFunctionClassVocabulary).
# => TRUE
# Ordinary private activity attested as a class of its own stays outside the
# list, so nothing can be relabelled into range.
observe(PublicScaleWitness, PublicScaleRecordEconPrivateHobbyFunctionClass, EconPrivateHobbyFunctionClass, PublicScaleFunctionClassScope).
? member(EconPrivateHobbyFunctionClass, PublicScaleFunctionClassVocabulary).
# => FALSE

# ── Tier allocations: which tier may find which reach ───────────────────────────────────────────
observe(PublicScaleWitness, PublicScaleRecordSingleRegionReachUnderRegionalTier, SingleRegionReachUnderRegionalTier, PublicScaleTierAllocationScope).
? member(SingleRegionReachUnderRegionalTier, PublicScaleTierAllocationVocabulary).
# => TRUE
observe(PublicScaleWitness, PublicScaleRecordCrossRegionalReachUnderCommonTier, CrossRegionalReachUnderCommonTier, PublicScaleTierAllocationScope).
? member(CrossRegionalReachUnderCommonTier, PublicScaleTierAllocationVocabulary).
# => TRUE
# The pairing that puts a cross-regional gatekeeper under one region's finding
# is not a lawful allocation and never becomes one.
observe(PublicScaleWitness, PublicScaleRecordCrossRegionalReachUnderRegionalTier, CrossRegionalReachUnderRegionalTier, PublicScaleTierAllocationScope).
? member(CrossRegionalReachUnderRegionalTier, PublicScaleTierAllocationVocabulary).
# => FALSE
# The mirror pairing gives the common tier a single region's case, which the
# residual competence leaves with that region. It is not a lawful allocation
# either, and the wall is the same conjunct in both directions.
observe(PublicScaleWitness, PublicScaleRecordSingleRegionReachUnderCommonTier, SingleRegionReachUnderCommonTier, PublicScaleTierAllocationScope).
? member(SingleRegionReachUnderCommonTier, PublicScaleTierAllocationVocabulary).
# => FALSE

# ── The sets do not leak into one another ──────────────────────────────────
# Gatekeeping is a ground and a function class under two different names, and
# neither name reaches the other's set however it is attested.
observe(PublicScaleWitness, PublicScaleLeakEssentialityTrigger, EssentialityTrigger, PublicScaleFunctionClassScope).
? member(EssentialityTrigger, PublicScaleFunctionClassVocabulary).
# => FALSE
observe(PublicScaleWitness, PublicScaleLeakGatekeepingFunctionClass, GatekeepingFunctionClass, PublicScaleTriggerScope).
? member(GatekeepingFunctionClass, PublicScaleTriggerVocabulary).
# => FALSE
observe(PublicScaleWitness, PublicScaleLeakCrossRegionalReachUnderCommonTier, CrossRegionalReachUnderCommonTier, PublicScaleTriggerScope).
? member(CrossRegionalReachUnderCommonTier, PublicScaleTriggerVocabulary).
# => FALSE

# ── No supplied record writes a membership ─────────────────────────────────
# Admitting the vocabulary would let a record name its own ninth ground, so it
# is conclusion-only and the assertion is refused outright.
:refuse reasoning /derived-only/
member(EconAnnualRevenueOver500M, PublicScaleTriggerVocabulary).
? member(EconAnnualRevenueOver500M, PublicScaleTriggerVocabulary).
# => FALSE

# ── A finding whose ground is not named carries nothing ────────────────────
# The composed FS-POW-064 premises, complete and independently attested, with
# one token replaced. Against the real constitution the reviewed result and
# the holder authority that reads it both withhold; the control below shows
# the same premises carrying the finding when every token is a named one.
# Ground stated: an annual revenue threshold, and nothing else.
authorized(EconSource064UnnamedTrigger, EconomicSourceAuthority, EconRecord064UnnamedTrigger).
authorized(EconTemporal064UnnamedTrigger, EconomicTemporalAuthority, EconTemporalRecord064UnnamedTrigger).
authorized(EconTemporalReview064UnnamedTrigger, EconomicTemporalReviewAuthority, EconTemporalRecord064UnnamedTrigger).
authorized(EconRecordReview064UnnamedTrigger, EconomicRecordReviewAuthority, EconRecord064UnnamedTrigger).
