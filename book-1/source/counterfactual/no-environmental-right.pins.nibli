# Counterfactual: present-person environmental-conditions rule deleted
:expect-pins 3
? prevents(Adam, EnvironmentalConditionsDenial).
# => FALSE
? prevents(Adam, EnvironmentalInformationWithholding).
# => TRUE
? entitled(Adam, event { eats() }).
# => TRUE
