# Explicit counterfactual: an appointment route omits recall and carry checks.
# The prospective finding retains its own current-disqualification checks.
:expect-pins 6
? rotten(Mael).
# => TRUE
? permits(Review, Mael).
# => TRUE
? broken(Tove).
# => TRUE
? permits(Review, Tove).
# => TRUE
? agree(Credibility_Tyr_Candidate, CredibilityFindingCandidate).
# => FALSE
? false(Tyr).
# => FALSE
