observe(Chronicle, Case_Zed, Window_Custody, LimitScope).
observe(TemporalReview, Case_Zed, Window_Custody, LimitScope).
continue(Case_Zed, Epoch_Current).
observe(Chronicle, Case_Zed, Epoch_Current, RenewalScope).
observe(TemporalReview, Case_Zed, Epoch_Current, RenewalScope).
endorses(Electorate, Case_Zed).
endorses(TemporalReview, Case_Zed).

? prisoner(Zed).
# => TRUE

? person(Zed).
# => FALSE

# THE DEBT EVAPORATES WITH THE DEBTOR — chapter 27's "it closes the file". A
# prisoner who is not a person is owed nothing: no unpaid obligation survives to
# catch an auditor's eye, so de-personing leaves the books balanced rather than
# showing a gap. Both TRUE against the real constitution (probed 2026-08-02);
# both FALSE here, in the same edit that jailed the heretic above.
? owe(State, Eats, Zed).
# => FALSE

? entitled(Zed, event { eats() }).
# => FALSE
