observe(TemporalReview, Case_Zed, Ivo, InjuryVictimScope).
authorized(Case_Zed, ActiveCustody, Case_Zed).
observe(Chronicle, Case_Zed, ActiveCustody, PowerScope).
observe(TemporalReview, Case_Zed, ActiveCustody, PowerScope).
observe(Chronicle, Case_Zed, Case_Zed, CaseBindingScope).
observe(TemporalReview, Case_Zed, Case_Zed, CaseBindingScope).
