# economic-carry-liability current disappears with its exact rule.
? complete(EconCarryLiabilityCounterfactualRecord, EconomicLiabilityCarryCurrent, EconCarryLiabilityCounterfactualTemporalRecord).
# => FALSE
# economic-carry-liability result disappears with its exact rule.
? complete(EconCarryLiabilityCounterfactualResult, EconomicLiabilityCarryResult, EconCarryLiabilityCounterfactualRecord).
# => FALSE

# Removing carry rules does not remove a person-held economic barrier.
? prevents(Adam, EconomicFactorFloorGate).
# => TRUE
