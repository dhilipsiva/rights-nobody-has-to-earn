        ],
        [
          "EachComparedClaimantsSubmittedEvidenceConsideredBeforeTheComparison",
          "ScarcityClaimantEvidenceScope"
        ],
        [
          "PublicReasonsForChosenAllocationAndRejectedAlternativesWithAccessibleClaimantChallenge",
          "ScarcityAllocationReasonsScope"
        ]
      ],
      "heads": [
        "permits($manager, AllocateUnderPhysicalScarcity, $record)",
        "obliged($manager, RecordEveryUnmetPortionAsFailure, $record)",
        "obliged($manager, PublishComparativeAllocationReasonsAndRejectedAlternatives, $record)"
      ],
      "extra": [
        "member($allocation_method, $comparison_outcome)"
      ],
      "record_dependency": true,
      "bindings": {}
