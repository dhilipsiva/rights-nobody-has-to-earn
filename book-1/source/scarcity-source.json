        ],
        [
          "FloorAndContinuityRoutesSurviveTheFinding",
          "ScarcityFalseLimitScope"
        ]
      ],
      "heads": [
        "contradict($target, ScarcityFindingAuthorization)",
        "obliged($reader, TreatFalseScarcityAsFailureNotShortage, $target)",
        "obliged($manager, RestoreOrProcureWhatWasWithheld, $target)"
      ],
      "extra": [
        "authorized($target_source, ScarcitySourceAuthority, $target)",
        "observe($target_source, $target, $resource, ScarcityResourceScope)",
        "observe($target_source, $target, $population, ScarcityAffectedPopulationScope)",
