      "heads": [
        "obliged($manager, RepairAndReassessTheRecordedShortfall, $record)",
        "obliged($reader, VerifyTheShortfallWasRecordedAsFailure, $record)"
      ],
      "extra": [],
      "record_dependency": true,
      "bindings": {}
    },
    {
      "id": "false-scarcity",
