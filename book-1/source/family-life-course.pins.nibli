# General adulthood derives without mature.
? prevents(Hano, GeneralAdulthoodDenial).
# => TRUE
? decide(Hano, Ballot).
# => TRUE
? prevents(Cira, GeneralAdulthoodDenial).
# => FALSE
? decide(Cira, Ballot).
# => FALSE

# Decision-specific early authority cannot manufacture the ballot.
person(EarlyCase).
authorized(EarlyCase, EarlyDecision, TreatmentChoice).
? decide(EarlyCase, TreatmentChoice).
# => TRUE
? decide(EarlyCase, Ballot).
# => FALSE

# Family status is inert across placement.
? family(Nando).
# => TRUE
? fit(Nando, Homestay).
# => TRUE
? building(LowSec, Nando).
# => FALSE
? building(Homestay, Nando).
# => FALSE

# Home and placement-home availability remain distinct.
? home(Hano).
# => TRUE
? at(Hano, PlacementHome).
# => TRUE
? building(Homestay, Hano).
# => TRUE

# Recognition of a care-shaped contribution proves neither health nor housing.
person(CareProbe).
work(CareProbe, Care).
? reward(CareProbe).
# => TRUE
? healthy(CareProbe).
# => FALSE
? dwell(CareProbe).
# => FALSE
