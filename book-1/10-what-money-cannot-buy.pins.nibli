# "What does not end with the power is the floor and the essential service"
? prevents(Adam, EnterpriseFailureRemedyErasure).
# => TRUE

# "Every ratified ground is a member of the trigger vocabulary and nothing else
# is, however it is attested" — Harrow attests, and the vocabulary decides.
observe(Harrow, HarrowRecordEssentiality, EssentialityTrigger, PublicScaleTriggerScope).
? member(EssentialityTrigger, PublicScaleTriggerVocabulary).
# => TRUE

observe(Harrow, HarrowRecordRevenue, HarrowRevenueThreshold, PublicScaleTriggerScope).
# "Being large is not on the list."
? member(HarrowRevenueThreshold, PublicScaleTriggerVocabulary).
# => FALSE

observe(Harrow, HarrowRecordGate, GatekeepingFunctionClass, PublicScaleFunctionClassScope).
? member(GatekeepingFunctionClass, PublicScaleFunctionClassVocabulary).
# => TRUE

observe(Harrow, HarrowRecordLeak, GatekeepingFunctionClass, PublicScaleTriggerScope).
# "the three sets do not leak into one another"
? member(GatekeepingFunctionClass, PublicScaleTriggerVocabulary).
# => FALSE

observe(Harrow, HarrowRecordTier, CrossRegionalReachUnderRegionalTier, PublicScaleTierAllocationScope).
# "Pair them the other way and the finding carries nothing at all."
? member(CrossRegionalReachUnderRegionalTier, PublicScaleTierAllocationVocabulary).
# => FALSE

# "No supplied record can write a membership."
:refuse reasoning /derived-only/
member(HarrowRevenueThreshold, PublicScaleTriggerVocabulary).

# The one-entry child record retains the prohibitions on economic gates and
# the public dwelling debt; it proves nothing about actual possessions.
? prevents(Nell, EconomicFactorFloorGate).
# => TRUE

? prevents(Nell, PaymentInstrumentAsDelivery).
# => TRUE

? prevents(Nell, HouseholdPresumedFloorProvider).
# => TRUE

? prevents(Nell, VoluntarySphereSocialScore).
# => TRUE

? owe(State, Dwell, Nell).
# => TRUE
