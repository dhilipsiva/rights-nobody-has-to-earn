observe(CustodyIntakeAudit, Case_Zeno, ReconciledPrimaryAlternateAndSubjectHeldFilingsBeforeEachRenewal, CustodyIntakeReconciliationScope).
observe(CustodyIntake, Case_Zeno, NoHolderPermissionNoRetaliationAndImmediateSuspensionOnFiling, CustodyIntakeProtectionScope).
observe(CustodyIntakeAudit, Case_Zeno, NoHolderPermissionNoRetaliationAndImmediateSuspensionOnFiling, CustodyIntakeProtectionScope).


# FARO — a private target. "The record contains an injury to Pax and Faro's
# disclosure against Pax, the injured person."
? injure(Faro, Pax).
# => TRUE

? show(Faro, Disclosure_Faro_Pax, Pax).
# => TRUE

# "Answerability follows from a public-body entry or a seating, and the record
# holds neither for Pax" — the condition that fails.
? authority(Pax).
# => FALSE

# "Faro is therefore unshielded, and the otherwise complete case authorises
# confinement."
? defend(Faro).
# => FALSE

? prisoner(Faro).
# => TRUE

# LIOR — "Lior's separate case also records an injury to Pax, but Lior's
# disclosure names the prosecuting court."
? injure(Lior, Pax).
# => TRUE

? show(Lior, Disclosure_Lior_Court, Court).
# => TRUE

# "The court is publicly answerable, and nothing in force finds that exposure
# deceitful": no deceit finding about Lior's disclosure follows, and the court
# holds public answerability.
? false(Lior, Disclosure_Lior_Court).
# => FALSE

? authority(Court).
# => TRUE

# The raw deceit entry, absent for Lior and present for Kel below. No rule
# reads it: "A raw accusation or a generic judgment by the review body falls
# short of such a case." The shield turns on the completed finding pinned FALSE
# above, so Lior's protection rests on that finding's absence.
? deceive(Lior, Court).
# => FALSE

# Lior's shield derives; no prisoner conclusion follows. This proves no release.
? defend(Lior).
# => TRUE

? prisoner(Lior).
# => FALSE

# KEL — "a completed case identifies Kel's exposure, a deceit finding and its
# evidence". The raw deceit entry is on the record too; the shield reads only
# the finding.
? show(Kel, Disclosure_Kel_Court, Court).
# => TRUE

? false(Kel, Disclosure_Kel_Court).
# => TRUE

? deceive(Kel, Court).
# => TRUE

# "That finding defeats this exposure's shield, so Kel's otherwise complete
# case authorises confinement. It also produces a personal finding that
# restricts signing new credibility findings." KEL RESOLVES ONLY BECAUSE KEL
# EXPOSED ONCE. These three are per-subject, and a per-subject pin cannot see
# what happens per PAIR — the shield rule is satisfied by ANY qualifying pair,
# so a second exposure reopens it. That is what the Dara block below exists to
# hold, and why it is not enough to pin Kel.
? defend(Kel).
# => FALSE

? prisoner(Kel).
# => TRUE

? false(Kel).
# => TRUE

# DARA — "Dara's record concerns an injury to another person and two
# exposures: one against the court and another against the review body. A
# completed case found the court disclosure deceitful." The disclosed cost of
# scoping the shield to the exposure: if any pin in this section flips, the
# chapter's section "Dara: a separate exposure" is wrong, and so is the
# constitution's E1d commentary.
? show(Dara, Disclosure_Dara_Court, Court).
# => TRUE

? false(Dara, Disclosure_Dara_Court).
# => TRUE

? deceive(Dara, Court).
# => TRUE

# The completed finding also restricts Dara's signing of new credibility
# findings, as it does Kel's.
? false(Dara).
# => TRUE

# The second exposure, against the review body: "nothing in force finds the
# second exposure deceitful".
? show(Dara, Disclosure_Dara_Review, Review).
# => TRUE

? false(Dara, Disclosure_Dara_Review).
# => FALSE

# ...and "The review body is publicly answerable", the other premise the shield
# needs for the second exposure.
? authority(Review).
# => TRUE

# THE PAIR THAT MATTERS. "Dara is both discredited and shielded" — the finding
# against the first exposure has nothing to say about the second.
? defend(Dara).
# => TRUE

? prisoner(Dara).
# => FALSE

# ── A PERSON GUARD REFUSED IN THIS REPRESENTATION ───────────────────────────────────────
# The natural tightening — shield persons only — closes a negative cycle
# through the shield's own head (person <- prisoner, prisoner reads ~defend)
# and the stratifier refuses it by name. The queries after it show the hazard:
# a refused tightening leaves the permissive rule in force with every verdict
# intact, so it protects nobody it meant to stop protecting. If the refusal
# ever stops firing, the engine's cycle detection has changed.
:refuse reasoning /Unstratifiable/
all $w: all $o: all $incident: show($w, $incident, $o) & authority($o) & person($w) & ~false($w, $incident) -> defend($w).

? defend(Lior).
# => TRUE

? prisoner(Lior).
# => FALSE

? defend(Iris).
# => TRUE

# ── THE FRAME-UP COMPLETED FROM OUTSIDE ──────────────────────────────────────
# Faro's frame-up fails on an absence: Pax holds no public answerability,
# pinned FALSE in the Faro section beside Faro's unshielded confinement. Those
# pins are the negative control for what follows. Answerability by the public
# route is a single admitted entry that nobody adjudicates, so write it about
# the victim and the absence is gone: "Faro's exposure would then open the
# shield, and confinement would lose its authorisation." Ground fact, so it
# persists; the reach-back block below does not read Pax.
public(Pax).

? authority(Pax).
# => TRUE

? defend(Faro).
# => TRUE

? prisoner(Faro).
# => FALSE

# ── THE CASE THE SHIELD STOPS COVERING ───────────────────────────────────────
# The second route, the unrelated-case finding, run on Dara. Dara has
# everything confinement needs except the absence of a
# shield: the injury, the court's judgment, the cited case, the recorded
# conviction, both witnesses on every scope, and an active custody
# authorisation.
? match(Dara, ConvictionRecorded).
# => TRUE

? correct(Case_Dara, ActivePower).
# => TRUE

# Dara has no qualifying case finding initially. Appeals and Convocation
# decide only with their own case authority and independently attested
# eligibility; their agreement alone is insufficient.
observe(Appeals, Case_Dara, ShieldUnrelatedToTheDisclosure, ShieldConnectionScope).
observe(Convocation, Case_Dara, ShieldUnrelatedToTheDisclosure, ShieldConnectionScope).
observe(Appeals, Case_Dara, Dara, ShieldSubjectScope).
observe(Convocation, Case_Dara, Dara, ShieldSubjectScope).

? prisoner(Dara).
# => FALSE

# Add each reviewer's authority for this case, and the positive agreement of
# the appointments office and its reviewing office, both authorised, on each
# reviewer's eligibility: "With those premises recorded, Dara's confinement is
# authorised."
authorized(Appeals, ShieldConnectionReviewer, Case_Dara).
authorized(Convocation, ShieldConnectionReviewer, Case_Dara).
authorized(ShieldAppointments, ShieldQualificationAuthority, Case_Dara).
authorized(ShieldAppointmentsReview, ShieldQualificationReviewAuthority, Case_Dara).
observe(ShieldAppointments, Case_Dara, Appeals, IndependentShieldReviewerScope).
observe(ShieldAppointments, Case_Dara, Convocation, IndependentShieldReviewerScope).
observe(ShieldAppointmentsReview, Case_Dara, Appeals, IndependentShieldReviewerScope).
observe(ShieldAppointmentsReview, Case_Dara, Convocation, IndependentShieldReviewerScope).

? prisoner(Dara).
# => TRUE

# And the shield is not what was taken. It still holds, for the claim it was
# always about; what stopped is its reach into this one case.
? defend(Dara).
# => TRUE

? show(Dara, Disclosure_Dara_Review, Review).
# => TRUE

# A prosecuting court cannot supply the independent case decision. Give
# every positive qualification premise so that the Court exclusion is live;
# the isolated shield-independence cases test the other conjuncts separately.
observe(Review, Case_Lior, ShieldUnrelatedToTheDisclosure, ShieldConnectionScope).
observe(Court, Case_Lior, ShieldUnrelatedToTheDisclosure, ShieldConnectionScope).
observe(Review, Case_Lior, Lior, ShieldSubjectScope).
observe(Court, Case_Lior, Lior, ShieldSubjectScope).

authorized(Review, ShieldConnectionReviewer, Case_Lior).
authorized(Court, ShieldConnectionReviewer, Case_Lior).
authorized(ShieldAppointments, ShieldQualificationAuthority, Case_Lior).
authorized(ShieldAppointmentsReview, ShieldQualificationReviewAuthority, Case_Lior).
observe(ShieldAppointments, Case_Lior, Review, IndependentShieldReviewerScope).
observe(ShieldAppointments, Case_Lior, Court, IndependentShieldReviewerScope).
observe(ShieldAppointmentsReview, Case_Lior, Review, IndependentShieldReviewerScope).
observe(ShieldAppointmentsReview, Case_Lior, Court, IndependentShieldReviewerScope).

? prisoner(Lior).
# => FALSE

? defend(Lior).
# => TRUE

# NAMING EVERY DECISION PARTICIPANT IS NOT A VETO. Positive eligibility and
# the case finding remain; the disclosure remains protected in its own right.
show(Dara, Disclosure_Dara_Appeals, Appeals).
show(Dara, Disclosure_Dara_Convocation, Convocation).
show(Dara, Disclosure_Dara_ShieldAppointments, ShieldAppointments).
show(Dara, Disclosure_Dara_ShieldAppointmentsReview, ShieldAppointmentsReview).
? prisoner(Dara).
# => TRUE
? defend(Dara).
# => TRUE

# AN ACTUAL AUTHORISED CONFLICT IS DIFFERENT. It defeats the affected
# decision even if favourable certifications remain alongside it.
observe(ShieldAppointmentsReview, Case_Dara, Appeals, ConflictedShieldReviewerScope).
? contradict(Case_Dara, Appeals, ShieldReviewerConflict).
# => TRUE
? prisoner(Dara).
# => FALSE
? defend(Dara).
# => TRUE

# ── THE REACH-BACK. Ground facts persist into the section after it ─────────
# "The protection has no recency test and no deadline that would end it while
# a reviewer fails to act." Nothing below dates Zeno's exposure against Tove's
# recall, and the shield reads no such date. Tove is deliberately an existing
# name, since reaching back to Tove is the exhibit; everything else is fresh.
# One write blocks confinement.
person(Zeno).
injure(Zeno, Yara).
judge(Court, Zeno).
cite(Court, Case_Zeno, Zeno).
observe(Chronicle, Case_Zeno, Zeno, CaseScope).
observe(TemporalReview, Case_Zeno, Zeno, CaseScope).
observe(Chronicle, Case_Zeno, Court, HolderScope).
observe(TemporalReview, Case_Zeno, Court, HolderScope).
observe(Chronicle, Case_Zeno, CourtJudgment, JudgmentScope).
observe(TemporalReview, Case_Zeno, CourtJudgment, JudgmentScope).
observe(Chronicle, Case_Zeno, Yara, InjuryVictimScope).
observe(TemporalReview, Case_Zeno, Yara, InjuryVictimScope).
authorized(Case_Zeno, ActiveCustody, Case_Zeno).
observe(Chronicle, Case_Zeno, ActiveCustody, PowerScope).
observe(TemporalReview, Case_Zeno, ActiveCustody, PowerScope).
observe(Chronicle, Case_Zeno, Case_Zeno, CaseBindingScope).
observe(TemporalReview, Case_Zeno, Case_Zeno, CaseBindingScope).
limit(Case_Zeno, Case_Zeno, Window_Custody).
observe(Chronicle, Case_Zeno, Window_Custody, LimitScope).
observe(TemporalReview, Case_Zeno, Window_Custody, LimitScope).
continue(Case_Zeno, Epoch_Current).
observe(Chronicle, Case_Zeno, Epoch_Current, RenewalScope).
observe(TemporalReview, Case_Zeno, Epoch_Current, RenewalScope).
endorses(Electorate, Case_Zeno).
endorses(TemporalReview, Case_Zeno).

? prisoner(Zeno).
# => TRUE

# Above, the complete case authorises Zeno's confinement. The one write is a
# disclosure against Tove, recalled yet still answerable: "recall leaves
# intact the answerability on which someone else's protection rests". The
# shield then derives, and Zeno's confinement loses its authorisation.
show(Zeno, Disclosure_Zeno_Tove, Tove).

? prisoner(Zeno).
# => FALSE

? defend(Zeno).
# => TRUE

# ...and the official Zeno reached back to has been recalled. The shield does
# not ask.
? broken(Tove).
# => TRUE

# ── A disclosure made after the charge ────────────────────────────────────
# "A prosecution can answer only for what came before it." "When both record
# that a disclosure was made after that case's charge, the charge came first,
# and the disclosure stops blocking confinement in that case."
# One witness's entry is not enough; without both the disclosure bears on the case.
observe(Chronicle, Disclosure_Zeno_Tove, Case_Zeno, DisclosureFollowsTheChargeScope).

? prisoner(Zeno).
# => FALSE

# With the second witness's entry both date the disclosure after the charge:
# confinement under Zeno's case follows, and the shield for Zeno in that case
# is FALSE.
observe(TemporalReview, Disclosure_Zeno_Tove, Case_Zeno, DisclosureFollowsTheChargeScope).

? prisoner(Zeno).
# => TRUE

? defend(Zeno, Case_Zeno).
# => FALSE

# The one-place shield is unchanged, and the same disclosure still bears on a
# case in which Zeno is cited without that record.
? defend(Zeno).
# => TRUE

cite(Court, Case_Zeno_Later, Zeno).

? defend(Zeno, Case_Zeno_Later).
# => TRUE

# A second disclosure the witnesses have not dated bears on the case again. The
# unrelated-case review in tests/pins/shield-independence remains the route for
# a disclosure that preceded the charge; without qualified reviewers, protection
# holds, as Lior's section shows above.
show(Zeno, Disclosure_Zeno_Review, Review).

? prisoner(Zeno).
# => FALSE

# "A defendant who accuses the court that tries them gains no delay by it."
# Either witness alone leaves the protection in place; this time TemporalReview
# writes first.
observe(TemporalReview, Disclosure_Lior_Court, Case_Lior, DisclosureFollowsTheChargeScope).

? prisoner(Lior).
# => FALSE

# With Chronicle's entry as well, both witnesses date Lior's disclosure after
# the charge: "Confinement under Lior's case is then authorised, and the shield
# itself still applies."
observe(Chronicle, Disclosure_Lior_Court, Case_Lior, DisclosureFollowsTheChargeScope).

? prisoner(Lior).
# => TRUE

? defend(Lior).
# => TRUE
