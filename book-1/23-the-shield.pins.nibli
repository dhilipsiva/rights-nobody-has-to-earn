observe(CustodyIntakeAudit, Case_Zeno, Zeno, CustodyIntakeSubjectScope).
observe(CustodyIntake, Case_Zeno, Case_Zeno, CustodyIntakeCaseScope).
observe(CustodyIntakeAudit, Case_Zeno, Case_Zeno, CustodyIntakeCaseScope).
