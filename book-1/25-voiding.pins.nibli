observe(Scionfa, Finding_Targ, Evidence_Finding_Targ, CredibilityEvidenceScope).
observe(Scionfa, Finding_Targ, NoticeEvidenceAccessHearingAndReasons, CredibilityProcedureScope).
? agree(Finding_Targ, CredibilityFindingCandidate).
