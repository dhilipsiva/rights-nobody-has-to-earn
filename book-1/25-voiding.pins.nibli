# Chapter 25 fidelity pins: Voiding.
# Cases use the actual constitution and the declared no-dead-conjuncts variant.
:expect-pins 102

# Bela: the two appointments and the particular completed case.
? permits(Review, Gia).
# => TRUE

? permits(Tribunal, Hex).
# => TRUE

? judge(Gia, Credibility_Bela_Finding).
# => TRUE

? capture(Gia, Bela, Credibility_Bela_Incident).
# => TRUE

? judge(Hex, Credibility_Bela_Finding).
# => TRUE

? capture(Hex, Bela, Credibility_Bela_Incident).
# => TRUE

? false(Bela).
# => TRUE

# Koa: documentation alone supplies neither judgment nor appointment.
? capture(Koa, Esa).
# => TRUE

? judge(Koa, Esa).
# => FALSE

? permits(Review, Koa).
# => FALSE

? false(Esa).
# => FALSE

# Parent/child judgment alone imposes no personal credibility finding.
? parent(Dev, Esa).
# => TRUE

? judge(Dev, Esa).
# => TRUE

? false(Dev).
# => FALSE

# Lupo: the case identifies whose deceit was adjudicated; Mira is untouched.
? deceive(Lupo, Mira).
# => TRUE

? false(Mira).
# => FALSE

? false(Lupo).
# => TRUE

? rotten(Vex).
# => TRUE

? permits(Tribunal, Wren).
# => TRUE

? false(Tyr).
# => FALSE

