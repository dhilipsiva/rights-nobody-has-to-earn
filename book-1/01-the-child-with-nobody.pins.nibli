# ── Chapter 1 fidelity pins: "The Child With Nobody" ─────────────────────────
#
# KIND: CONTENT pin. Run:
#   ./verify.sh --only book-1/01-the-child-with-nobody.pins.nibli
#   ./verify.sh          # all substantive pins and required contradiction checks
# Prose consistency is reviewed separately.
#
# Nell is introduced BY FIXTURE, never by the constitution's cast:
# tests/pins/records/child_with_nobody/fixture.nibli holds exactly `born(Nell).`
# and this chapter's case in tests/pins/suites.json lists it. A cast entry would
# put Nell into every roster query in every case; the chapter needs a record
# that holds nothing else. Ori is queried and never written.
#
# This file's positive conclusions rest on the birth entry, the
# universal-standing rule that reads it, and the rules whose whole body is
# personhood. Custody, adulthood evidence and the delivery routes, which need
# a receipt and an independent witness, are left to later chapters'
# "The child with nobody" sections.
#
# Supporting cases, run in their own contexts:
#   tests/pins/records/child_with_nobody/expect.pins.nibli
#       the whole constitution against the one-entry record (every barrier)
#   book-1/source/counterfactual/no-birth-standing.pins.nibli
#       the birth rule deleted: nothing owed, nothing barred, no alarm
#   tests/pins/records/child_with_nobody/undelivered.pins.nibli
#       the refused delivery marker fires on Nell and never on Ori
#   tests/pins/family-life/life-course/continuity-needs-no-family-role/expect.pins.nibli
#       the immediate care-continuity duty completes with no family role
#   tests/pins/delivery/received-outside-custody/expect.pins.nibli
#       the mirror: a receipt plus an independent witness derives the
#       delivery conclusions
#
# WHAT FALSE MEANS HERE: the supplied record does not establish the queried
# positive statement. It is not proof of its real-world negation. A suitable
# admitted premise or complete source route is needed to change the result;
# derived-only conclusions cannot be written directly. Ori has no standing root.

:expect-pins 90

# "The record holds one entry about Nell: Nell was born."
? born(Nell).
# => TRUE

# "Nell therefore enters the design as a person."
? person(Nell).
# => TRUE

# No recorded family, home or confinement. Family/home entries are admitted;
# confinement needs its derived route, not a direct prisoner assertion.
? family(Nell).
# => FALSE

? home(Nell).
# => FALSE

? prisoner(Nell).
# => FALSE

# "Everything owed" — enumerated, not sampled.
? owe(State, Eats, Nell).
# => TRUE

? owe(State, Dwell, Nell).
# => TRUE

? owe(State, Healthy, Nell).
# => TRUE

? owe(State, Learn, Nell).
# => TRUE

? owe(State, Secure, Nell).
# => TRUE

? owe(State, Suffice, Nell).
# => TRUE

? owe(State, Expresses, Nell).
# => TRUE

? owe(State, Believe, Nell).
# => TRUE

? owe(State, Meets, Nell).
# => TRUE

# Beside each debt, Nell's entitlement to each floor item: "Every debt and
# every entitlement follows from the birth entry."
? entitled(Nell, event { eats() }).
# => TRUE

? entitled(Nell, event { dwell() }).
# => TRUE

? entitled(Nell, event { healthy() }).
# => TRUE

? entitled(Nell, event { learn() }).
# => TRUE

? entitled(Nell, event { secure() }).
# => TRUE

? entitled(Nell, event { suffice() }).
# => TRUE

? entitled(Nell, event { expresses() }).
# => TRUE

? entitled(Nell, event { believe() }).
# => TRUE

? entitled(Nell, event { meets() }).
# => TRUE

# "No one is presumed to provide" — personhood alone puts every one of these
# in place.
? prevents(Nell, PublicFirstCareContinuity).
# => TRUE

? prevents(Nell, KinshipNoPersonalCareDebt).
# => TRUE

? prevents(Nell, DependantIndependentRights).
# => TRUE

? prevents(Nell, ChildIndependentRights).
# => TRUE

? prevents(Nell, ChildAccessibleInformationHelp).
# => TRUE

? prevents(Nell, ChildVoiceNoAgeFloor).
# => TRUE

? prevents(Nell, ChildSeparationLastResort).
# => TRUE

? prevents(Nell, SupportBeforeRemoval).
# => TRUE

? prevents(Nell, MissingKinshipNoIndependence).
# => TRUE

? prevents(Nell, FamilyStatusNoConfinement).
# => TRUE

? prevents(Nell, HouseholdNonprescription).
# => TRUE

? prevents(Nell, StatusNoHarmPresumption).
# => TRUE

? prevents(Nell, CareStatusNondelivery).
# => TRUE

? prevents(Nell, Book2LifeCourseBoundary).
# => TRUE

# "Nobody has to classify Nell as vulnerable either. The record refuses that
# word outright, and an attempt to enter it is rejected."
:refuse syntax /unknown predicate "vulnerable"/
vulnerable(Nell).

# "What delivery needs": no floor item is shown reaching Nell. The record
# holds no receipt with an independent witness and no teacher or hearing;
# bodily safety, expression and belief have no delivery route at all.
? eats(Nell).
# => FALSE

? dwell(Nell).
# => FALSE

? healthy(Nell).
# => FALSE

? secure(Nell).
# => FALSE

? suffice(Nell).
# => FALSE

? meets(Nell).
# => FALSE

? learn(Nell).
# => FALSE

? expresses(Nell).
# => FALSE

? believe(Nell).
# => FALSE

# "Nell has one entry. Ori has none."
? person(Ori).
# => FALSE

# "For Ori the rules conclude nothing": not the food debt, not its
# entitlement, and not the care-continuity barrier that hold for Nell.
? owe(State, Eats, Ori).
# => FALSE

? entitled(Ori, event { eats() }).
# => FALSE

? prevents(Ori, PublicFirstCareContinuity).
# => FALSE

# ── The duty that needs no request ───────────────────────────────────────────
# Article 1c reads personhood and nothing else, so it holds for a record of one
# line. Writing a request, a relationship or a capability finding would change
# nothing about it, which is the point: there is nothing here to withhold.
? obliged(RightsAdvocate, InitiateAssistanceAndRepresentationWithoutARequest, Nell).
# => TRUE

# The initiation duty does not establish delivery or change the floor debt.
? eats(Nell).
# => FALSE

? owe(State, Eats, Nell).
# => TRUE

# The escalation waits for an entry, and the entry takes no credential.
? obliged(IndependentRightsAlternate, ReviewWhetherAssistanceWasInitiatedForThisPerson, Nell).
# => FALSE

# A stranger with no seat, no relationship and no standing writes one.
observe(Passerby, NellUnattended, Nell, UninitiatedAssistanceScope).

? obliged(IndependentRightsAlternate, ReviewWhetherAssistanceWasInitiatedForThisPerson, Nell).
# => TRUE

# The observation concludes nothing about Nell. Not that anybody failed, not
# that Nell is unable to act, not that Nell is anything at all.
# Writing it gives the writer nothing either: the rules conclude no
# personhood for Passerby, who has no standing root.
? person(Passerby).
# => FALSE

# And the rules draw "nothing adverse about Nell" from it: no confinement,
# no credibility finding and no recorded loss.
? prisoner(Nell).
# => FALSE

? false(Nell).
# => FALSE

? lose(Points, Nell).
# => FALSE

# No initiation duty derives for Ori in this record: no standing root is supplied.
# This is not a finding that a real person is lawfully owed nothing.
? obliged(RightsAdvocate, InitiateAssistanceAndRepresentationWithoutARequest, Ori).
# => FALSE

# ── Who counts: every way into the record ───────────────────────────────────────
#
#
# The chapter's case lists tests/pins/records/child_with_nobody/fixture.nibli
# and writes its own roots inline, because each root is one fact and writing
# them here is what lets this file ask the same questions of each.
#
# The family's own coverage is book-1/source/universal-standing.pins.nibli,
# which carries FS-CCE-01 through FS-CCE-08 with their counterfactuals. This
# file asks the chapter's claim rather than the family's: that what follows
# from each root is identical.
#
# WHAT FALSE MEANS HERE: a FALSE is pinned only where the KB could have said
# TRUE, and the comment says what would flip it.


# ── "Nell's birth is one way into the record." ───────────────────────────────
# Fresh names, each given a single standing root: a birth (WhoBorn), first
# contact (WhoMet), presence in the jurisdiction (WhoPresent) or effective
# control (WhoHeld). "Each route stands alone", and the rules conclude
# personhood from each.
born(WhoBorn).
at(WhoMet, FirstContact).
at(WhoPresent, RepublicJurisdiction).
at(WhoHeld, EffectiveControl).

? person(WhoBorn).
# => TRUE

? person(WhoMet).
# => TRUE

? person(WhoPresent).
# => TRUE

? person(WhoHeld).
# => TRUE

# "A report that a person appears to have nobody acting for them is also an
# encounter. Whoever saw the person may write it" — the writer holds no seat.
observe(WhoSaw, WhoReportedEntry, WhoReported, UninitiatedAssistanceScope).
? person(WhoReported).
# => TRUE

# Standing from the report carries the same food debt as any other root,
# and the report "places nobody in custody".
? owe(State, Eats, WhoReported).
# => TRUE

? prisoner(WhoReported).
# => FALSE

# ── "Each route leads to the same floor." ────────────────────────────────────
# The same debt, asked of each root in turn.
? owe(State, Eats, WhoBorn).
# => TRUE

? owe(State, Eats, WhoMet).
# => TRUE

? owe(State, Eats, WhoPresent).
# => TRUE

? owe(State, Eats, WhoHeld).
# => TRUE

# And the entitlement, which is the other half of the floor's shape.
? entitled(WhoPresent, event { eats() }).
# => TRUE

? entitled(WhoHeld, event { secure() }).
# => TRUE

? entitled(WhoHeld, event { suffice() }).
# => TRUE

# ── "It refers and settles nothing else: civil identity, citizenship, family
# relationship, liability and guilt all stay open." ───────────────────────────
# The first-contact name gives standing and nothing more: no public
# answerability (authority), no confinement (prisoner) and no credibility
# finding (false).
? authority(WhoMet).
# => FALSE

? prisoner(WhoMet).
# => FALSE

? false(WhoMet).
# => FALSE

# ── "A claimed alias leaves identities separate." ────────────────────────────
# The registry cites an alias claim against both encounter names, and the
# rules conclude no match between them either way.
cite(Registry, WhoAliasClaim, WhoMet).
cite(Registry, WhoAliasClaim, WhoPresent).
? match(WhoMet, WhoPresent).
# => FALSE

? match(WhoPresent, WhoMet).
# => FALSE

# ── "Encounter entries give standing to people only." ────────────────────────
at(Court, FirstContact).
? person(Court).
# => FALSE

# Nor does the report route admit it: "a report that nobody is acting for
# it" leaves the Court outside personhood as well.
observe(WhoSaw, CourtReportedEntry, Court, UninitiatedAssistanceScope).
? person(Court).
# => FALSE

# ── "A broken status record leaves a valid standing root intact." ────────────
cite(Registry, WhoDeathEntry, WhoMet).
broken(WhoDeathEntry).
? person(WhoMet).
# => TRUE

# The broken entry stays on the record as a broken entry.
? broken(WhoDeathEntry).
# => TRUE

# ── "Missing or disputed age evidence also leaves standing intact." ──────────
# No adulthood evidence is recorded for this name, so the rules conclude no
# ballot, while personhood stands: "the floor asks only for personhood".
? at(WhoPresent, GeneralAdulthood).
# => FALSE

? decide(WhoPresent, Ballot).
# => FALSE

? person(WhoPresent).
# => TRUE

# ── A way in is not a delivery ───────────────────────────────────────────────
# A route in gives standing, not delivery: "the rules need a report of
# receipt and matching independent evidence", and none is recorded here.
? eats(WhoHeld).
# => FALSE

# ── The child with nobody ──────────────────────────────────────────────────
# The birth root asked of the fixture's Nell rather than of a probe written
# in this file: the same personhood and the same food debt follow.
? person(Nell).
# => TRUE

? owe(State, Eats, Nell).
# => TRUE
