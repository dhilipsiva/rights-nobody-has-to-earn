# ── Chapter 4 fidelity pins: "Whether It Arrived" ──────────────────────────
#
# KIND: CONTENT pin. Run:
#   ./verify.sh --only book-1/04-whether-it-arrived.pins.nibli
#   ./verify.sh          # all substantive pins and required contradiction checks
# Prose consistency is reviewed separately.
#
# The chapter's case lists tests/pins/records/child_with_nobody/fixture.nibli.
# Marisol, Provender and Ledgerwitness are fresh probe names.
#
# The delivery family's own coverage:
#   book-1/source/delivery-receipt.pins.nibli
#   tests/pins/delivery/received-outside-custody   every actuality for a person
#                                                   nobody convicted
#   book-1/source/counterfactual/undelivered-marker.pins.nibli
#   tests/pins/records/child_with_nobody/undelivered.pins.nibli
#
# WHAT FALSE MEANS HERE: a FALSE is pinned only where the KB could have said
# TRUE, and the comment says what would flip it.

:expect-pins 20

# "No food-delivery conclusion follows for Bela in the record": the delivery
# routes are dormant in the cast.
? eats(Bela).
# => FALSE

# "Shelter, care, material security and company lack recipient-side evidence
# for her as well": none of those delivery conclusions follows for Bela, and
# bodily safety (secure) has no receipt route at all.
? dwell(Bela).
# => FALSE

? healthy(Bela).
# => FALSE

? secure(Bela).
# => FALSE

? suffice(Bela).
# => FALSE

? meets(Bela).
# => FALSE

# "A record says that an item reached a particular person from a particular
# source. A witness authorised for that person, and independent of the
# provider, records seeing the same item reach the same person as the same kind
# of delivery."
receives(Marisol, FoodForMarisol, Provender).
# The receipt alone concludes nothing.
? eats(Marisol).
# => FALSE

# Add a witness authorised for Marisol, other than the provider, who records
# the same food reaching her as food: "the rules conclude that food reached
# Marisol".
authorized(Ledgerwitness, DeliveryWitness, Marisol).
observe(Ledgerwitness, FoodForMarisol, Marisol, FoodScope).
? eats(Marisol).
# => TRUE

# "Food receipt follows for Marisol while her personhood remains unshown for
# the name used".
? person(Marisol).
# => FALSE

# A food receipt is not a shelter receipt.
? dwell(Marisol).
# => FALSE

# "The witness must be someone other than the source."
receives(Marisol, ShelterForMarisol, Ledgerwitness).
observe(Ledgerwitness, ShelterForMarisol, Marisol, ShelterScope).
? dwell(Marisol).
# => FALSE

# "a care receipt paired with an observation recorded as food concludes nothing
# about care".
receives(Marisol, CareForMarisol, Provender).
observe(Ledgerwitness, CareForMarisol, Marisol, FoodScope).
? healthy(Marisol).
# => FALSE

# The child with nobody. "Nell is owed food, and Nell's record holds only the
# birth, so nothing in it concludes that food was received."
? owe(State, Eats, Nell).
# => TRUE

? eats(Nell).
# => FALSE

authorized(Ledgerwitness, DeliveryWitness, Nell).
receives(Nell, FoodForNell, Provender).
observe(Ledgerwitness, FoodForNell, Nell, FoodScope).
# "Suppose a receipt naming Nell were recorded, a witness other than the
# provider were authorised for Nell, and that witness's matching observation
# were entered. Food receipt then follows" — the authorisation is a supplied
# input: "The acting body owes that authorisation; the duty itself appoints
# nobody and vouches for nobody."
? eats(Nell).
# => TRUE

# "Food receipt then follows, and only food: shelter still needs evidence of
# its own".
? dwell(Nell).
# => FALSE

# The public bodies whose duty a delivery discharges cannot witness it: not the
# State or the common tier, and not a region or locality a presence witness
# records for the person.
authorized(MarisolClerk, FloorPresenceWitness, Marisol).
observe(MarisolClerk, Marisol, MarisolRegion, FloorPresenceRegionScope).
authorized(MarisolRegion, DeliveryWitness, Marisol).
receives(Marisol, CompanyForMarisol, Provender).
observe(MarisolRegion, CompanyForMarisol, Marisol, CompanyScope).
? meets(Marisol).
# => FALSE

# "Learning has a distinct route through teaching that was heard." A hearing
# entry alone concludes nothing; the teaching it heard completes the route.
hears(Listenera, Speakera).
? learn(Listenera).
# => FALSE

teaches(Speakera, Listenera).
? learn(Listenera).
# => TRUE

# "nothing confines Nell": with the receipt, the witness and the food
# conclusion recorded, the rules still conclude no custody for the child.
? prisoner(Nell).
# => FALSE
