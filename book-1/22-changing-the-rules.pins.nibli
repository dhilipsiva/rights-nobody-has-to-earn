:require test -z "$(awk -F'->' '/^[^#]/ && /->/ && $1 ~ /become/ {print}' book-1/source/constitution.nibli)"
:require test -n "$(awk -F'->' '/^[^#]/ && /->/ && $1 ~ /prisoner/ {print}' book-1/source/constitution.nibli)"

? suggest(Assembly, Amend_Mint).
# => TRUE

? become(Amend_Mint, Law).
# => FALSE

? ratifies(Electorate, Amend_Floor).
# => TRUE

? adjust(Amend_Floor, Art_Floor).
# => TRUE

? permanent(Art_Floor).
# => TRUE

? false(Amend_Floor).
# => FALSE

? become(Amend_Floor, Law).
# => FALSE

? permanent(Art_Entrench).
# => TRUE

? adjust(Amend_Meta, Art_Entrench).
# => TRUE

? false(Amend_Meta).
# => FALSE

? become(Amend_Meta, Law).
# => FALSE

? permanent(Art_Person).
# => TRUE

? permanent(Art_Evidence).
# => FALSE

suggest(Assembly, Amend_Sneak).
ratifies(Electorate, Amend_Sneak).

? false(Amend_Sneak).
# => FALSE

? become(Amend_Sneak, Law).
# => FALSE

suggest(Assembly, Amend_Decoy).
ratifies(Electorate, Amend_Decoy).
adjust(Amend_Decoy, Art_Mint).

? permanent(Art_Mint).
# => FALSE

? adjust(Amend_Decoy, Art_Mint).
# => TRUE

? adjust(Amend_Decoy, Art_Floor).
# => FALSE

? false(Amend_Decoy).
# => FALSE

? become(Amend_Decoy, Law).
