observe(CustodyIntakeAudit, Case_Zed, ReconciledPrimaryAlternateAndSubjectHeldFilingsBeforeEachRenewal, CustodyIntakeReconciliationScope).
observe(CustodyIntake, Case_Zed, NoHolderPermissionNoRetaliationAndImmediateSuspensionOnFiling, CustodyIntakeProtectionScope).
observe(CustodyIntakeAudit, Case_Zed, NoHolderPermissionNoRetaliationAndImmediateSuspensionOnFiling, CustodyIntakeProtectionScope).


# The injury entry written above is in the record. Custody needs far more
# than that entry: "an injury and a general judgment would be too little".
? injure(Zed, Ivo).
# => TRUE

# Zed's prisoner conclusion follows from the full witnessed custody case.
? prisoner(Zed).
# => TRUE

# "From the case alone the rules conclude that Zed is a prisoner and
# therefore a person" — no personhood entry for Zed is written.
? person(Zed).
# => TRUE

# "the State owes Zed every floor item": each debt is queried rather than
# sampled, because a universal fails at the item left out. This file runs
# Zed's T3 custody-to-person chain, every itemised debt, and the floor
# entitlement from that derived standing in one process.
? owe(State, Eats, Zed).
# => TRUE

? owe(State, Dwell, Zed).
# => TRUE

? owe(State, Healthy, Zed).
# => TRUE

? owe(State, Learn, Zed).
# => TRUE

? owe(State, Secure, Zed).
# => TRUE

? owe(State, Suffice, Zed).
# => TRUE

? owe(State, Expresses, Zed).
# => TRUE

? owe(State, Believe, Zed).
# => TRUE

? owe(State, Meets, Zed).
# => TRUE

# (Owed, not delivered — evidence of delivery is Chapter 4's subject.)
? eats(Zed).
# => FALSE

# "The conclusion that Zed may move freely is absent: movement is what the
# sentence takes."
? travel(Zed).
# => FALSE

# The firewall, which the chapter shows depends on the personhood line:
# each refused rule would confine a person whose record is silent about
# belief, or about a meal. The engine will not load it, since custody would
# then depend on its own consequence, and "that loop is what is refused".
:refuse reasoning /'prisoner' -> 'believe'/
all $x: person($x) & ~believe($x) -> prisoner($x).

:refuse reasoning /'prisoner' -> 'eats'/
all $x: person($x) & ~eats($x) -> prisoner($x).

# and the non-floor control, so the refusals above mean something
# `:accept-scoped` loads the statement, reports whether it loaded, then retracts
# it — so this control cannot widen the base for anything below it, and where a
# query sits relative to the accepts stops mattering. Measured on this file: with
# a plain `:accept` here, a `? prisoner(Quin).` added below answers TRUE — Quin
# has no conviction, only no home — and with `:accept-scoped` the same query
# answers FALSE. Keep the scoped form. The engine loads this rule; it is "a
# check of the written rules" that rejects such a rule in the constitution.
:accept-scoped
all $x: person($x) & ~home($x) -> prisoner($x).

# Hano, convicted, stays owed expression, but the query asks for speech made:
# the record holds no speech by Hano, so the rules conclude none.
? expresses(Hano).
# => FALSE

# ── THE SECOND DOOR. free(Nemo) is a ground fact and persists; no later
# section asks about Nemo ─────────────────────────────────────────────────────
# "A release entry needs nobody to have found anything". One write, a name the
# record has never held, and a person exists — never listed, never judged,
# released from a sentence that never existed. Chapter 2's suite pins the same
# door through Wraith as an entry the record may hold; this file pins it as a
# root of standing beside custody.
free(Nemo).

# From that entry alone the rules conclude a person, owed food and free to
# move, who is no prisoner: "a name that only a release entry mentions is a
# person, owed food and free to move, with no custody case behind it."
? person(Nemo).
# => TRUE

? prisoner(Nemo).
# => FALSE

? travel(Nemo).
# => TRUE

? owe(State, Eats, Nemo).
# => TRUE

# The T3 custody chain derives Zed's standing; the floor must remain open.
? entitled(Zed, event { eats() }).
# => TRUE

# ── The child with nobody ──────────────────────────────────────────────────
# The pair, run side by side. Custody holds Zed and not the child, yet each
# query here answers FALSE: neither record holds a shelter receipt or speech,
# so "the rules conclude shelter received and speech made for neither person".
? dwell(Zed).
# => FALSE

? expresses(Zed).
# => FALSE

? dwell(Nell).
# => FALSE

? expresses(Nell).
# => FALSE

# "Zed and Nell are both owed shelter and expression", and "the debts are
# identical".
? owe(State, Dwell, Zed).
# => TRUE

? owe(State, Dwell, Nell).
# => TRUE

? owe(State, Expresses, Zed).
# => TRUE

? owe(State, Expresses, Nell).
# => TRUE

# The custody conclusions differ; neither establishes outside public action.
? prisoner(Zed).
# => TRUE

? prisoner(Nell).
# => FALSE

# ── THE SAME COMPARISON WITH EQUIVALENT EVIDENCE. MUST BE LAST: ground facts
# persist ─────────────────────────────────────────────────────────────────────
# Everything above compares two people whose records differ. Here the child
# gets the evidence the receipt route asks of anybody: a receipt, a witness
# authorised for Nell, and a witness who is not the provider. Custody supplies
# none of these, which is why Zed's shelter stays unconcluded above:
# "Witnessed delivery is independent of sentence authority."
authorized(ChildWitness, DeliveryWitness, Nell).
receives(Nell, ShelterForNell, ShelterProviderForNell).
observe(ChildWitness, ShelterForNell, Nell, ShelterScope).

? dwell(Nell).
# => TRUE

# The same route, the same person, for food.
receives(Nell, FoodForNell, FoodProviderForNell).
observe(ChildWitness, FoodForNell, Nell, FoodScope).

? eats(Nell).
# => TRUE

# And nothing else about the child moved. The receipt is evidence of receipt and
# is not a finding, a status, or a reason to act on anybody.
? person(Nell).
# => TRUE

? prisoner(Nell).
# => FALSE

? false(Nell).
# => FALSE

? owe(State, Dwell, Nell).
# => TRUE
