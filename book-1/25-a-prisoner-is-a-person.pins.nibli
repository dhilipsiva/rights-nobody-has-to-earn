observe(PlacementReview, Placement_Case_Zed, IndividuallyNecessaryLeastRestrictivePlacementAndContinuity, CustodyPlacementNecessityScope).
observe(State, Placement_Case_Zed, NoSuitableConsentingHomeAvailableAndOrdinarySupportedResidenceSecured, CustodyPlacementAlternativeScope).
observe(PlacementReview, Placement_Case_Zed, NoSuitableConsentingHomeAvailableAndOrdinarySupportedResidenceSecured, CustodyPlacementAlternativeScope).
authorized(CustodyIntake, CustodyIntakeAuthority, Case_Zed).
authorized(CustodyIntakeAudit, IndependentCustodyIntakeAuditor, Case_Zed).
observe(CustodyIntake, Case_Zed, Zed, CustodyIntakeSubjectScope).
observe(CustodyIntakeAudit, Case_Zed, Zed, CustodyIntakeSubjectScope).
observe(CustodyIntake, Case_Zed, Case_Zed, CustodyIntakeCaseScope).
observe(CustodyIntakeAudit, Case_Zed, Case_Zed, CustodyIntakeCaseScope).
