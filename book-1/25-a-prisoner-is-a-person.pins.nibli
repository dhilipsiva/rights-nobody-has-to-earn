observe(PlacementReview, Placement_Case_Zed, Case_Zed, CustodyPlacementLeaseScope).
observe(State, Placement_Case_Zed, Window_Custody, CustodyPlacementWindowScope).
observe(PlacementReview, Placement_Case_Zed, Window_Custody, CustodyPlacementWindowScope).
