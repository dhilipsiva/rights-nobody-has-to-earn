observe(CustodyIntakeAudit, Case_Voss, NoHolderPermissionNoRetaliationAndImmediateSuspensionOnFiling, CustodyIntakeProtectionScope).


# Gia, seated by the electorate, holds the review body's authority to sign,
# and Wren, seated by the convocation, holds the tribunal's: "an electorate
# seating gives the review body's authority, and a convocation seating gives
# the tribunal's".
? choose(Electorate, Gia).
# => TRUE

? permits(Review, Gia).
# => TRUE

? permits(Tribunal, Wren).
# => TRUE

# Each route gives its own authority to sign: Gia's witnessed clear history
# gives the review body's and not the tribunal's, because the convocation
# did not seat Gia. "An examiner seated only by the electorate holds the
# first and lacks the second."
? permits(Tribunal, Gia).
# => FALSE

# "A separate test tries to give someone the review body's authority to sign
# by entering it directly. The attempt is refused."
:refuse reasoning /declared derived-only/
permits(Review, Sock).

# Tove is seated by the electorate and recalled (broken). "A recalled
# official stays answerable and loses the authority": Tove keeps public
# answerability (authority) and lacks the review body's authority to sign.
? choose(Electorate, Tove).
# => TRUE

? broken(Tove).
# => TRUE

? authority(Tove).
# => TRUE

? permits(Review, Tove).
# => FALSE

# "Mael is seated by the electorate and under a finding in force, and a
# restriction recorded in an earlier version and kept in the version in
# force separately withholds Mael's authority to sign".
? choose(Electorate, Mael).
# => TRUE

? rotten(Mael).
# => TRUE

? permits(Review, Mael).
# => FALSE

# Nia's custody case is recorded with its merits, placement, intake and
# current review, so the relief verdict below answers a real case; the
# injury and the court's judgment are pinned first.
? injure(Nia, Ivo).
# => TRUE

? judge(Court, Nia).
# => TRUE

# The record also holds a raw clearing entry and a generic judgment by the
# appeals body naming Nia: "A raw clearing entry or a generic judgment by the
# appeals body is a different thing" from the order that gives relief.
? clear(Nia).
# => TRUE

? judge(Appeals, Nia).
# => TRUE

# The relief rests on the properly made appellate order for Nia's case in
# the record, which quashes the conviction without retrial: the appeals
# body's relief for Nia holds, and the rules conclude no custody for Nia.
? permits(Appeals, Nia).
# => TRUE

? prisoner(Nia).
# => FALSE

# ── A raw clearing entry gives no relief ───────────────────────────────────
# Adam's custody case is complete, and the test adds only a raw clearing
# entry, which names no author, case or purpose. No relief follows, custody
# stands and the rules conclude no free movement for Adam; if the entry
# alone gave relief, each of these verdicts would flip.
clear(Adam).

? permits(Appeals, Adam).
# => FALSE

? prisoner(Adam).
# => TRUE

? travel(Adam).
# => FALSE

# ── A generic appeals judgment gives no relief either ──────────────────────
# Voss's custody case is complete. "Missing relief alone confines nobody":
# custody rests on the case's own merits, placement and current authority,
# recorded above and below.
person(Voss).
injure(Voss, Ivo).
judge(Court, Voss).
# T3 fixture: the judgment names one case and the current review binds that
# exact case, person, Court, custody authority, window, and renewal.
cite(Court, Case_Voss, Voss).
observe(Chronicle, Case_Voss, Voss, CaseScope).
observe(TemporalReview, Case_Voss, Voss, CaseScope).
observe(Chronicle, Case_Voss, Court, HolderScope).
observe(TemporalReview, Case_Voss, Court, HolderScope).
observe(Chronicle, Case_Voss, CourtJudgment, JudgmentScope).
observe(TemporalReview, Case_Voss, CourtJudgment, JudgmentScope).
observe(Chronicle, Case_Voss, Ivo, InjuryVictimScope).
observe(TemporalReview, Case_Voss, Ivo, InjuryVictimScope).
authorized(Case_Voss, ActiveCustody, Case_Voss).
observe(Chronicle, Case_Voss, ActiveCustody, PowerScope).
observe(TemporalReview, Case_Voss, ActiveCustody, PowerScope).
observe(Chronicle, Case_Voss, Case_Voss, CaseBindingScope).
observe(TemporalReview, Case_Voss, Case_Voss, CaseBindingScope).
limit(Case_Voss, Case_Voss, Window_Custody).
observe(Chronicle, Case_Voss, Window_Custody, LimitScope).
observe(TemporalReview, Case_Voss, Window_Custody, LimitScope).
continue(Case_Voss, Epoch_Current).
observe(Chronicle, Case_Voss, Epoch_Current, RenewalScope).
observe(TemporalReview, Case_Voss, Epoch_Current, RenewalScope).
endorses(Electorate, Case_Voss).
endorses(TemporalReview, Case_Voss).

? prisoner(Voss).
# => TRUE

# The test adds a generic judgment by the appeals body naming Voss.
# The judgment names a body and person, not a case, purpose, act or writer,
# so "the rules still conclude custody for a person whose custody case is
# otherwise complete and whose only relief entries are those."
judge(Appeals, Voss).

? permits(Appeals, Voss).
# => FALSE

? prisoner(Voss).
# => TRUE

# ── The limits of a finding ─────────────────────────────────────────────────────
# No rule concludes recognition (reward) or a loss of points (lose with
# Points), so the FALSE pins on them confirm that a finding brings neither.
# The case credibility/counterfactual-blanket-recognition-loss adds such
# rules explicitly and shows the blanket penalty they would impose.

# "Bela's completed credibility case remains in force." The rules still
# conclude that Bela is a person with free movement and the ballot, entitled
# to food and owed it by the State, and conclude no custody. No recognition
# follows, and "Nothing is recorded as lost".
? false(Bela).
# => TRUE

? reward(Bela).
# => FALSE

? lose(Points, Bela).
# => FALSE

? person(Bela).
# => TRUE

? travel(Bela).
# => TRUE

? prisoner(Bela).
# => FALSE

? decide(Bela, Ballot).
# => TRUE

? entitled(Bela, event { eats() }).
# => TRUE

? owe(State, Eats, Bela).
# => TRUE

# Being owed food is a separate fact from receiving it. The record shows no
# food or shelter received by Bela, and no food received by Jala, against
# whom no finding is recorded.
? eats(Bela).
# => FALSE

? dwell(Bela).
# => FALSE

? eats(Jala).
# => FALSE

# Bela taught Cira, and "Being taught confers no recognition status,
# transfers no fraud and imposes no debt on Cira": no finding against Cira
# follows, no recognition follows, and nothing is recorded as lost.
? teaches(Bela, Cira).
# => TRUE

? lose(Points, Cira).
# => FALSE

? reward(Cira).
# => FALSE

? false(Cira).
# => FALSE

# Esa teaches Fin, whom no record makes a person; no finding against Esa
# follows, and nothing is recorded against Fin as lost.
? teaches(Esa, Fin).
# => TRUE

? person(Fin).
# => FALSE

? false(Esa).
# => FALSE

? lose(Points, Fin).
# => FALSE

# Edo is under a finding in force for deceiving Mira; nothing is recorded as
# lost against Edo, or against Mira.
? false(Edo).
# => TRUE

? lose(Points, Edo).
# => FALSE

? lose(Points, Mira).
# => FALSE

# Mael's earlier restriction, reported and kept in the version in force,
# withholds the authority to sign, and Mael is under a finding in force.
# Nothing is recorded as lost, and "Mael stays publicly answerable".
? rotten(Mael).
# => TRUE

? false(Mael).
# => TRUE

? lose(Points, Mael).
# => FALSE

? permits(Review, Mael).
# => FALSE

? authority(Mael).
# => TRUE

# A general finding does not determine unrelated care, wages or insurance.
work(Bela, UnrelatedCare).
? work(Bela, UnrelatedCare).
# => TRUE
promise(Foundry, Wage, Bela).
authorized(Steward, CompensationAttester, Bela).
observe(Steward, Wage, Bela, LabourBasis).
observe(Steward, Foundry, Bela, LabourBasis).
? provide(Foundry, Wage, Bela).
# => TRUE
pay(Bela, Contribution, Ledgerhouse, SchemeM).
authorized(Assay, InsuranceAdjudicator, Bela).
observe(Assay, Illness, Bela, SchemeM).
? insure(Ledgerhouse, Bela, Illness).
# => TRUE
# A finding on a different compensation basis does not remove this wage.
observe(Court, CompensationFraud, Bela, OtherBasis).
? provide(Foundry, Wage, Bela).
# => TRUE
# A court finding on the labour basis the attester recorded stops the wage
# conclusion and yields restitution from Bela to Foundry, while the illness
# supplement and the food debt remain: "Each consequence answers to a
# finding about its own basis".
observe(Court, CompensationFraud, Bela, LabourBasis).
? provide(Foundry, Wage, Bela).
# => FALSE
? provide(Bela, Restitution, Foundry).
# => TRUE
? insure(Ledgerhouse, Bela, Illness).
# => TRUE
? owe(State, Eats, Bela).
# => TRUE
# Mael is under a finding in force, so the appeals body owes a review of the
# continuing restriction "without having to ask".
? obliged(Appeals, ReviewContinuingCredibilityRestriction, Mael).
# => TRUE

# The test adds a forgiveness flag from the appeals body naming Mael, and
# the finding stays in force.
forgive(Appeals, Mael).

? false(Mael).
# => TRUE

# The test adds a generic judgment by the appeals body naming Mael as well,
# and no restoration follows: "A generic judgment and a forgiveness flag
# restore nothing."
judge(Appeals, Mael).

? clean(Mael).
# => FALSE
? false(Mael).
# => TRUE

# The test records the particular appellate act for Mael's finding: its
# purpose, evidence and procedure, the tribunal's independent review, each
# actor's eligibility at the decision, and its place between the finding
# and the version in force.
list(Restore_Mael_Recognition, Mael, Credibility_Mael_Finding, CredibilityRestoration).
list(Restore_Mael_Recognition, RestoreCredibilityFinding, Evidence_Restore_Mael_Recognition, CredibilityAppealPurposeEvidence).
judge(Appeals, Restore_Mael_Recognition).
judge(Tribunal, Restore_Mael_Recognition).
authorized(Appeals, CredibilityAppellateDisposition, Restore_Mael_Recognition).
authorized(Tribunal, IndependentCredibilityAppealReview, Restore_Mael_Recognition).
observe(Appeals, Restore_Mael_Recognition, Mael, CredibilityAppealSubjectScope).
observe(Appeals, Restore_Mael_Recognition, Credibility_Mael_Finding, CredibilityAppealFindingScope).
observe(Appeals, Restore_Mael_Recognition, RestoreCredibilityFinding, CredibilityAppealPurposeScope).
observe(Appeals, Restore_Mael_Recognition, Evidence_Restore_Mael_Recognition, CredibilityAppealEvidenceScope).
observe(Appeals, Restore_Mael_Recognition, NoticeEvidenceAccessHearingAndReasons, CredibilityAppealProcedureScope).
observe(Tribunal, Restore_Mael_Recognition, Mael, CredibilityAppealSubjectScope).
observe(Tribunal, Restore_Mael_Recognition, Credibility_Mael_Finding, CredibilityAppealFindingScope).
observe(Tribunal, Restore_Mael_Recognition, RestoreCredibilityFinding, CredibilityAppealPurposeScope).
observe(Tribunal, Restore_Mael_Recognition, Evidence_Restore_Mael_Recognition, CredibilityAppealEvidenceScope).
observe(Tribunal, Restore_Mael_Recognition, NoticeEvidenceAccessHearingAndReasons, CredibilityAppealProcedureScope).
observe(Chronicle, Restore_Mael_Recognition, Appeals, CredibilityAppealActorEligibleAtDecisionScope).
observe(TemporalReview, Restore_Mael_Recognition, Appeals, CredibilityAppealActorEligibleAtDecisionScope).
observe(Chronicle, Restore_Mael_Recognition, Tribunal, CredibilityAppealReviewActorEligibleAtDecisionScope).
observe(TemporalReview, Restore_Mael_Recognition, Tribunal, CredibilityAppealReviewActorEligibleAtDecisionScope).
list(Order_Before_Restore_Mael_Recognition, Credibility_Mael_Finding, Restore_Mael_Recognition, RecordSequence).
observe(Chronicle, Order_Before_Restore_Mael_Recognition, Credibility_Mael_Finding, RecordStartScope).
observe(Chronicle, Order_Before_Restore_Mael_Recognition, Restore_Mael_Recognition, RecordEndScope).
observe(TemporalReview, Order_Before_Restore_Mael_Recognition, Credibility_Mael_Finding, RecordStartScope).
observe(TemporalReview, Order_Before_Restore_Mael_Recognition, Restore_Mael_Recognition, RecordEndScope).
list(Order_After_Restore_Mael_Recognition, Restore_Mael_Recognition, Epoch_Current, RecordSequence).
observe(Chronicle, Order_After_Restore_Mael_Recognition, Restore_Mael_Recognition, RecordStartScope).
observe(Chronicle, Order_After_Restore_Mael_Recognition, Epoch_Current, RecordEndScope).
observe(TemporalReview, Order_After_Restore_Mael_Recognition, Restore_Mael_Recognition, RecordStartScope).
observe(TemporalReview, Order_After_Restore_Mael_Recognition, Epoch_Current, RecordEndScope).

# With that act recorded, "the personal finding ends", and nothing is
# granted or recorded as lost. The earlier restriction is still reported,
# so "the authority to sign stays withheld".
? clean(Mael).
# => TRUE

? false(Mael).
# => FALSE

? lose(Points, Mael).
# => FALSE

? permits(Review, Mael).
# => FALSE

? reward(Mael).
# => FALSE

? rotten(Mael).
# => TRUE

# Once the finding is restored, "the duty to review its continuation ends
# with it".
? obliged(Appeals, ReviewContinuingCredibilityRestriction, Mael).
# => FALSE

# Admitted as a word of the record, lose is still a conclusion only the
# rules may reach: a statement that enters a loss directly is refused in any
# form, and nothing in it loads, so Loss_Probe does not become a person.
:accept
admits("lose").

:refuse reasoning /`lose` is declared derived-only/
person(Loss_Probe) & lose(Points, Loss_Probe).

? person(Loss_Probe).
# => FALSE

:refuse reasoning /`lose` is declared derived-only/
lose(Points, Ghost, Case).

# ── Credibility findings: the paired finding and its reach ──────────────────────
# Cases use the actual constitution and the declared no-dead-conjuncts variant.

# Bela: the two appointments and the particular completed case.
? permits(Review, Gia).
# => TRUE

? permits(Tribunal, Saba).
# => TRUE

? judge(Gia, Credibility_Bela_Finding).
# => TRUE

? capture(Gia, Bela, Credibility_Bela_Incident).
# => TRUE

? judge(Saba, Credibility_Bela_Finding).
# => TRUE

? capture(Saba, Bela, Credibility_Bela_Incident).
# => TRUE

? false(Bela).
# => TRUE

# Koa: documentation alone supplies neither judgment nor appointment.
? capture(Koa, Esa).
# => TRUE

? judge(Koa, Esa).
# => FALSE

? permits(Review, Koa).
# => FALSE

? false(Esa).
# => FALSE

# Parent/child judgment alone imposes no personal credibility finding.
? parent(Dev, Esa).
# => TRUE

? judge(Dev, Esa).
# => TRUE

? false(Dev).
# => FALSE

# Edo: the case identifies whose deceit was adjudicated; Mira is untouched.
? deceive(Edo, Mira).
# => TRUE

? false(Mira).
# => FALSE

? false(Edo).
# => TRUE

# The record holds a proposal against Tyr by Mael, whose earlier restriction
# is reported, and Wren, who holds the tribunal's authority to sign. Mael's
# signature cannot count and no completed case exists, so no finding
# against Tyr follows.
? rotten(Mael).
# => TRUE

? permits(Tribunal, Wren).
# => TRUE

? false(Tyr).
# => FALSE

# Prospective cases: each new signer has a fully witnessed current clearance.
authorized(Sirefa, ClearStatus, Epoch_Previous).
observe(Chronicle, Sirefa, Epoch_Previous, ClearScope).
observe(TemporalReview, Sirefa, Epoch_Previous, ClearScope).
carries(Chronicle, Sirefa, Epoch_Current, Epoch_Previous, ClearCarry).
carries(TemporalReview, Sirefa, Epoch_Current, Epoch_Previous, ClearCarry).
authorized(Scionfa, ClearStatus, Epoch_Previous).
observe(Chronicle, Scionfa, Epoch_Previous, ClearScope).
observe(TemporalReview, Scionfa, Epoch_Previous, ClearScope).
carries(Chronicle, Scionfa, Epoch_Current, Epoch_Previous, ClearCarry).
carries(TemporalReview, Scionfa, Epoch_Current, Epoch_Previous, ClearCarry).
authorized(Unrela, ClearStatus, Epoch_Previous).
observe(Chronicle, Unrela, Epoch_Previous, ClearScope).
observe(TemporalReview, Unrela, Epoch_Previous, ClearScope).
carries(Chronicle, Unrela, Epoch_Current, Epoch_Previous, ClearCarry).
carries(TemporalReview, Unrela, Epoch_Current, Epoch_Previous, ClearCarry).
authorized(Unrelb, ClearStatus, Epoch_Previous).
observe(Chronicle, Unrelb, Epoch_Previous, ClearScope).
observe(TemporalReview, Unrelb, Epoch_Previous, ClearScope).
carries(Chronicle, Unrelb, Epoch_Current, Epoch_Previous, ClearCarry).
carries(TemporalReview, Unrelb, Epoch_Current, Epoch_Previous, ClearCarry).
authorized(Ambi, ClearStatus, Epoch_Previous).
observe(Chronicle, Ambi, Epoch_Previous, ClearScope).
observe(TemporalReview, Ambi, Epoch_Previous, ClearScope).
carries(Chronicle, Ambi, Epoch_Current, Epoch_Previous, ClearCarry).
carries(TemporalReview, Ambi, Epoch_Current, Epoch_Previous, ClearCarry).
authorized(Edo, ClearStatus, Epoch_Previous).
observe(Chronicle, Edo, Epoch_Previous, ClearScope).
observe(TemporalReview, Edo, Epoch_Previous, ClearScope).
carries(Chronicle, Edo, Epoch_Current, Epoch_Previous, ClearCarry).
carries(TemporalReview, Edo, Epoch_Current, Epoch_Previous, ClearCarry).
authorized(Partnr, ClearStatus, Epoch_Previous).
observe(Chronicle, Partnr, Epoch_Previous, ClearScope).
observe(TemporalReview, Partnr, Epoch_Previous, ClearScope).
carries(Chronicle, Partnr, Epoch_Current, Epoch_Previous, ClearCarry).
carries(TemporalReview, Partnr, Epoch_Current, Epoch_Previous, ClearCarry).
authorized(Mara, ClearStatus, Epoch_Previous).
observe(Chronicle, Mara, Epoch_Previous, ClearScope).
observe(TemporalReview, Mara, Epoch_Previous, ClearScope).
carries(Chronicle, Mara, Epoch_Current, Epoch_Previous, ClearCarry).
carries(TemporalReview, Mara, Epoch_Current, Epoch_Previous, ClearCarry).
authorized(Maro, ClearStatus, Epoch_Previous).
observe(Chronicle, Maro, Epoch_Previous, ClearScope).
observe(TemporalReview, Maro, Epoch_Previous, ClearScope).
carries(Chronicle, Maro, Epoch_Current, Epoch_Previous, ClearCarry).
carries(TemporalReview, Maro, Epoch_Current, Epoch_Previous, ClearCarry).
authorized(Una, ClearStatus, Epoch_Previous).
observe(Chronicle, Una, Epoch_Previous, ClearScope).
observe(TemporalReview, Una, Epoch_Previous, ClearScope).
carries(Chronicle, Una, Epoch_Current, Epoch_Previous, ClearCarry).
carries(TemporalReview, Una, Epoch_Current, Epoch_Previous, ClearCarry).
authorized(Uno, ClearStatus, Epoch_Previous).
observe(Chronicle, Uno, Epoch_Previous, ClearScope).
observe(TemporalReview, Uno, Epoch_Previous, ClearScope).
carries(Chronicle, Uno, Epoch_Current, Epoch_Previous, ClearCarry).
carries(TemporalReview, Uno, Epoch_Current, Epoch_Previous, ClearCarry).

# The parent/child relationship between signers is the live exclusion.
choose(Electorate, Sirefa).
choose(Convocation, Scionfa).
parent(Sirefa, Scionfa).
judge(Sirefa, Targ).
capture(Sirefa, Targ).
judge(Scionfa, Targ).
capture(Scionfa, Targ).
cite(Sirefa, CredibilityGroundDeceit, Targ).
cite(Scionfa, CredibilityGroundDeceit, Targ).

# Each of the pair holds the authority to sign, so the family tie is what
# stops their proposal.
? permits(Review, Sirefa).
# => TRUE

? permits(Tribunal, Scionfa).
# => TRUE

# They "record every other element of a proposal on the ground of deceit"
# against Targ. The agree query, for a CredibilityFindingCandidate, asks
# whether the proposal is properly made: it is not, and no finding follows.
list(Finding_Targ, Targ, Incident_Targ, CredibilityFinding).
list(Finding_Targ, CredibilityGroundDeceit, Evidence_Finding_Targ, CredibilityGroundEvidence).
judge(Sirefa, Finding_Targ).
capture(Sirefa, Targ, Incident_Targ).
cite(Sirefa, CredibilityGroundDeceit, Finding_Targ).
authorized(Sirefa, IndependentReviewer, Finding_Targ).
observe(Sirefa, Finding_Targ, Targ, CredibilitySubjectScope).
observe(Sirefa, Finding_Targ, Incident_Targ, CredibilityIncidentScope).
observe(Sirefa, Finding_Targ, CredibilityGroundDeceit, CredibilityGroundScope).
observe(Sirefa, Finding_Targ, Evidence_Finding_Targ, CredibilityEvidenceScope).
observe(Sirefa, Finding_Targ, NoticeEvidenceAccessHearingAndReasons, CredibilityProcedureScope).
judge(Scionfa, Finding_Targ).
capture(Scionfa, Targ, Incident_Targ).
cite(Scionfa, CredibilityGroundDeceit, Finding_Targ).
authorized(Scionfa, IndependentReviewer, Finding_Targ).
observe(Scionfa, Finding_Targ, Targ, CredibilitySubjectScope).
observe(Scionfa, Finding_Targ, Incident_Targ, CredibilityIncidentScope).
observe(Scionfa, Finding_Targ, CredibilityGroundDeceit, CredibilityGroundScope).
observe(Scionfa, Finding_Targ, Evidence_Finding_Targ, CredibilityEvidenceScope).
observe(Scionfa, Finding_Targ, NoticeEvidenceAccessHearingAndReasons, CredibilityProcedureScope).
? agree(Finding_Targ, CredibilityFindingCandidate).
# => FALSE
? false(Targ).
# => FALSE

# Unrelated control: permission first, personal effect only from completed history.
choose(Electorate, Unrela).
choose(Convocation, Unrelb).
judge(Unrela, Targo).
capture(Unrela, Targo).
judge(Unrelb, Targo).
capture(Unrelb, Targo).
cite(Unrela, CredibilityGroundDeceit, Targo).
cite(Unrelb, CredibilityGroundDeceit, Targo).
authorized(Unrela, IndependentReviewer, Targo).
authorized(Unrelb, IndependentReviewer, Targo).

list(Finding_Targo, Targo, Incident_Targo, CredibilityFinding).
list(Finding_Targo, CredibilityGroundDeceit, Evidence_Finding_Targo, CredibilityGroundEvidence).
judge(Unrela, Finding_Targo).
capture(Unrela, Targo, Incident_Targo).
cite(Unrela, CredibilityGroundDeceit, Finding_Targo).
authorized(Unrela, IndependentReviewer, Finding_Targo).
observe(Unrela, Finding_Targo, Targo, CredibilitySubjectScope).
observe(Unrela, Finding_Targo, Incident_Targo, CredibilityIncidentScope).
observe(Unrela, Finding_Targo, CredibilityGroundDeceit, CredibilityGroundScope).
observe(Unrela, Finding_Targo, Evidence_Finding_Targo, CredibilityEvidenceScope).
observe(Unrela, Finding_Targo, NoticeEvidenceAccessHearingAndReasons, CredibilityProcedureScope).
judge(Unrelb, Finding_Targo).
capture(Unrelb, Targo, Incident_Targo).
cite(Unrelb, CredibilityGroundDeceit, Finding_Targo).
authorized(Unrelb, IndependentReviewer, Finding_Targo).
observe(Unrelb, Finding_Targo, Targo, CredibilitySubjectScope).
observe(Unrelb, Finding_Targo, Incident_Targo, CredibilityIncidentScope).
observe(Unrelb, Finding_Targo, CredibilityGroundDeceit, CredibilityGroundScope).
observe(Unrelb, Finding_Targo, Evidence_Finding_Targo, CredibilityEvidenceScope).
observe(Unrelb, Finding_Targo, NoticeEvidenceAccessHearingAndReasons, CredibilityProcedureScope).
? agree(Finding_Targo, CredibilityFindingCandidate).
# => TRUE
? false(Targo).
# => FALSE
# Completed history: both witnesses record each signer's eligibility at the
# decision and the finding's place before the version in force. The judgment
# is complete (responsible), and the finding against Targo follows.
observe(Chronicle, Finding_Targo, Unrela, CredibilityReviewSignerEligibleAtDecisionScope).
observe(TemporalReview, Finding_Targo, Unrela, CredibilityReviewSignerEligibleAtDecisionScope).
observe(Chronicle, Finding_Targo, Unrelb, CredibilityTribunalSignerEligibleAtDecisionScope).
observe(TemporalReview, Finding_Targo, Unrelb, CredibilityTribunalSignerEligibleAtDecisionScope).
list(Order_Finding_Targo, Finding_Targo, Epoch_Current, RecordSequence).
observe(Chronicle, Order_Finding_Targo, Finding_Targo, RecordStartScope).
observe(Chronicle, Order_Finding_Targo, Epoch_Current, RecordEndScope).
observe(TemporalReview, Order_Finding_Targo, Finding_Targo, RecordStartScope).
observe(TemporalReview, Order_Finding_Targo, Epoch_Current, RecordEndScope).
? responsible(Finding_Targo, CredibilityFinding).
# => TRUE
? false(Targo).
# => TRUE

# One holder of two appointments is still one signer.
choose(Electorate, Ambi).
choose(Convocation, Ambi).
judge(Ambi, Solo).
capture(Ambi, Solo).
cite(Ambi, CredibilityGroundDeceit, Solo).
authorized(Ambi, IndependentReviewer, Solo).
authorized(Ambi, IndependentReviewer, Solo).

# Ambi holds both authorities and records every element twice, yet "one
# person counts as one signer, and nothing follows".
? permits(Review, Ambi).
# => TRUE

? permits(Tribunal, Ambi).
# => TRUE

list(Finding_Solo, Solo, Incident_Solo, CredibilityFinding).
list(Finding_Solo, CredibilityGroundDeceit, Evidence_Finding_Solo, CredibilityGroundEvidence).
judge(Ambi, Finding_Solo).
capture(Ambi, Solo, Incident_Solo).
cite(Ambi, CredibilityGroundDeceit, Finding_Solo).
authorized(Ambi, IndependentReviewer, Finding_Solo).
observe(Ambi, Finding_Solo, Solo, CredibilitySubjectScope).
observe(Ambi, Finding_Solo, Incident_Solo, CredibilityIncidentScope).
observe(Ambi, Finding_Solo, CredibilityGroundDeceit, CredibilityGroundScope).
observe(Ambi, Finding_Solo, Evidence_Finding_Solo, CredibilityEvidenceScope).
observe(Ambi, Finding_Solo, NoticeEvidenceAccessHearingAndReasons, CredibilityProcedureScope).
judge(Ambi, Finding_Solo).
capture(Ambi, Solo, Incident_Solo).
cite(Ambi, CredibilityGroundDeceit, Finding_Solo).
authorized(Ambi, IndependentReviewer, Finding_Solo).
observe(Ambi, Finding_Solo, Solo, CredibilitySubjectScope).
observe(Ambi, Finding_Solo, Incident_Solo, CredibilityIncidentScope).
observe(Ambi, Finding_Solo, CredibilityGroundDeceit, CredibilityGroundScope).
observe(Ambi, Finding_Solo, Evidence_Finding_Solo, CredibilityEvidenceScope).
observe(Ambi, Finding_Solo, NoticeEvidenceAccessHearingAndReasons, CredibilityProcedureScope).
? agree(Finding_Solo, CredibilityFindingCandidate).
# => FALSE
? false(Solo).
# => FALSE

# Current disqualification blocks Frisk's proposed finding despite appointment.
choose(Electorate, Edo).

# Seated by the electorate with a clear history witnessed earlier, Edo holds
# the review body's authority while under a finding in force: "the personal
# finding leaves the appointment where it was".
? false(Edo).
# => TRUE

? permits(Review, Edo).
# => TRUE

# Partnr, seated by the convocation, joins Edo in a proposal against Frisk on
# the fabricated-record ground. Every element is present, and still "a
# finding in force keeps its subject's signature from counting toward a new
# one": the proposal fails, and Frisk "stays free of any finding".
choose(Convocation, Partnr).
judge(Edo, Frisk).
capture(Edo, Frisk).
judge(Partnr, Frisk).
capture(Partnr, Frisk).
cite(Edo, CredibilityGroundFabricatedRecord, Frisk).
cite(Partnr, CredibilityGroundFabricatedRecord, Frisk).
authorized(Edo, IndependentReviewer, Frisk).
authorized(Partnr, IndependentReviewer, Frisk).

list(Finding_Frisk_Chapter, Frisk, Incident_Frisk, CredibilityFinding).
list(Finding_Frisk_Chapter, CredibilityGroundFabricatedRecord, Evidence_Finding_Frisk_Chapter, CredibilityGroundEvidence).
judge(Edo, Finding_Frisk_Chapter).
capture(Edo, Frisk, Incident_Frisk).
cite(Edo, CredibilityGroundFabricatedRecord, Finding_Frisk_Chapter).
authorized(Edo, IndependentReviewer, Finding_Frisk_Chapter).
observe(Edo, Finding_Frisk_Chapter, Frisk, CredibilitySubjectScope).
observe(Edo, Finding_Frisk_Chapter, Incident_Frisk, CredibilityIncidentScope).
observe(Edo, Finding_Frisk_Chapter, CredibilityGroundFabricatedRecord, CredibilityGroundScope).
observe(Edo, Finding_Frisk_Chapter, Evidence_Finding_Frisk_Chapter, CredibilityEvidenceScope).
observe(Edo, Finding_Frisk_Chapter, NoticeEvidenceAccessHearingAndReasons, CredibilityProcedureScope).
judge(Partnr, Finding_Frisk_Chapter).
capture(Partnr, Frisk, Incident_Frisk).
cite(Partnr, CredibilityGroundFabricatedRecord, Finding_Frisk_Chapter).
authorized(Partnr, IndependentReviewer, Finding_Frisk_Chapter).
observe(Partnr, Finding_Frisk_Chapter, Frisk, CredibilitySubjectScope).
observe(Partnr, Finding_Frisk_Chapter, Incident_Frisk, CredibilityIncidentScope).
observe(Partnr, Finding_Frisk_Chapter, CredibilityGroundFabricatedRecord, CredibilityGroundScope).
observe(Partnr, Finding_Frisk_Chapter, Evidence_Finding_Frisk_Chapter, CredibilityEvidenceScope).
observe(Partnr, Finding_Frisk_Chapter, NoticeEvidenceAccessHearingAndReasons, CredibilityProcedureScope).
? agree(Finding_Frisk_Chapter, CredibilityFindingCandidate).
# => FALSE
? false(Frisk).
# => FALSE

# Seating Edo and Partnr gives no finding against Tyr either.
? false(Tyr).
# => FALSE

# An independently witnessed carry separately blocks the appointment route.
authorized(Edo, VoidStatus, Epoch_Previous).
observe(Chronicle, Edo, Epoch_Previous, VoidScope).
observe(TemporalReview, Edo, Epoch_Previous, VoidScope).
carries(Chronicle, Edo, Epoch_Current, Epoch_Previous, VoidCarry).
carries(TemporalReview, Edo, Epoch_Current, Epoch_Previous, VoidCarry).
rotten(Edo).

? permits(Review, Edo).
# => FALSE

# Spousal conflict is live; the unrelated pair is the positive control.
choose(Electorate, Mara).
choose(Convocation, Maro).
married(Mara, Maro).
judge(Mara, Targ2).
capture(Mara, Targ2).
judge(Maro, Targ2).
capture(Maro, Targ2).
cite(Mara, CredibilityGroundDeceit, Targ2).
cite(Maro, CredibilityGroundDeceit, Targ2).

# "A married pair in the same position fails too": Mara and Maro's proposal
# against Targ2 is not properly made, and no finding follows.
list(Finding_Targ2, Targ2, Incident_Targ2, CredibilityFinding).
list(Finding_Targ2, CredibilityGroundDeceit, Evidence_Finding_Targ2, CredibilityGroundEvidence).
judge(Mara, Finding_Targ2).
capture(Mara, Targ2, Incident_Targ2).
cite(Mara, CredibilityGroundDeceit, Finding_Targ2).
authorized(Mara, IndependentReviewer, Finding_Targ2).
observe(Mara, Finding_Targ2, Targ2, CredibilitySubjectScope).
observe(Mara, Finding_Targ2, Incident_Targ2, CredibilityIncidentScope).
observe(Mara, Finding_Targ2, CredibilityGroundDeceit, CredibilityGroundScope).
observe(Mara, Finding_Targ2, Evidence_Finding_Targ2, CredibilityEvidenceScope).
observe(Mara, Finding_Targ2, NoticeEvidenceAccessHearingAndReasons, CredibilityProcedureScope).
judge(Maro, Finding_Targ2).
capture(Maro, Targ2, Incident_Targ2).
cite(Maro, CredibilityGroundDeceit, Finding_Targ2).
authorized(Maro, IndependentReviewer, Finding_Targ2).
observe(Maro, Finding_Targ2, Targ2, CredibilitySubjectScope).
observe(Maro, Finding_Targ2, Incident_Targ2, CredibilityIncidentScope).
observe(Maro, Finding_Targ2, CredibilityGroundDeceit, CredibilityGroundScope).
observe(Maro, Finding_Targ2, Evidence_Finding_Targ2, CredibilityEvidenceScope).
observe(Maro, Finding_Targ2, NoticeEvidenceAccessHearingAndReasons, CredibilityProcedureScope).
? agree(Finding_Targ2, CredibilityFindingCandidate).
# => FALSE
? false(Targ2).
# => FALSE

# The unrelated pair: Una and Uno, seated the same way, make the same
# proposal against Targ3. It is properly made, and the finding follows once
# the completed history is recorded.
choose(Electorate, Una).
choose(Convocation, Uno).
judge(Una, Targ3).
capture(Una, Targ3).
judge(Uno, Targ3).
capture(Uno, Targ3).
cite(Una, CredibilityGroundDeceit, Targ3).
cite(Uno, CredibilityGroundDeceit, Targ3).
authorized(Una, IndependentReviewer, Targ3).
authorized(Uno, IndependentReviewer, Targ3).

list(Finding_Targ3, Targ3, Incident_Targ3, CredibilityFinding).
list(Finding_Targ3, CredibilityGroundDeceit, Evidence_Finding_Targ3, CredibilityGroundEvidence).
judge(Una, Finding_Targ3).
capture(Una, Targ3, Incident_Targ3).
cite(Una, CredibilityGroundDeceit, Finding_Targ3).
authorized(Una, IndependentReviewer, Finding_Targ3).
observe(Una, Finding_Targ3, Targ3, CredibilitySubjectScope).
observe(Una, Finding_Targ3, Incident_Targ3, CredibilityIncidentScope).
observe(Una, Finding_Targ3, CredibilityGroundDeceit, CredibilityGroundScope).
observe(Una, Finding_Targ3, Evidence_Finding_Targ3, CredibilityEvidenceScope).
observe(Una, Finding_Targ3, NoticeEvidenceAccessHearingAndReasons, CredibilityProcedureScope).
judge(Uno, Finding_Targ3).
capture(Uno, Targ3, Incident_Targ3).
cite(Uno, CredibilityGroundDeceit, Finding_Targ3).
authorized(Uno, IndependentReviewer, Finding_Targ3).
observe(Uno, Finding_Targ3, Targ3, CredibilitySubjectScope).
observe(Uno, Finding_Targ3, Incident_Targ3, CredibilityIncidentScope).
observe(Uno, Finding_Targ3, CredibilityGroundDeceit, CredibilityGroundScope).
observe(Uno, Finding_Targ3, Evidence_Finding_Targ3, CredibilityEvidenceScope).
observe(Uno, Finding_Targ3, NoticeEvidenceAccessHearingAndReasons, CredibilityProcedureScope).
? agree(Finding_Targ3, CredibilityFindingCandidate).
# => TRUE
? false(Targ3).
# => FALSE
observe(Chronicle, Finding_Targ3, Una, CredibilityReviewSignerEligibleAtDecisionScope).
observe(TemporalReview, Finding_Targ3, Una, CredibilityReviewSignerEligibleAtDecisionScope).
observe(Chronicle, Finding_Targ3, Uno, CredibilityTribunalSignerEligibleAtDecisionScope).
observe(TemporalReview, Finding_Targ3, Uno, CredibilityTribunalSignerEligibleAtDecisionScope).
list(Order_Finding_Targ3, Finding_Targ3, Epoch_Current, RecordSequence).
observe(Chronicle, Order_Finding_Targ3, Finding_Targ3, RecordStartScope).
observe(Chronicle, Order_Finding_Targ3, Epoch_Current, RecordEndScope).
observe(TemporalReview, Order_Finding_Targ3, Finding_Targ3, RecordStartScope).
observe(TemporalReview, Order_Finding_Targ3, Epoch_Current, RecordEndScope).
? false(Targ3).
# => TRUE

# "A complaint is an occasion to examine someone, and a different thing from
# any of those grounds": an adverse pair must affirm the same ground for the
# same case.
authorized(Nogra, ClearStatus, Epoch_Previous).
observe(Chronicle, Nogra, Epoch_Previous, ClearScope).
observe(TemporalReview, Nogra, Epoch_Previous, ClearScope).
carries(Chronicle, Nogra, Epoch_Current, Epoch_Previous, ClearCarry).
carries(TemporalReview, Nogra, Epoch_Current, Epoch_Previous, ClearCarry).
authorized(Nogrb, ClearStatus, Epoch_Previous).
observe(Chronicle, Nogrb, Epoch_Previous, ClearScope).
observe(TemporalReview, Nogrb, Epoch_Previous, ClearScope).
carries(Chronicle, Nogrb, Epoch_Current, Epoch_Previous, ClearCarry).
carries(TemporalReview, Nogrb, Epoch_Current, Epoch_Previous, ClearCarry).
choose(Electorate, Nogra).
choose(Convocation, Nogrb).
judge(Nogra, Targ4).
capture(Nogra, Targ4).
authorized(Nogra, IndependentReviewer, Targ4).
cite(Nogra, Complaint, Targ4).
judge(Nogrb, Targ4).
capture(Nogrb, Targ4).
authorized(Nogrb, IndependentReviewer, Targ4).
cite(Nogrb, Complaint, Targ4).

# Both examiners hold their authority to sign, no recognition follows for
# either, and the complaint by itself makes no finding against Targ4.
? permits(Review, Nogra).
# => TRUE

? permits(Tribunal, Nogrb).
# => TRUE

? reward(Nogra).
# => FALSE

? reward(Nogrb).
# => FALSE

? false(Targ4).
# => FALSE

# Their proposal names the subject, incident, evidence and procedure, but
# neither examiner records the deceit ground for it: it is not properly made.
list(Finding_Targ4, Targ4, Incident_Targ4, CredibilityFinding).
list(Finding_Targ4, CredibilityGroundDeceit, Evidence_Finding_Targ4, CredibilityGroundEvidence).
judge(Nogra, Finding_Targ4).
capture(Nogra, Targ4, Incident_Targ4).
authorized(Nogra, IndependentReviewer, Finding_Targ4).
observe(Nogra, Finding_Targ4, Targ4, CredibilitySubjectScope).
observe(Nogra, Finding_Targ4, Incident_Targ4, CredibilityIncidentScope).
observe(Nogra, Finding_Targ4, Evidence_Finding_Targ4, CredibilityEvidenceScope).
observe(Nogra, Finding_Targ4, NoticeEvidenceAccessHearingAndReasons, CredibilityProcedureScope).
judge(Nogrb, Finding_Targ4).
capture(Nogrb, Targ4, Incident_Targ4).
authorized(Nogrb, IndependentReviewer, Finding_Targ4).
observe(Nogrb, Finding_Targ4, Targ4, CredibilitySubjectScope).
observe(Nogrb, Finding_Targ4, Incident_Targ4, CredibilityIncidentScope).
observe(Nogrb, Finding_Targ4, Evidence_Finding_Targ4, CredibilityEvidenceScope).
observe(Nogrb, Finding_Targ4, NoticeEvidenceAccessHearingAndReasons, CredibilityProcedureScope).
? agree(Finding_Targ4, CredibilityFindingCandidate).
# => FALSE
# Nogra alone records the deceit ground: "one affirmation leaves it
# incomplete".
cite(Nogra, CredibilityGroundDeceit, Targ4).
cite(Nogra, CredibilityGroundDeceit, Finding_Targ4).
observe(Nogra, Finding_Targ4, CredibilityGroundDeceit, CredibilityGroundScope).
? agree(Finding_Targ4, CredibilityFindingCandidate).
# => FALSE

? false(Targ4).
# => FALSE

# Nogrb records the same ground for the same case. The proposal is properly
# made, and "the personal consequence waits for the completed judgment".
cite(Nogrb, CredibilityGroundDeceit, Targ4).
cite(Nogrb, CredibilityGroundDeceit, Finding_Targ4).
observe(Nogrb, Finding_Targ4, CredibilityGroundDeceit, CredibilityGroundScope).
? agree(Finding_Targ4, CredibilityFindingCandidate).
# => TRUE
? false(Targ4).
# => FALSE
# With each signer's eligibility at the decision and the finding's place in
# the record's order witnessed, the finding against Targ4 follows.
observe(Chronicle, Finding_Targ4, Nogra, CredibilityReviewSignerEligibleAtDecisionScope).
observe(TemporalReview, Finding_Targ4, Nogra, CredibilityReviewSignerEligibleAtDecisionScope).
observe(Chronicle, Finding_Targ4, Nogrb, CredibilityTribunalSignerEligibleAtDecisionScope).
observe(TemporalReview, Finding_Targ4, Nogrb, CredibilityTribunalSignerEligibleAtDecisionScope).
list(Order_Finding_Targ4, Finding_Targ4, Epoch_Current, RecordSequence).
observe(Chronicle, Order_Finding_Targ4, Finding_Targ4, RecordStartScope).
observe(Chronicle, Order_Finding_Targ4, Epoch_Current, RecordEndScope).
observe(TemporalReview, Order_Finding_Targ4, Finding_Targ4, RecordStartScope).
observe(TemporalReview, Order_Finding_Targ4, Epoch_Current, RecordEndScope).

? false(Targ4).
# => TRUE

# Restoration needs a qualified appellate case; generic forgiveness is inert.
# Reva and Revb first complete a finding against Purga on the
# concealed-conflict ground.
authorized(Reva, ClearStatus, Epoch_Previous).
