observe(Chronicle, Restore_Purga, Tribunal, CredibilityAppealReviewActorEligibleAtDecisionScope).
observe(TemporalReview, Restore_Purga, Tribunal, CredibilityAppealReviewActorEligibleAtDecisionScope).
list(Order_Before_Restore_Purga, Finding_Purga, Restore_Purga, RecordSequence).
observe(Chronicle, Order_Before_Restore_Purga, Finding_Purga, RecordStartScope).
observe(Chronicle, Order_Before_Restore_Purga, Restore_Purga, RecordEndScope).
observe(TemporalReview, Order_Before_Restore_Purga, Finding_Purga, RecordStartScope).
observe(TemporalReview, Order_Before_Restore_Purga, Restore_Purga, RecordEndScope).
list(Order_After_Restore_Purga, Restore_Purga, Epoch_Current, RecordSequence).
