# Retain the old unscoped single-signer rule as an attempted widening.
# The current case-relief and custody graph refuses its negative dependency.
:refuse reasoning /Unstratifiable/
all $a: all $audited: all $ground: permits(Review, $a) & permits(Tribunal, $a) & authorized($a, IndependentReviewer, $audited) & judge($a, $audited) & capture($a, $audited) & cite($a, $ground, $audited) & ~deceive($a, $audited) & ~broken($a) & ~match($a, CarriedVoid) & ~clean($audited) -> false($audited).

? false(Solo).
# => FALSE
