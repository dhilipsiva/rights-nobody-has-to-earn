list(Restore_Dev_Conflict, Dev, Finding_Dev_Conflict, CredibilityRestoration).
list(Restore_Dev_Conflict, RestoreCredibilityFinding, Evidence_Restore_Dev_Conflict, CredibilityAppealPurposeEvidence).
judge(Appeals, Restore_Dev_Conflict).
judge(Tribunal, Restore_Dev_Conflict).
