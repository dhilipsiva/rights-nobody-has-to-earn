# A forgiveness flag and a generic judgment by the appeals body leave
# Purga's finding in force.
forgive(Appeals, Purga).
judge(Appeals, Purga).
? clean(Purga).
# => FALSE
? false(Purga).
# => TRUE
# The test records the particular appellate act for Purga's finding, with
# its independent review, each actor's eligibility at the decision and its
# place in the record's order.
list(Restore_Purga, Purga, Finding_Purga, CredibilityRestoration).
list(Restore_Purga, RestoreCredibilityFinding, Evidence_Restore_Purga, CredibilityAppealPurposeEvidence).
judge(Appeals, Restore_Purga).
judge(Tribunal, Restore_Purga).
authorized(Appeals, CredibilityAppellateDisposition, Restore_Purga).
