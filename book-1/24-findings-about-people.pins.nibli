? parent(Dev, Esa).
# => TRUE
? judge(Dev, Esa).
# => TRUE
? clean(Finding_Dev_Conflict, CredibilityFinding).
# => TRUE
? false(Dev).
# => FALSE

# "Everything else stays as it was": an office outside the restriction. Bela,
# under a finding in force, is the source of a floor-shortfall pattern
# certification beside a separate reviewer, and the certification obliges
# the Constitutional Court to decide. "That route keeps its own independence
# and conflict rules, and the credibility finding stands outside them."
public(ShortfallTier_Bela).
authorized(Bela, FloorShortfallPatternSourceAuthority, Pattern_Bela).
authorized(PatternReviewer_Bela, IndependentFloorShortfallPatternReviewAuthority, Pattern_Bela).
observe(Bela, Pattern_Bela, ShortfallTier_Bela, FloorShortfallPatternTierScope).
observe(PatternReviewer_Bela, Pattern_Bela, ShortfallTier_Bela, FloorShortfallPatternTierScope).
? false(Bela).
# => TRUE

? obliged(FSBOD_18, DecideWhetherTheCertifiedFloorShortfallIsAnUnconstitutionalStateOfAffairs, Pattern_Bela).
# => TRUE

# Personal credibility does not condition standing, the floor or the ballot.
? person(Bela).
# => TRUE

? owe(State, Eats, Bela).
# => TRUE

? travel(Bela).
# => TRUE

? decide(Bela, Ballot).
# => TRUE

# The rules conclude no custody for Bela, and nothing is granted or recorded
# as lost.
? prisoner(Bela).
# => FALSE

? reward(Bela).
# => FALSE

? lose(Points, Bela).
# => FALSE

# The rules still conclude no finding against Tyr, whom Mael and Wren
# examined.
? false(Tyr).
# => FALSE

# Unwitnessed carry cannot impose a personal finding.
? false(Forga).
# => FALSE

# A raw report of an earlier restriction on Forga, with both witnesses'
# carry entries but no restriction entry in the earlier version, "is marked
# as a forgery and imposes no finding".
rotten(Forga).
carries(Chronicle, Forga, Epoch_Current, Epoch_Previous, VoidCarry).
carries(TemporalReview, Forga, Epoch_Current, Epoch_Previous, VoidCarry).

? err(Forga, CarryForgery).
# => TRUE

? false(Forga).
# => FALSE

# The one-line child fixture: every debt remains unconditional.
# The rules conclude no credibility finding against Nell, and the debts
# follow on personhood alone.
? false(Nell).
# => FALSE

? owe(State, Eats, Nell).
# => TRUE

? owe(State, Dwell, Nell).
# => TRUE

? owe(State, Healthy, Nell).
# => TRUE

? owe(State, Learn, Nell).
# => TRUE

? owe(State, Secure, Nell).
# => TRUE

? owe(State, Suffice, Nell).
# => TRUE

? owe(State, Expresses, Nell).
# => TRUE

? owe(State, Believe, Nell).
# => TRUE

? owe(State, Meets, Nell).
# => TRUE

# No recognition follows for Nell, and nothing is recorded as lost.
? reward(Nell).
# => FALSE

? lose(Points, Nell).
# => FALSE

# Explicit weaker prospective rule: remove only distinctness. It permits the
# single signer's proposal, which by itself still imposes no personal finding.
:accept
all $a: all $b: all $evidence: all $ground: all $incident: all $record: all $subject: list($record, $subject, $incident, CredibilityFinding) & list($record, $ground, $evidence, CredibilityGroundEvidence) & member($ground, CredibilityGroundVocabulary) & judge($a, $record) & judge($b, $record) & capture($a, $subject, $incident) & capture($b, $subject, $incident) & cite($a, $ground, $record) & cite($b, $ground, $record) & authorized($a, IndependentReviewer, $record) & authorized($b, IndependentReviewer, $record) & ~($a = $subject) & ~($b = $subject) & ~parent($a, $subject) & ~parent($b, $subject) & ~parent($subject, $a) & ~parent($subject, $b) & ~married($a, $subject) & ~married($b, $subject) & ~sibling($a, $subject) & ~sibling($b, $subject) & ~collide($record, CredibilityCaseBinding) & observe($a, $record, $subject, CredibilitySubjectScope) & observe($b, $record, $subject, CredibilitySubjectScope) & observe($a, $record, $incident, CredibilityIncidentScope) & observe($b, $record, $incident, CredibilityIncidentScope) & observe($a, $record, $ground, CredibilityGroundScope) & observe($b, $record, $ground, CredibilityGroundScope) & observe($a, $record, $evidence, CredibilityEvidenceScope) & observe($b, $record, $evidence, CredibilityEvidenceScope) & observe($a, $record, NoticeEvidenceAccessHearingAndReasons, CredibilityProcedureScope) & observe($b, $record, NoticeEvidenceAccessHearingAndReasons, CredibilityProcedureScope) & ~parent($a, $b) & ~parent($b, $a) & ~married($a, $b) & ~married($b, $a) & ~sibling($a, $b) & ~sibling($b, $a) & permits(Review, $a) & permits(Tribunal, $b) & ~false($a) & ~false($b) & ~broken($a) & ~broken($b) & ~match($a, CarriedVoid) & ~match($b, CarriedVoid) & ~clean($record, CredibilityFinding) -> agree($record, CredibilityFindingCandidate).
? agree(Finding_Solo, CredibilityFindingCandidate).
# => TRUE
? false(Solo).
# => FALSE
# An unscoped rule letting one signer who holds both appointments impose a
# finding directly is an attempted widening. The engine refuses it: through
# the custody and case-relief rules, its conclusion would depend on itself
# through a negation.
:refuse reasoning /Unstratifiable/
all $a: all $audited: all $ground: permits(Review, $a) & permits(Tribunal, $a) & authorized($a, IndependentReviewer, $audited) & judge($a, $audited) & capture($a, $audited) & cite($a, $ground, $audited) & ~deceive($a, $audited) & ~broken($a) & ~match($a, CarriedVoid) & ~clean($audited) -> false($audited).

? false(Solo).
# => FALSE
