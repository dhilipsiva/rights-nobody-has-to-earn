observe(Chronicle, Order_After_Restore_Purga, Epoch_Current, RecordEndScope).
observe(TemporalReview, Order_After_Restore_Purga, Restore_Purga, RecordStartScope).
observe(TemporalReview, Order_After_Restore_Purga, Epoch_Current, RecordEndScope).

# The signers keep their authority to sign; Purga's finding ends, and
# nothing is recorded as lost.
? permits(Review, Reva).
# => TRUE

? permits(Tribunal, Revb).
# => TRUE

? clean(Purga).
# => TRUE

? false(Purga).
# => FALSE

? lose(Points, Purga).
# => FALSE

# Reasons and subject-initiated review; neither establishes actual delivery.
? obliged(Review, ExplainTheGroundOfACredibilityFinding, Bela).
# => TRUE

# The appeals body's duty to review a challenge waits for the subject's own
# challenge. Once Bela challenges, "that duty follows, and the finding
# continues meanwhile".
? obliged(Appeals, Bela).
# => FALSE

challenge(Bela, Complaint, CredibilityReview).

? obliged(Appeals, Bela).
# => TRUE

? false(Bela).
# => TRUE

# The reasons duty does not wait for a separate personhood entry.
? person(Targo).
# => FALSE

? obliged(Review, ExplainTheGroundOfACredibilityFinding, Targo).
# => TRUE

# A separately adjudicated concealed conflict can end while the relationship remains.
list(Finding_Dev_Conflict, Dev, Examination_Dev_Esa, CredibilityFinding).
list(Finding_Dev_Conflict, CredibilityGroundConcealedConflict, Evidence_Finding_Dev_Conflict, CredibilityGroundEvidence).
