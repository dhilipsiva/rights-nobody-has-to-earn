# The limits of a finding.
# Original contribution, accusation, child and restoration scenarios retained.
# The 2026-09-20 removal supersedes their recognition and clawback verdicts.
# The removed producers and blanket penalty execute in the explicit
# credibility/counterfactual-blanket-recognition-loss regression.
:expect-pins 51

? false(Bela).
# => TRUE

? reward(Bela).
# => FALSE

? lose(Points, Bela).
# => FALSE

? person(Bela).
# => TRUE

? travel(Bela).
# => TRUE

? prisoner(Bela).
# => FALSE

? decide(Bela, Ballot).
# => TRUE

? entitled(Bela, event { eats() }).
# => TRUE

? owe(State, Eats, Bela).
# => TRUE

? eats(Bela).
# => FALSE

? dwell(Bela).
# => FALSE

? eats(Jala).
# => FALSE

? teaches(Bela, Cira).
# => TRUE

? lose(Points, Cira).
# => FALSE

? reward(Cira).
# => FALSE

? false(Cira).
# => FALSE

? teaches(Esa, Fin).
# => TRUE

? person(Fin).
# => FALSE

? false(Esa).
# => FALSE

? lose(Points, Fin).
# => FALSE

? false(Lupo).
# => TRUE

? lose(Points, Lupo).
# => FALSE

? lose(Points, Mira).
# => FALSE

? rotten(Vex).
# => TRUE

? false(Vex).
# => TRUE

? lose(Points, Vex).
# => FALSE

? permits(Review, Vex).
# => FALSE

? authority(Vex).
# => TRUE

# A general finding does not determine unrelated care, wages or insurance.
work(Bela, UnrelatedCare).
? work(Bela, UnrelatedCare).
# => TRUE
promise(Foundry, Wage, Bela).
authorized(Steward, CompensationAttester, Bela).
observe(Steward, Wage, Bela, LabourBasis).
? provide(Foundry, Wage, Bela).
# => TRUE
pay(Bela, Contribution, Ledgerhouse, SchemeM).
authorized(Assay, InsuranceAdjudicator, Bela).
observe(Assay, Illness, Bela, SchemeM).
? insure(Ledgerhouse, Bela, Illness).
# => TRUE
# A finding on a different compensation basis does not remove this wage.
observe(Court, CompensationFraud, Bela, OtherBasis).
? provide(Foundry, Wage, Bela).
# => TRUE
observe(Court, CompensationFraud, Bela, LabourBasis).
? provide(Foundry, Wage, Bela).
# => FALSE
? provide(Bela, Restitution, Foundry).
# => TRUE
? insure(Ledgerhouse, Bela, Illness).
# => TRUE
? owe(State, Eats, Bela).
# => TRUE
? obliged(Appeals, ReviewContinuingCredibilityRestriction, Vex).
# => TRUE

forgive(Appeals, Vex).

? false(Vex).
# => TRUE

judge(Appeals, Vex).

? clean(Vex).
# => FALSE
? false(Vex).
# => TRUE

