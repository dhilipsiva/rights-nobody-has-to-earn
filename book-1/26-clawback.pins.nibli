list(Restore_Vex_Recognition, RestoreCredibilityFinding, Evidence_Restore_Vex_Recognition, CredibilityAppealPurposeEvidence).
judge(Appeals, Restore_Vex_Recognition).
judge(Tribunal, Restore_Vex_Recognition).
authorized(Appeals, CredibilityAppellateDisposition, Restore_Vex_Recognition).
authorized(Tribunal, IndependentCredibilityAppealReview, Restore_Vex_Recognition).
observe(Appeals, Restore_Vex_Recognition, Vex, CredibilityAppealSubjectScope).
observe(Appeals, Restore_Vex_Recognition, Credibility_Vex_Finding, CredibilityAppealFindingScope).
observe(Appeals, Restore_Vex_Recognition, RestoreCredibilityFinding, CredibilityAppealPurposeScope).
observe(Appeals, Restore_Vex_Recognition, Evidence_Restore_Vex_Recognition, CredibilityAppealEvidenceScope).
