observe(Court, Severity_Zeno_InjuryToPerson_Yara, Zeno, SeveritySubjectScope).
observe(CustodyMeritsReview, Severity_Zeno_InjuryToPerson_Yara, Zeno, SeveritySubjectScope).
observe(Court, Severity_Zeno_InjuryToPerson_Yara, Incident_Case_Zeno, SeverityIncidentScope).
observe(CustodyMeritsReview, Severity_Zeno_InjuryToPerson_Yara, Incident_Case_Zeno, SeverityIncidentScope).
observe(Court, Severity_Zeno_InjuryToPerson_Yara, Yara, SeverityVictimScope).
observe(CustodyMeritsReview, Severity_Zeno_InjuryToPerson_Yara, Yara, SeverityVictimScope).
observe(Court, Severity_Zeno_InjuryToPerson_Yara, InjuryToPerson, SeverityDimensionScope).
observe(CustodyMeritsReview, Severity_Zeno_InjuryToPerson_Yara, InjuryToPerson, SeverityDimensionScope).
observe(Court, Severity_Zeno_InjuryToPerson_Yara, Evidence_Severity_Zeno_InjuryToPerson_Yara, SeverityEvidenceScope).
observe(CustodyMeritsReview, Severity_Zeno_InjuryToPerson_Yara, Evidence_Severity_Zeno_InjuryToPerson_Yara, SeverityEvidenceScope).
observe(Court, Severity_Zeno_InjuryToPerson_Yara, AdjudicatedHarmAndMentalElementWithNoticeCounselChallengeAndReasons, SeverityProcedureScope).
observe(CustodyMeritsReview, Severity_Zeno_InjuryToPerson_Yara, AdjudicatedHarmAndMentalElementWithNoticeCounselChallengeAndReasons, SeverityProcedureScope).
list(Placement_Case_Zeno, Zeno, Case_Zeno, CustodyPlacement).
list(Placement_Case_Zeno, Place_Zeno, SupportedResidence, CustodyPlaceKind).
list(Placement_Case_Zeno, Case_Zeno, Window_Custody, CustodyPlacementPeriod).
authorized(State, CustodyPlacementAuthority, Placement_Case_Zeno).
authorized(PlacementReview, IndependentPlacementReviewer, Placement_Case_Zeno).
observe(State, Placement_Case_Zeno, Zeno, CustodyPlacementSubjectScope).
observe(PlacementReview, Placement_Case_Zeno, Zeno, CustodyPlacementSubjectScope).
observe(State, Placement_Case_Zeno, Case_Zeno, CustodyPlacementCaseScope).
observe(PlacementReview, Placement_Case_Zeno, Case_Zeno, CustodyPlacementCaseScope).
observe(State, Placement_Case_Zeno, Place_Zeno, CustodyPlacementPlaceScope).
observe(PlacementReview, Placement_Case_Zeno, Place_Zeno, CustodyPlacementPlaceScope).
observe(State, Placement_Case_Zeno, SupportedResidence, CustodyPlacementKindScope).
observe(PlacementReview, Placement_Case_Zeno, SupportedResidence, CustodyPlacementKindScope).
