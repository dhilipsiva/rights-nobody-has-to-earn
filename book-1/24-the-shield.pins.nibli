observe(PlacementReview, Placement_Case_Zeno, PositiveAccessibleAvailableConsentingPlaceAndIndividualLawfulConditions, CustodyPlacementAvailabilityScope).
observe(State, Placement_Case_Zeno, NoticeCounselReasonsIndependentInspectionAndAccessibleChallenge, CustodyPlacementProcedureScope).
observe(PlacementReview, Placement_Case_Zeno, NoticeCounselReasonsIndependentInspectionAndAccessibleChallenge, CustodyPlacementProcedureScope).
observe(State, Placement_Case_Zeno, IndividuallyNecessaryLeastRestrictivePlacementAndContinuity, CustodyPlacementNecessityScope).
observe(PlacementReview, Placement_Case_Zeno, IndividuallyNecessaryLeastRestrictivePlacementAndContinuity, CustodyPlacementNecessityScope).
observe(State, Placement_Case_Zeno, NoSuitableConsentingHomeAvailableAndOrdinarySupportedResidenceSecured, CustodyPlacementAlternativeScope).
observe(PlacementReview, Placement_Case_Zeno, NoSuitableConsentingHomeAvailableAndOrdinarySupportedResidenceSecured, CustodyPlacementAlternativeScope).
authorized(CustodyIntake, CustodyIntakeAuthority, Case_Zeno).
authorized(CustodyIntakeAudit, IndependentCustodyIntakeAuditor, Case_Zeno).
observe(CustodyIntake, Case_Zeno, Zeno, CustodyIntakeSubjectScope).
observe(CustodyIntakeAudit, Case_Zeno, Zeno, CustodyIntakeSubjectScope).
observe(CustodyIntake, Case_Zeno, Case_Zeno, CustodyIntakeCaseScope).
observe(CustodyIntakeAudit, Case_Zeno, Case_Zeno, CustodyIntakeCaseScope).
observe(CustodyIntake, Case_Zeno, Epoch_Current, CustodyIntakeEpochScope).
observe(CustodyIntakeAudit, Case_Zeno, Epoch_Current, CustodyIntakeEpochScope).
observe(CustodyIntake, Case_Zeno, Window_Custody, CustodyIntakeWindowScope).
