observe(PlacementReview, Placement_Case_Zeno, Case_Zeno, CustodyPlacementLeaseScope).
observe(State, Placement_Case_Zeno, Window_Custody, CustodyPlacementWindowScope).
observe(PlacementReview, Placement_Case_Zeno, Window_Custody, CustodyPlacementWindowScope).
