observe(CustodyIntakeAudit, Case_Zeno, AccessiblePrimaryAndIndependentAlternateWithConfidentialCounselAndRetainedCopies, CustodyIntakeAccessScope).
observe(CustodyIntake, Case_Zeno, ReconciledPrimaryAlternateAndSubjectHeldFilingsBeforeEachRenewal, CustodyIntakeReconciliationScope).
observe(CustodyIntakeAudit, Case_Zeno, ReconciledPrimaryAlternateAndSubjectHeldFilingsBeforeEachRenewal, CustodyIntakeReconciliationScope).
observe(CustodyIntake, Case_Zeno, NoHolderPermissionNoRetaliationAndImmediateSuspensionOnFiling, CustodyIntakeProtectionScope).
observe(CustodyIntakeAudit, Case_Zeno, NoHolderPermissionNoRetaliationAndImmediateSuspensionOnFiling, CustodyIntakeProtectionScope).


? injure(Don, Pax).
# => TRUE

? show(Don, Disclosure_Don_Pax, Pax).
# => TRUE

# "Pax has none." — the condition that fails
? authority(Pax).
# => FALSE

# "Don has no shield and Don is a prisoner."
? defend(Don).
# => FALSE

? prisoner(Don).
# => TRUE

# SLY — "Sly injured Pax too. Then Sly exposed the court."
? injure(Sly, Pax).
# => TRUE

? show(Sly, Disclosure_Sly_Court, Court).
# => TRUE

? false(Sly, Disclosure_Sly_Court).
# => FALSE

? authority(Court).
# => TRUE

# THE CONJUNCT THE SLY SECTION TURNS ON, and it was tested only through its
# result until now. Sly and Kel are name-swapped duplicates in the cast except
# for two facts, and this absence is one of them. `defend(Sly)` below would
# break if a deceit finding were written, so the protection existed — but the
# claim the chapter actually makes is about the ABSENCE, and an absence tested
# only downstream is an absence nobody has named.
? deceive(Sly, Court).
# => FALSE

# Sly's shield derives; no prisoner conclusion follows. This proves no release.
? defend(Sly).
# => TRUE

? prisoner(Sly).
# => FALSE

# KEL — "Then the review body examined the exposure and found it deceitful."
? show(Kel, Disclosure_Kel_Court, Court).
# => TRUE

? false(Kel, Disclosure_Kel_Court).
# => TRUE

? deceive(Kel, Court).
# => TRUE

# "Kel's shield falls ... Kel is a prisoner ... Kel's own credibility is voided."
# KEL RESOLVES ONLY BECAUSE KEL EXPOSED ONCE. These three are per-subject and a
# per-subject pin cannot see a per-PAIR defect — the shield rule is satisfied by
# ANY qualifying pair, so a second exposure reopens it. That is what the Rex
# block below exists to hold, and why it is not enough to pin Kel.
? defend(Kel).
# => FALSE

? prisoner(Kel).
# => TRUE

? false(Kel).
# => TRUE

# REX — "Rex did what Kel did, and then did one more thing."
# The disclosed cost of scoping the shield to the exposure. If any of these six
# flip, chapter 24's "Rex" section and the second item in "What it costs" are
# both wrong, and so is the constitution's E1d commentary.
? show(Rex, Disclosure_Rex_Court, Court).
# => TRUE

? false(Rex, Disclosure_Rex_Court).
# => TRUE

? deceive(Rex, Court).
# => TRUE

# "Rex's credibility was destroyed by the same counter-audit."
? false(Rex).
# => TRUE

# "Then Rex exposed the review body. Nobody has examined that one."
? show(Rex, Disclosure_Rex_Review, Review).
# => TRUE

? false(Rex, Disclosure_Rex_Review).
# => FALSE

# ...and the body Rex exposed has standing, which is the other half of "a fresh
# claim against an authority". `authority(Court)` is pinned five ways across the
# suite; its twin was pinned nowhere in the repo until now, so the second
# exposure's premise rested on nothing.
? authority(Review).
# => TRUE

# THE PAIR THAT MATTERS. Voided and shielded at once — the finding against the
# first exposure has nothing to say about the second.
? defend(Rex).
# => TRUE

? prisoner(Rex).
# => FALSE

# ── A PERSON GUARD REFUSED IN THIS REPRESENTATION ───────────────────────────────────────
# The natural repair — shield persons only — closes a negative cycle through
# the shield's own head (person <- prisoner, prisoner reads ~defend) and the
# stratifier refuses it by name. The three queries after it are the hazard the
# constitution's v0.9 note records: a refused tightening leaves the permissive
# rule in force with every verdict intact, so it protects nobody it meant to
# stop protecting. If the refusal ever stops firing, the engine's cycle
# detection changed and Article 7's note is stale.
:refuse reasoning /Unstratifiable/
all $w: all $o: all $incident: show($w, $incident, $o) & authority($o) & person($w) & ~false($w, $incident) -> defend($w).

? defend(Sly).
# => TRUE

? prisoner(Sly).
# => FALSE

? defend(Rebel).
# => TRUE

# ── THE FRAME-UP COMPLETED FROM OUTSIDE ──────────────────────────────────────
# Don's frame-up fails on an absence: Pax holds no standing, pinned FALSE at the
# top of this file beside defend(Don) FALSE and prisoner(Don) TRUE. Those three
# are the negative control for what follows. Standing by the public route is a
# single admitted entry that nobody adjudicates — so write it about the victim
# and the absence is gone. The shield attaches to the exposure Don manufactured
# and the conviction stops deriving. Ground fact, so it persists; the reach-back
# block below does not read Pax.
public(Pax).

? authority(Pax).
# => TRUE

? defend(Don).
# => TRUE

? prisoner(Don).
# => FALSE

# ── THE CASE THE SHIELD STOPS COVERING ───────────────────────────────────────
# The second route, run on the person the chapter's own cost paragraph is
# about. Rex has everything confinement needs except the absence of a
# shield: the injury, the court's judgment, the cited case, the recorded
# conviction, both witnesses on every scope, and an active custody
# authorisation.
? match(Rex, ConvictionRecorded).
# => TRUE

? correct(Case_Rex, ActivePower).
# => TRUE

# Rex has no qualifying case finding initially. Appeals and Convocation
# decide only with their own case authority and independently attested
# eligibility; their agreement alone is insufficient.
observe(Appeals, Case_Rex, ShieldUnrelatedToTheDisclosure, ShieldConnectionScope).
observe(Convocation, Case_Rex, ShieldUnrelatedToTheDisclosure, ShieldConnectionScope).
observe(Appeals, Case_Rex, Rex, ShieldSubjectScope).
observe(Convocation, Case_Rex, Rex, ShieldSubjectScope).

? prisoner(Rex).
# => FALSE

authorized(Appeals, ShieldConnectionReviewer, Case_Rex).
authorized(Convocation, ShieldConnectionReviewer, Case_Rex).
authorized(ShieldAppointments, ShieldQualificationAuthority, Case_Rex).
authorized(ShieldAppointmentsReview, ShieldQualificationReviewAuthority, Case_Rex).
observe(ShieldAppointments, Case_Rex, Appeals, IndependentShieldReviewerScope).
observe(ShieldAppointments, Case_Rex, Convocation, IndependentShieldReviewerScope).
observe(ShieldAppointmentsReview, Case_Rex, Appeals, IndependentShieldReviewerScope).
observe(ShieldAppointmentsReview, Case_Rex, Convocation, IndependentShieldReviewerScope).

? prisoner(Rex).
# => TRUE

# And the shield is not what was taken. It still holds, for the claim it was
# always about; what stopped is its reach into this one case.
? defend(Rex).
# => TRUE

? show(Rex, Disclosure_Rex_Review, Review).
# => TRUE

# A prosecuting court cannot supply the independent case decision. Give
# every positive qualification premise so that the Court exclusion is live;
# the isolated shield-independence cases test the other conjuncts separately.
observe(Review, Case_Sly, ShieldUnrelatedToTheDisclosure, ShieldConnectionScope).
observe(Court, Case_Sly, ShieldUnrelatedToTheDisclosure, ShieldConnectionScope).
observe(Review, Case_Sly, Sly, ShieldSubjectScope).
observe(Court, Case_Sly, Sly, ShieldSubjectScope).

authorized(Review, ShieldConnectionReviewer, Case_Sly).
authorized(Court, ShieldConnectionReviewer, Case_Sly).
authorized(ShieldAppointments, ShieldQualificationAuthority, Case_Sly).
authorized(ShieldAppointmentsReview, ShieldQualificationReviewAuthority, Case_Sly).
observe(ShieldAppointments, Case_Sly, Review, IndependentShieldReviewerScope).
observe(ShieldAppointments, Case_Sly, Court, IndependentShieldReviewerScope).
observe(ShieldAppointmentsReview, Case_Sly, Review, IndependentShieldReviewerScope).
observe(ShieldAppointmentsReview, Case_Sly, Court, IndependentShieldReviewerScope).

? prisoner(Sly).
# => FALSE

? defend(Sly).
# => TRUE

# NAMING EVERY DECISION PARTICIPANT IS NOT A VETO. Positive eligibility and
# the case finding remain; the disclosure remains protected in its own right.
show(Rex, Disclosure_Rex_Appeals, Appeals).
show(Rex, Disclosure_Rex_Convocation, Convocation).
show(Rex, Disclosure_Rex_ShieldAppointments, ShieldAppointments).
show(Rex, Disclosure_Rex_ShieldAppointmentsReview, ShieldAppointmentsReview).
? prisoner(Rex).
# => TRUE
? defend(Rex).
# => TRUE

# AN ACTUAL AUTHORISED CONFLICT IS DIFFERENT. It defeats the affected
# decision even if favourable certifications remain alongside it.
observe(ShieldAppointmentsReview, Case_Rex, Appeals, ConflictedShieldReviewerScope).
? contradict(Case_Rex, Appeals, ShieldReviewerConflict).
# => TRUE
? prisoner(Rex).
# => FALSE
? defend(Rex).
# => TRUE

# ── THE REACH-BACK, MINUS THE CENTURY. MUST BE LAST: ground facts persist ────
# "A defendant a century from now can reach back, expose someone nobody
# remembers, and open the window." Executed, minus the century: T2 can represent
# separately witnessed order, but the shield deliberately consumes no such
# claim, and nothing below says whether Zeno's exposure came before or after
# Boss's recall. Boss is
# deliberately an existing name — reaching back to him is the exhibit — and
# everything else is fresh. One write blocks a conviction.
person(Zeno).
injure(Zeno, Yara).
judge(Court, Zeno).
cite(Court, Case_Zeno, Zeno).
observe(Chronicle, Case_Zeno, Zeno, CaseScope).
observe(TemporalReview, Case_Zeno, Zeno, CaseScope).
observe(Chronicle, Case_Zeno, Court, HolderScope).
observe(TemporalReview, Case_Zeno, Court, HolderScope).
observe(Chronicle, Case_Zeno, CourtJudgment, JudgmentScope).
observe(TemporalReview, Case_Zeno, CourtJudgment, JudgmentScope).
observe(Chronicle, Case_Zeno, Yara, InjuryVictimScope).
observe(TemporalReview, Case_Zeno, Yara, InjuryVictimScope).
authorized(Case_Zeno, ActiveCustody, Case_Zeno).
observe(Chronicle, Case_Zeno, ActiveCustody, PowerScope).
observe(TemporalReview, Case_Zeno, ActiveCustody, PowerScope).
observe(Chronicle, Case_Zeno, Case_Zeno, CaseBindingScope).
observe(TemporalReview, Case_Zeno, Case_Zeno, CaseBindingScope).
limit(Case_Zeno, Case_Zeno, Window_Custody).
observe(Chronicle, Case_Zeno, Window_Custody, LimitScope).
observe(TemporalReview, Case_Zeno, Window_Custody, LimitScope).
continue(Case_Zeno, Epoch_Current).
observe(Chronicle, Case_Zeno, Epoch_Current, RenewalScope).
observe(TemporalReview, Case_Zeno, Epoch_Current, RenewalScope).
endorses(Electorate, Case_Zeno).
endorses(TemporalReview, Case_Zeno).

? prisoner(Zeno).
# => TRUE

show(Zeno, Disclosure_Zeno_Boss, Boss).

? prisoner(Zeno).
# => FALSE

? defend(Zeno).
# => TRUE

# ...and the man he reached back to was recalled long since. The shield does
# not ask.
? broken(Boss).
# => TRUE

# ── A disclosure made after the charge (revision item 37) ─────────────────
# "A prosecution can answer only for what came before it. When both of the
#  case's temporal witnesses record that a disclosure was made after the
#  charge, it cannot have prompted that prosecution: it no longer blocks
#  confinement in that case, and its protection in any later case stands."
# One witness's entry is not enough; without both the disclosure bears on the case.
observe(Chronicle, Disclosure_Zeno_Boss, Case_Zeno, DisclosureFollowsTheChargeScope).

? prisoner(Zeno).
# => FALSE

observe(TemporalReview, Disclosure_Zeno_Boss, Case_Zeno, DisclosureFollowsTheChargeScope).

? prisoner(Zeno).
# => TRUE

? defend(Zeno, Case_Zeno).
# => FALSE

# The one-place shield is unchanged, and the same disclosure still bears on a
# case in which Zeno is cited without that record.
? defend(Zeno).
# => TRUE

cite(Court, Case_Zeno_Later, Zeno).

? defend(Zeno, Case_Zeno_Later).
# => TRUE

# A second disclosure the witnesses have not dated bears on the case again. The
# unrelated-case review in tests/pins/shield-independence remains the route for
# a disclosure that preceded the charge; without qualified reviewers, protection
# holds, as Sly's section shows above.
show(Zeno, Disclosure_Zeno_Review, Review).

? prisoner(Zeno).
# => FALSE

# "A defendant cannot buy delay by accusing the court that tries them." Either
# witness alone leaves the protection in place; this time the review body
# writes first.
observe(TemporalReview, Disclosure_Sly_Court, Case_Sly, DisclosureFollowsTheChargeScope).

? prisoner(Sly).
# => FALSE

observe(Chronicle, Disclosure_Sly_Court, Case_Sly, DisclosureFollowsTheChargeScope).

? prisoner(Sly).
# => TRUE

? defend(Sly).
# => TRUE
