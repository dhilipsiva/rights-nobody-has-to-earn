# ── Chapter 13 fidelity pins: "A Place in Which Life Remains Possible" ──────
#
# KIND: CONTENT pin. Run:
#   ./verify.sh --only book-1/13-a-place-in-which-life-remains-possible.pins.nibli
#   ./verify.sh          # the real check — the line above cannot see
#                        # the cross-file reconciliation or the prose guards
#
# The chapter's case lists tests/pins/records/child_with_nobody/fixture.nibli.
#
# The ecological and animal family's own cases carry the environmental claim,
# the axes, the Guardian and Animal Advocate routes, the authorisations, the
# withdrawals and the particular orders — tests/pins/ecology/ — and the
# promoted sections keep the citations they carried in the floor and vote
# chapters. The liberty-environment pins carry the Class Nine barriers:
#   book-1/source/liberty-environment.pins.nibli     FS-CCE-09, 10, 21..33
#
# WHAT FALSE MEANS HERE: a FALSE is pinned only where the KB could have said
# TRUE, and the comment says what would flip it.

:expect-pins 26

# "the floor's own inventory refuses a ninth item, and the floor refuses to
# erase the ecological ceiling"
? prevents(MaterialFloorInventory, EnvironmentalNinthFloor).
# => TRUE

? prevents(MaterialFloor, EcologicalCeilingErasure).
# => TRUE

? prevents(Adam, EcologySelectedFloorLoss).
# => TRUE

# "separate axes that do not trade against one another" — axis by axis.
? prevents(ClimateAtmosphere, CeilingErasure).
# => TRUE

? prevents(CleanAir, CeilingErasure).
# => TRUE

? prevents(WatersAndWetlands, CeilingErasure).
# => TRUE

? prevents(LivingSoil, CeilingErasure).
# => TRUE

? prevents(BiodiversityAndHabitats, CeilingErasure).
# => TRUE

# "the barrier against exhausting that inheritance holds"
? prevents(FutureEcologicalCapability, CommonsExhaustion).
# => TRUE

# "Two walls keep that arrangement honest"
? prevents(EcologicalCeiling, ScienceLawFunctionFusion).
# => TRUE

? prevents(EcologicalCeiling, UncertaintyTreatedAsSafety).
# => TRUE

# "An offset cannot excuse a breach"
? prevents(EcologicalBreach, OffsetExcuse).
# => TRUE

# "an insolvent or unknown responsible party does not delay it"
? prevents(RestorationDuty, InsolvencyDelay).
# => TRUE

# The person-held environmental barriers, for a cast member by name.
? prevents(Adam, EnvironmentalConditionsDenial).
# => TRUE

? prevents(Adam, EnvironmentalInformationWithholding).
# => TRUE

? prevents(Adam, UnassessedHighConsequenceDecision).
# => TRUE

? prevents(Adam, UnreasonedEnvironmentalDecision).
# => TRUE

? prevents(Adam, EnvironmentalPublicPrivateEvasion).
# => TRUE

? prevents(Adam, EnvironmentalWorthRanking).
# => TRUE

? prevents(Adam, EcologicalReviewDenial).
# => TRUE

# "For the child with nobody, this chapter holds the conditions of the place
# the child was born into as a right of the child's own"
? prevents(Nell, EnvironmentalConditionsDenial).
# => TRUE

? prevents(Nell, EnvironmentalInformationWithholding).
# => TRUE

? prevents(Nell, EnvironmentalWorthRanking).
# => TRUE

? prevents(Nell, EcologicalReviewDenial).
# => TRUE

? prevents(Nell, EcologySelectedFloorLoss).
# => TRUE

? owe(State, Healthy, Nell).
# => TRUE
