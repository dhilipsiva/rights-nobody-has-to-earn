observe(CustodyMeritsReview, Severity_Zed_InjuryToPerson_Ivo, AdjudicatedHarmAndMentalElementWithNoticeCounselChallengeAndReasons, SeverityProcedureScope).
list(Placement_Case_Zed, Zed, Case_Zed, CustodyPlacement).
